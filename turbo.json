{
  "$schema": "https://turborepo.dev/schema.json",
  // The task graph (docs/design/build/turborepo.md): the shared task shapes
  // here, each package's own tasks in its turbo.json ("extends": ["//"]).
  // Tasks run the package.json scripts, except in the Go modules, which have
  // none: their turbo.json gives each task a `command`. CI (the root `ci`
  // script) and the hosted cloud's builds (vercel.json, apps/cloud) run it.
  //
  // Without this, turbo writes its own block into the root AGENTS.md whenever
  // it detects an AI agent running it.
  "agentGuidance": false,
  // Vercel's remote cache for anyone logged in (`vercel login` or `turbo
  // login`), in every checkout, without `turbo link`. CI's TURBO_TEAM wins.
  "remoteCache": { "teamSlug": "zitadel" },
  // `--affected` and `turbo query affected` match changed files against each
  // task's `inputs` and follow task edges, the artifact edges included (the
  // server embeds the console): the same answer as the cache key gives
  // (docs/design/build/turborepo-graph.md). `turbo watch` reruns by the same
  // inputs; matched by package instead, it ignored every Go edit, because no
  // package held the server's Go code.
  //
  // The two experimental flags make the modules in go.work packages (named
  // after the module path's last element, a major-version suffix keeping the
  // element before it: `nextgen`, `zitadel/v5`, `bench`, `oidc-mock`,
  // `defaults`, `design-tokens`) and let a task run a `command` instead of a
  // script. Each module's `go-sources` depends on its module dependencies'
  // (`^go-sources`), so a task that reads one module
  // sees the sources of every module it compiles. Turbo gives each module
  // built-in `build`, `test`, `lint` (go vet), `format` (go fmt, which
  // rewrites) and `dev` tasks; the modules' turbo.json replace or drop them.
  "futureFlags": {
    "affectedUsingTaskInputs": true,
    "experimentalGoWorkspaces": true,
    "experimentalTaskCommand": true,
    "watchUsingTaskInputs": true
  },
  // Tasks see only the variables listed on them, turbo's built-in list (PATH,
  // HOME, SHELL, CI, TERM, GITHUB_ACTIONS, ...) and what framework inference
  // adds (VITE_* for Vite packages, NEXT_* for Next.js, ...).
  "envMode": "strict",
  // Vite inference would hash the VITE_VERCEL_* variables Vercel sets in a
  // build. Turbo leaves them out in the Vite service's build, where Vercel
  // names the prefix (TURBO_CI_VENDOR_ENV_KEY), but not in the server's, so
  // the same packages got other keys there than in the console's build and
  // were built twice per deployment. No build here reads
  // them. A negation here also applies to framework inference.
  //
  // On Vercel, turbo's default hashes VERCEL_TARGET_ENV (production or
  // preview) into every task, so a preview never restored what main's
  // production build had stored and each branch's first preview built every
  // shared package again. It is dropped: Vercel's cache policies, not the
  // key, keep a branch's artifacts away from production
  // (docs/design/build/turborepo.md, "Commands"). A build whose output depends
  // on the environment lists it itself (the console's VERCEL_ENV). VERCEL is
  // hashed in its place, so the keys of Vercel's builds stay apart from
  // CI's and a checkout's, as that default kept them.
  "globalEnv": ["!VITE_VERCEL_*", "!VERCEL_TARGET_ENV", "VERCEL"],
  "globalPassThroughEnv": [
    // Where Go keeps its toolchain, module and build caches; their contents
    // are keyed by Go itself. GOCACHEPROG is the cache program Depot's CI
    // runners set (`depot gocache`), which authenticates with the job's
    // DEPOT_CACHE_TOKEN. They stay out of task keys: turbo keys every Go
    // module's tasks on `go version` and the effective `go env` (GOOS, GOARCH,
    // CGO_ENABLED, GOFLAGS, ...). The Go tasks list GOFLAGS and explicit
    // target variables as `env` so strict mode passes them.
    "GOPATH",
    "GOCACHE",
    "GOCACHEPROG",
    "DEPOT_CACHE_TOKEN",
    "GOMODCACHE",
    "GOTMPDIR",
    "GOTOOLCHAIN",
    "GOPROXY",
    "GOSUMDB",
    "GONOSUMDB",
    "GONOSUMCHECK",
    "GOPRIVATE",
    "GONOPROXY",
    "GOINSECURE",
    // Telemetry opt-outs honoured by the CLI, Playwright, Next.js, Nuxt and
    // Storybook (CI sets DO_NOT_TRACK).
    "DO_NOT_TRACK",
    "ZITADEL_TELEMETRY",
    "NEXT_TELEMETRY_DISABLED",
    "NUXT_TELEMETRY_DISABLED",
    "STORYBOOK_DISABLE_TELEMETRY",
    // Playwright's browser store and the temp dir the test harnesses use.
    "PLAYWRIGHT_BROWSERS_PATH",
    "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD",
    "TMPDIR",
    "LC_ALL",
    // Vercel keeps corepack enabled for a turbo build only when this is
    // listed here (it checks the file); the cloud's builds run its `pnpm`.
    "COREPACK_HOME"
  ],
  // The files that fix the toolchain and the installed dependencies, and
  // CI's own definition (the root `ci` script in package.json, its workflow):
  // a change to any of them re-runs every task. Turbo hashes each package's slice of
  // pnpm-lock.yaml on its own, so the lockfile is not listed. Shared test
  // configuration belongs to test and typecheck inputs, not every build.
  "globalDependencies": [
    ".nvmrc",
    ".npmrc",
    ".github/workflows/ci.yml",
    "package.json",
    "pnpm-workspace.yaml",
    "devbox.json",
    "devbox.lock",
    "tsconfig.base.json",
    "biome.json"
  ],
  "tasks": {
    // ---- The standard tasks of every TypeScript package. Dependencies are
    // per package; `^build` is deliberately
    // not used: it follows devDependencies too, and the console's
    // @zitadel/testing (dev-real only) would pull the CLI and the server
    // build into every console build (pilot finding 2).
    //
    // Inputs by file class (docs/design/build/turborepo-graph.md): no task
    // below reads a package's docs, and no build reads its tests. A negation
    // wins over any inclusion, so a task that reads one of these files
    // replaces `inputs` instead of extending them (cli#test). Every package
    // lint is `biome check .`, which processes no Markdown.
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/biome-plugins/*.grit", "!**/*.md", "!**/*.mdx", "!**/LICENSE"]
    },
    "typecheck": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/vitest-config/vitest.shared.mjs",
        "$TURBO_ROOT$/packages/vitest-config/vitest.shared.d.mts",
        "!**/README.md",
        "!**/AGENTS.md",
        "!**/CLAUDE.md",
        "!**/CHANGELOG.md",
        "!**/LICENSE",
        "!**/LICENSE.md",
        "!docs/**",
        "!skills/**/*.md"
      ]
    },
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/README.md",
        "!**/AGENTS.md",
        "!**/CLAUDE.md",
        "!**/CHANGELOG.md",
        "!**/LICENSE",
        "!**/LICENSE.md",
        "!docs/**",
        "!skills/**/*.md",
        "!**/*.test.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
        "!**/*.spec.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
        "!**/__tests__/**",
        "!**/__snapshots__/**",
        "!tests/**",
        "!test/**",
        "!**/vitest.config.*",
        "!**/vitest.*.config.*"
      ],
      "outputs": ["dist/**"]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/vitest-config/vitest.shared.mjs",
        "$TURBO_ROOT$/packages/vitest-config/vitest.shared.d.mts",
        "!**/README.md",
        "!**/AGENTS.md",
        "!**/CLAUDE.md",
        "!**/CHANGELOG.md",
        "!**/LICENSE",
        "!**/LICENSE.md",
        "!docs/**",
        "!skills/**/*.md"
      ]
    },

    // ---- Task shapes several packages share.
    // Chromium for the browser-mode Vitest projects; the `test` task of those
    // packages depends on it so the test gate provisions it in CI. Never
    // cached, so its inputs only decide when it counts as affected: the
    // Playwright version, which the manifest and the lockfile pin. With the
    // whole package as input, a README edit made every browser test affected.
    "install-browsers": {
      "cache": false,
      "inputs": ["package.json"]
    },
    // Generation feeds the builds, so it leaves out what they leave out:
    // without that, a spec edit re-ran api#generate and every build after it.
    "generate": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/README.md",
        "!**/AGENTS.md",
        "!**/CLAUDE.md",
        "!**/CHANGELOG.md",
        "!**/LICENSE",
        "!**/LICENSE.md",
        "!docs/**",
        "!skills/**/*.md",
        "!**/*.test.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
        "!**/*.spec.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
        "!**/__tests__/**",
        "!**/__snapshots__/**",
        "!tests/**",
        "!test/**",
        "!**/vitest.config.*",
        "!**/vitest.*.config.*"
      ],
      "outputs": ["src/generated/**"]
    },
    // A Go module's production sources, which no command reads directly:
    // the Go tasks depend on it. `^go-sources` follows the module's requires,
    // so the task covers every module it compiles. Tests and testdata are
    // left out, so a test-only change does not select a production build,
    // and so are the docs the builds leave out. @zitadel/server and the
    // design tokens list their own inputs. go.work picks the versions every
    // module builds with; turbo adds it only to its built-in Go tasks.
    "go-sources": {
      "dependsOn": ["^go-sources"],
      "env": ["GOFLAGS", "CGO_ENABLED", "GOOS", "GOARCH"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/go.work",
        "$TURBO_ROOT$/go.work.sum",
        // Native Go inputs must not hash the toolchain/cache Vercel puts
        // inside the service root, even on a checkout without Git metadata.
        "!**/.vercel/**",
        "!**/*_test.go",
        "!**/testdata/**",
        "!**/README.md",
        "!**/AGENTS.md",
        "!**/CLAUDE.md"
      ]
    },
    // Deletes what the package's builds, generation and tests wrote: `turbo
    // run clean`, or one package with `--filter`. `git clean -X` removes only
    // files git ignores, so a committed file survives, and the paths name
    // output only, never a .env or node_modules. Run it on its own: beside
    // another task it deletes what that task writes. A package whose output
    // lies elsewhere names its own paths (console, e2e, server, release), and
    // the repository root, a package of turbo's Go workspace, cleans only its
    // own tests' output: dist/ there holds the local servers' data.
    "clean": {
      "cache": false,
      "command": [
        "git",
        "clean",
        "-fdX",
        "--",
        "dist",
        "bin",
        "src/generated",
        ".generated",
        "meta-schemas",
        ".next",
        "next-env.d.ts",
        "app/.well-known",
        ".nuxt",
        ".nuxt-typecheck",
        ".output",
        ".swc",
        ".vitest",
        "test-output",
        "test-results",
        "playwright-report"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "cache": false,
      "persistent": true
    },
    // ---- The root package: the scripts/*.mjs orchestration. The root
    // package's default inputs are the whole repository, so every root task
    // lists its inputs: the cached ones the files they read, the uncached
    // ones so that only a change to their own scripts marks them affected
    // (`--affected`).
    //
    // The root lint checks the whole repository, so its inputs are every file
    // Biome checks.
    // An explicit glob also matches ignored files, so it names the ignored
    // trees it would otherwise hash: node_modules alone held 101,000 matches,
    // and in the main checkout .claude/ holds every worktree.
    // Stands for the repository checks too, so `turbo run lint` runs them.
    "//#lint": {
      "dependsOn": ["//#check-adrs", "//#check-go-work", "//#check-typecheck"],
      "inputs": [
        "**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}",
        "biome.json",
        "biome-plugins/*.grit",
        "!**/node_modules/**",
        "!**/generated/**",
        "!**/dist/**",
        "!**/out-tsc/**",
        "!**/coverage/**",
        "!**/.next/**",
        "!**/.nuxt/**",
        "!**/.nuxt-typecheck/**",
        "!**/.output/**",
        "!**/.svelte-kit/**",
        "!**/.turbo/**",
        "!**/.vercel/**",
        "!**/test-results/**",
        "!**/playwright-report/**",
        "!**/.vitest/**",
        "!**/next-env.d.ts",
        "!**/*.timestamp*",
        "!apps/docs/.source/**",
        "!apps/docs/.generated/**",
        "!apps/cloud-functions/app/.well-known/workflow/**",
        "!.claude/**",
        "!.codex/**",
        "!.cursor/**",
        "!.agents/**",
        "!.opencode/**",
        "!tmp/**",
        "!.tmp/**"
      ]
    },
    "//#test": {
      "dependsOn": ["//#check-openapi-rules"],
      "inputs": [
        "packages/vitest-config/vitest.shared.mjs",
        "packages/vitest-config/vitest.shared.d.mts",
        "scripts/cloud-setup.test.mjs",
        "scripts/deployment-suite.test.mjs",
        "apps/cloud/setup-secrets.sh",
        "apps/cloud/admin-document.mjs",
        "packages/config/bootstrap-user.mjs",
        ".github/workflows/deployment-suite.yml",
        "scripts/go-generate.mjs",
        "scripts/go-generate.test.mjs",
        "scripts/generated-outputs.mjs",
        "scripts/map-all.mjs",
        "scripts/task-graph.test.mjs",
        "scripts/cloud-build.test.mjs",
        "vercel.json",
        "apps/cloud/build-launcher.sh",
        "apps/cloud/deploy.sh",
        "apps/api/internal/build/info.go",
        "go.work",
        "go.work.sum",
        "apps/*/go.{mod,sum}",
        "packages/*/go.{mod,sum}",
        "packages/config/defaults/go.{mod,sum}",
        "tools/*/go.{mod,sum}",
        "turbo.json",
        "apps/*/turbo.json",
        "apps/*/package.json",
        "packages/*/turbo.json",
        "packages/*/package.json",
        "tools/*/turbo.json",
        "tools/*/package.json",
        "e2e/turbo.json",
        "e2e/package.json",
        "conformance/*/turbo.json",
        "conformance/*/package.json",
        "conformance/fixtures/*/turbo.json",
        "conformance/fixtures/*/package.json",
        ".gitignore",
        "scripts/dev-process.mjs",
        "scripts/dev-process.test.mjs",
        "scripts/shims/pnpm",
        "scripts/generate-meta-schemas.ts",
        "scripts/generate-meta-schemas.test.ts",
        "scripts/release-artifacts.mjs",
        "scripts/release-github.mjs",
        "scripts/release-github.test.mjs",
        "scripts/release-manifest.mjs",
        "scripts/server-build.mjs",
        "scripts/render-builtin-schemas.mjs",
        "scripts/render-builtin-schemas.test.mjs",
        "scripts/turbo-run-summary.mjs",
        "scripts/turbo-run-summary.test.mjs",
        "apps/api/api/openapi/endpoints/schemas/*.json",
        // The built-in schemas' renderer matches the server's default
        // namespace.
        "packages/config/src/builtin-schema-base.ts",
        "scripts/assert-file.mjs",
        "vitest.config.ts"
      ]
    },
    "//#check-typecheck": {
      "inputs": [
        "packages/vitest-config/vitest.shared.mjs",
        "packages/vitest-config/vitest.shared.d.mts",
        "scripts/check-typecheck-programs.mjs",
        "scripts/check-typecheck-programs.test.mjs",
        "scripts/assert-file.mjs",
        "apps/*/package.json",
        "packages/*/package.json",
        "apps/*/tsconfig*.json",
        "packages/*/tsconfig*.json",
        "e2e/package.json",
        "e2e/tsconfig*.json",
        "vitest.config.ts"
      ]
    },
    "//#check-openapi-rules": {
      "inputs": [
        "packages/vitest-config/vitest.shared.mjs",
        "packages/vitest-config/vitest.shared.d.mts",
        "scripts/openapi-casing-rules.test.mjs",
        "scripts/openapi-list-conventions.test.mjs",
        "scripts/assert-file.mjs",
        "scripts/testdata/openapi-casing/**",
        "scripts/testdata/openapi-lists/**",
        // The verb allow-list test reads the spec's operationIds.
        "apps/api/api/openapi/endpoints/**/methods.yaml",
        // The list conventions are checked on the committed bundle;
        // @zitadel/server#check-generate keeps it in step with the YAML.
        "apps/api/api/openapi/bundled/openapi.json",
        "redocly.yaml",
        ".redocly.lint-ignore.yaml",
        "vitest.config.ts"
      ]
    },
    "//#check-adrs": {
      "inputs": ["docs/adrs/**/*.md", "scripts/check-adrs-index.mjs", "scripts/dev-process.mjs"]
    },
    // Every module in go.work compiles with what its own go.mod selects, and
    // the staged go.work.sum holds every checksum turbo's module-graph listing
    // needs (scripts/check-go-work.mjs). Not cached: the answer depends on
    // every module's imports, tests included, which these inputs do not hold.
    "//#check-go-work": {
      "cache": false,
      "env": ["GOFLAGS"],
      "inputs": [
        "scripts/check-go-work.mjs",
        "scripts/check-go-work.test.mjs",
        "scripts/assert-file.mjs",
        "scripts/dev-process.mjs",
        "go.work",
        "go.work.sum",
        "apps/*/go.{mod,sum}",
        "packages/*/go.{mod,sum}",
        "packages/config/defaults/go.{mod,sum}",
        "tools/*/go.{mod,sum}"
      ]
    },
    // Two Go modules cannot have a turbo.json of their own: the design
    // tokens' shares its directory with @zitadel/design-tokens, and the config
    // defaults' directory ships to npm (and every *.json in it is a default
    // the server's tests load). They keep turbo's built-in build, test and
    // lint (go build, go test, go vet), and their `format` (go fmt, which
    // rewrites, so turbo leaves it uncached) is replaced here, by name, with
    // the other modules' check, which only reads.
    "design-tokens#format": {
      "cache": true,
      "command": ["node", "../../scripts/go-format-check.mjs"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/go-format-check.mjs", "$TURBO_ROOT$/scripts/dev-process.mjs"]
    },
    // @zitadel/design-tokens cleans the directory both packages share.
    "design-tokens#clean": { "command": ["node", "-e", "0"] },
    // go.work's package, the repository root: its own tests' output only
    // (the `clean` shape above says why).
    "go-workspace#clean": { "command": ["git", "clean", "-fdX", "--", ".vitest", "test-output"] },
    "defaults#format": {
      "cache": true,
      "command": ["node", "../../../scripts/go-format-check.mjs"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/go-format-check.mjs", "$TURBO_ROOT$/scripts/dev-process.mjs"]
    },
    "defaults#lint": { "dependsOn": ["format"] },
    "//#doctor": {
      "cache": false,
      "inputs": ["scripts/doctor.mjs", "scripts/server-build.mjs", "scripts/dev-process.mjs"]
    },
    // The root `cli` script is not a turbo task: it is interactive, which turbo
    // only supports inside its terminal UI. Run `pnpm run cli -- ...` directly.
    // Under `turbo watch server` a Go or console edit restarts the server
    // (`interruptible`): its edges reach both.
    "//#server": {
      "cache": false,
      "persistent": true,
      "interruptible": true,
      "dependsOn": ["@zitadel/console#build", "@zitadel/server#go-sources"],
      "inputs": ["scripts/run-server.mjs", "scripts/dev-process.mjs"],
      "passThroughEnv": ["ZITADEL_*", "NEXTGEN_*", "GOFLAGS"]
    },
    "//#server-debug": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["@zitadel/console#build"],
      "inputs": [
        "scripts/run-server-debug.mjs",
        "scripts/server-build.mjs",
        "scripts/dev-process.mjs"
      ],
      "passThroughEnv": ["ZITADEL_*", "NEXTGEN_*", "GOFLAGS"]
    },
    // The local runtime image: the server cross-compiled for linux with the
    // console's dist embedded. Needs Docker, so it stays out of the `ci`
    // script; the nightly artifacts workflow runs it through smoke-container.
    "//#build-local-image": {
      "cache": false,
      "dependsOn": ["@zitadel/console#build"],
      "inputs": [
        "scripts/build-local-runtime-image.mjs",
        "scripts/release-artifacts.mjs",
        "scripts/release-manifest.mjs",
        "scripts/server-build.mjs",
        "scripts/dev-process.mjs",
        "Dockerfile"
      ],
      "passThroughEnv": ["ZITADEL_*", "DOCKER_*", "GOFLAGS"]
    },
    "//#smoke-container": {
      "cache": false,
      "dependsOn": ["//#build-local-image"],
      "inputs": ["scripts/smoke-container.mjs", "scripts/dev-process.mjs", "scripts/release-manifest.mjs"],
      "passThroughEnv": ["ZITADEL_*", "DOCKER_*"]
    },
    // The latest published @zitadel/server writes a data dir (a project and
    // a user); the current build migrates it and reads the user back. It
    // installs that release from npm, so it is never cached. The root `ci`
    // script and the nightly artifacts workflow run it.
    "//#smoke-upgrade": {
      "cache": false,
      "dependsOn": ["@zitadel/server#build"],
      "inputs": ["scripts/smoke-upgrade.mjs", "scripts/smoke-server.mjs", "scripts/release-manifest.mjs", "scripts/dev-process.mjs"]
    }
  }
}
