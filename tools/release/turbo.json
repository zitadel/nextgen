{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  // The release graph. pack, snapshot and publish pack what the graph built
  // before them (`release.mjs --prebuilt`): every public package's build and
  // each server platform package's binary (`build-binary`, in
  // apps/server-<platform>/turbo.json). A release builds each package once,
  // as any other run does, so nothing rewrites a dist that another task
  // reads and the entry points wait for no test. A run that must not
  // restore anything takes `--force`. Moon keeps its own release graph
  // (tools/release/moon.yml) until the cutover.
  "tasks": {
    "changesets": {
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/*.mjs", "$TURBO_ROOT$/.changeset/**"]
    },
    // What the public packages ship: the npm packages' builds and the five
    // server binaries. scripts/task-graph.test.mjs checks that it covers
    // every package in PUBLIC_RELEASE_PACKAGES (scripts/release-manifest.mjs).
    "build-public-packages": {
      "dependsOn": [
        "@zitadel/cli#build",
        "@zitadel/api#build",
        "@zitadel/config#build",
        "@zitadel/components#build",
        "@zitadel/sdk-core#build",
        "@zitadel/sdk-next#build",
        "@zitadel/sdk-nuxt#build",
        "@zitadel/sdk-react#build",
        "@zitadel/sdk-vue#build",
        "@zitadel/sdk-angular#build",
        "@zitadel/sdk-solid#build",
        "@zitadel/sdk-svelte#build",
        "@zitadel/sdk-qwik#build",
        "@zitadel/sdk-sveltekit#build",
        "@zitadel/sdk-solid-start#build",
        "@zitadel/sdk-qwik-router#build",
        "@zitadel/sdk-tanstack-start#build",
        "@zitadel/testing#build",
        "@zitadel/server-linux-x64#build-binary",
        "@zitadel/server-linux-arm64#build-binary",
        "@zitadel/server-darwin-x64#build-binary",
        "@zitadel/server-darwin-arm64#build-binary",
        "@zitadel/server-win32-x64#build-binary"
      ]
    },
    "version": {
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/*.mjs", "$TURBO_ROOT$/.changeset/**"],
      "passThroughEnv": ["GITHUB_*", "NPM_*", "BASE_SHA"]
    },
    "pack": {
      "cache": false,
      "dependsOn": ["build-public-packages"],
      "passThroughEnv": ["GITHUB_*", "NPM_*", "BASE_SHA", "ZITADEL_*"]
    },
    "snapshot": {
      "cache": false,
      "dependsOn": ["build-public-packages"],
      "passThroughEnv": ["GITHUB_*", "NPM_*", "BASE_SHA", "ZITADEL_*", "DOCKER_*", "GOFLAGS", "RELEASE_SKIP_CONTAINER", "RELEASE_HOST_ONLY"]
    },
    "publish": {
      "cache": false,
      "dependsOn": ["build-public-packages"],
      "passThroughEnv": ["GITHUB_*", "NPM_*", "NODE_AUTH_TOKEN", "PNPM_CONFIG_*", "BASE_SHA", "RECOVER_VERSION", "RELEASE_DRY_RUN", "ZITADEL_*", "DOCKER_*", "GOFLAGS", "ACTIONS_*"]
    }
  }
}
