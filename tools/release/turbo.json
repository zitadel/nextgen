{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  // The release graph: build-public-packages runs every public package's
  // release build, in parallel on the package edges of their dev builds, and
  // the console's release build waits for all of them. Each cleans and
  // rebuilds its package's dist. pack, snapshot and publish run them in the
  // release workspace, a copy of the checkout's sources
  // (scripts/release-workspace.mjs), so they depend on nothing here: no dev
  // build, test or lane of the checkout reads what the copy rewrites.
  "tasks": {
    "changesets": {
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/*.mjs", "$TURBO_ROOT$/.changeset/**"]
    },
    "check-graph": {
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/*.mjs", "$TURBO_ROOT$/.changeset/**"]
    },
    "build-public-packages": {
      "cache": false,
      "dependsOn": [
        "check-graph",
        "@zitadel/cli#build-release",
        "@zitadel/api#build-release",
        "@zitadel/config#build-release",
        "@zitadel/components#build-release",
        "@zitadel/sdk-core#build-release",
        "@zitadel/sdk-next#build-release",
        "@zitadel/sdk-nuxt#build-release",
        "@zitadel/sdk-react#build-release",
        "@zitadel/sdk-vue#build-release",
        "@zitadel/sdk-angular#build-release",
        "@zitadel/sdk-solid#build-release",
        "@zitadel/sdk-svelte#build-release",
        "@zitadel/sdk-qwik#build-release",
        "@zitadel/sdk-sveltekit#build-release",
        "@zitadel/sdk-solid-start#build-release",
        "@zitadel/sdk-qwik-router#build-release",
        "@zitadel/sdk-tanstack-start#build-release",
        "@zitadel/testing#build-release"
      ]
    },
    "version": {
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/*.mjs", "$TURBO_ROOT$/.changeset/**"],
      "passThroughEnv": ["GITHUB_*", "NPM_*", "BASE_SHA"]
    },
    // The entry points. Each starts turbo again in the release workspace for
    // build-public-packages and the console's release build, and that run
    // gets the whole environment (its cache token, TURBO_FORCE, the console's
    // CONSOLE_* settings): its own tasks still see only what they list.
    "pack": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "snapshot": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "publish": {
      "cache": false,
      "passThroughEnv": ["*"]
    }
  }
}
