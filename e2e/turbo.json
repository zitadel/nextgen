        "package.json",
        "console/support/copy.ts",
        "$TURBO_ROOT$/scripts/*.mjs",
        "$TURBO_ROOT$/apps/cli/skills/**",
        "$TURBO_ROOT$/tools/oidc-mock/users.json",
        "!**/README.md",
        "!**/AGENTS.md"
      ],
      "dependsOn": ["install-browsers", "@zitadel/cli#build", "@zitadel/testing#build", "oidc-mock#build", "@zitadel/server#build", "@zitadel/sdk-react#build"],
      "cache": false,
      "passThroughEnv": ["ZITADEL_*", "NEXTGEN_*", "JOURNEY_*", "REAL_*", "EMBEDDED_*", "PLATFORM_*", "PLAYWRIGHT_*", "PWDEBUG", "DEBUG", "RUNNER_TEMP", "GITHUB_*", "DOCKER_*", "TESTCONTAINERS_*", "RELEASE_HOST_ONLY"]
    }
  }
}
