{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // One package holds every end-to-end lane, so each lane has its own task
    // name (the four packages it replaces each had an `e2e` / `e2e-real`,
    // which no longer fit side by side). The lanes boot real servers and
    // browsers. The console and demo lanes test only the repo's own builds,
    // so they are cached by what they hash: a push that leaves those alone
    // restores their pass. The deployment lanes and the journeys reach
    // outside the repo (a deployment, scaffolders' latest releases) and are
    // not. Each passes through the switches the Playwright configs and the
    // journey runner read.
    //
    // `test` is the journey harness's unit tests. There is no `all` lane: a
    // `turbo run` names the lanes it runs. Each lane hashes, through its base
    // task below, its own folder plus the shared files (and, for the demo
    // lanes, the demo app they serve), less the docs and the ignored trees,
    // so a console spec edit does not select the journey and a demo app edit
    // selects the demo's lanes. The two demo-next lanes share a task-guard
    // mutex in package.json (both serve the demo on :3002).
    // The packed-CLI helpers and the journey's registry scripts import the
    // root release scripts; the harness's unit tests (`test`) also read the
    // CLI's skill and the router skill, the mock OIDC provider's users, the
    // built-in schemas and the manifests of the packages a journey installs
    // (frameworks.test.mjs derives each journey's edges from them).
    "typecheck": {
      "dependsOn": ["@zitadel/testing#build"],
      "inputs": ["$TURBO_EXTENDS$", "$TURBO_ROOT$/scripts/*.mjs", "$TURBO_ROOT$/scripts/*.d.mts"]
    },
    "test": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/scripts/*.mjs",
        "$TURBO_ROOT$/apps/cli/skills/**",
        "$TURBO_ROOT$/skills/zitadel/**",
        "$TURBO_ROOT$/tools/oidc-mock/users.json",
        "$TURBO_ROOT$/apps/api/api/openapi/endpoints/schemas/*.json",
        "$TURBO_ROOT$/{apps,packages}/*/package.json"
      ]
    },
    // Each lane writes its reports into its own folder.
    "clean": {
      "command": [
        "git",
        "clean",
        "-fdX",
        "--",
        "cli/test-results",
        "console/test-output",
        "console/test-results",
        "console/playwright-report",
        "demo-next/test-results",
        "demo-next/playwright-report",
        "demo-nuxt/test-results",
        "demo-nuxt/playwright-report",
        "journey/test-output",
        "journey/.vitest",
        "schemas/test-results"
      ]
    },
    // ---- Bases: input-only tasks (no script) the lanes depend on, as the
    // server's go-sources. A base hashes the files its lanes share and orders
    // the builds they need; its hash reaches each lane through the edge, and
    // so does `--affected`. A lane's own input is its script in package.json:
    // `"inputs": []` would mean turbo's default, the whole package.
    //
    // A real ephemeral instance through the kit: the server build, which
    // embeds the working tree's UI dists, the kit and the CLI.
    "real-instance": {
      "inputs": ["package.json"],
      "dependsOn": ["@zitadel/testing#build", "@zitadel/cli#build", "@zitadel/server#build"]
    },
    // A lane's folder through an explicit glob, which also matches ignored
    // files: the excludes name what a run writes there (reports, traces, the
    // kit's handshake), so a lane's key never holds its own output.
    "console-base": {
      "inputs": [
        "console/**",
        "package.json",
        "playwright.shared.ts",
        "!**/test-results/**",
        "!**/playwright-report/**",
        "!**/test-output/**",
        "!**/.zitadel-testing/**",
        "!**/README.md",
        "!**/AGENTS.md"
      ],
      "dependsOn": ["install-browsers"]
    },
    // The demo app's folder through an explicit glob too: the excludes also
    // name what the demo's own tooling writes.
    "demo-next-base": {
      "inputs": [
        "demo-next/**",
        "package.json",
        "playwright.shared.ts",
        "$TURBO_ROOT$/apps/demo-next/**",
        "$TURBO_ROOT$/scripts/task-guard.mjs",
        "!**/test-results/**",
        "!**/playwright-report/**",
        "!**/test-output/**",
        "!**/.zitadel-testing/**",
        "!**/README.md",
        "!**/AGENTS.md",
        "!$TURBO_ROOT$/apps/demo-next/node_modules/**",
        "!$TURBO_ROOT$/apps/demo-next/.next/**",
        "!$TURBO_ROOT$/apps/demo-next/.turbo/**",
        "!$TURBO_ROOT$/apps/demo-next/test-output/**",
        "!$TURBO_ROOT$/apps/demo-next/next-env.d.ts",
        "!$TURBO_ROOT$/apps/demo-next/README.md",
        "!$TURBO_ROOT$/apps/demo-next/AGENTS.md"
      ],
      "dependsOn": ["install-browsers"]
    },
    // The journey harness drives the real CLI binary and the mock OIDC
    // provider binary, imports the kit's virtual-passkey helper, and its claim
    // suite the console copy in console/support/copy.ts.
    "journey-base": {
      "inputs": [
        "journey/**",
        "package.json",
        "console/support/copy.ts",
        "$TURBO_ROOT$/scripts/*.mjs",
        "$TURBO_ROOT$/apps/cli/skills/**",
        "$TURBO_ROOT$/tools/oidc-mock/users.json",
        "!$TURBO_ROOT$/scripts/*.test.mjs",
        "!**/README.md",
        "!**/AGENTS.md"
      ],
      "dependsOn": ["install-browsers", "@zitadel/cli#build", "@zitadel/testing#build", "oidc-mock#build"]
    },
    // ---- The cached lanes. A stored pass is only ever the hashed tree's:
    // the key holds the switches that change what a lane tests (`env`:
    // another server binary, a server setting, a lane's port), and as a turbo
    // task a lane never uses a server already on its port
    // (playwright.shared.ts).
    "console-smoke": {
      "inputs": ["package.json"],
      "dependsOn": ["console-base", "@zitadel/console#build"],
      "env": ["ZITADEL_*", "NEXTGEN_*", "REAL_*", "EMBEDDED_*", "PLATFORM_*", "!ZITADEL_TELEMETRY*"],
      "passThroughEnv": ["ZITADEL_TELEMETRY*", "JOURNEY_*", "PLAYWRIGHT_*", "PWDEBUG", "DEBUG", "RUNNER_TEMP", "GITHUB_*", "DOCKER_*", "TESTCONTAINERS_*"]
    },
    // The three real-instance console lanes. The ports (8093, 8095, 8097) and
    // the binary path are the Playwright configs' defaults; the scripts set
    // the NEXTGEN_* switches each lane asserts.
    "console-real": {
      "inputs": ["package.json"],
      "dependsOn": ["console-base", "real-instance"],
      "env": ["ZITADEL_*", "NEXTGEN_*", "REAL_*", "EMBEDDED_*", "PLATFORM_*", "!ZITADEL_TELEMETRY*"],
      "passThroughEnv": ["ZITADEL_TELEMETRY*", "JOURNEY_*", "PLAYWRIGHT_*", "PWDEBUG", "DEBUG", "RUNNER_TEMP", "GITHUB_*", "DOCKER_*", "TESTCONTAINERS_*"]
    },
    "console-embedded": {
      "inputs": ["package.json"],
      "dependsOn": ["console-base", "real-instance"],
      "env": ["ZITADEL_*", "NEXTGEN_*", "REAL_*", "EMBEDDED_*", "PLATFORM_*", "!ZITADEL_TELEMETRY*"],
      "passThroughEnv": ["ZITADEL_TELEMETRY*", "JOURNEY_*", "PLAYWRIGHT_*", "PWDEBUG", "DEBUG", "RUNNER_TEMP", "GITHUB_*", "DOCKER_*", "TESTCONTAINERS_*"]
    },
    "console-platform": {
      "inputs": ["package.json"],
      "dependsOn": ["console-base", "real-instance"],
      "env": ["ZITADEL_*", "NEXTGEN_*", "REAL_*", "EMBEDDED_*", "PLATFORM_*", "!ZITADEL_TELEMETRY*"],
      "passThroughEnv": ["ZITADEL_TELEMETRY*", "JOURNEY_*", "PLAYWRIGHT_*", "PWDEBUG", "DEBUG", "RUNNER_TEMP", "GITHUB_*", "DOCKER_*", "TESTCONTAINERS_*"]
    },
    // The hosted cloud's console on a deployment, which CLOUD_URL names
    // (VERCEL_AUTOMATION_BYPASS_SECRET opens its protection); the root's
    // `pnpm check:cloud` runs it beside every other deployment suite, and the
    // deployment-checks workflow runs it for every deployment. Nothing to build.
    // The Playwright config refuses to run without CLOUD_URL.
    "console-deployment": {
      "inputs": ["package.json"],
      "dependsOn": ["console-base"],
      "cache": false,
      "passThroughEnv": ["CLOUD_URL", "VERCEL_AUTOMATION_BYPASS_SECRET", "PLAYWRIGHT_*", "PWDEBUG", "DEBUG", "GITHUB_*"]
    },
    // The built-in schemas the `schemas` service publishes under /schemas/v1/
    // on the deployment CLOUD_URL names, beside the console's suite in
    // `pnpm check:cloud` and the deployment-checks workflow. The spec renders
    // the expected documents with the repo's own renderer, so its inputs
    // reach outside the package.
    "schemas-deployment": {
      "inputs": [
        "schemas/**",
        "package.json",
        "playwright.shared.ts",
        "$TURBO_ROOT$/scripts/render-builtin-schemas.mjs",
        "$TURBO_ROOT$/apps/api/api/openapi/endpoints/schemas/*.json",
        "!**/README.md",
        "!**/AGENTS.md"
      ],
      "cache": false,
      "dependsOn": ["install-browsers"],
      "passThroughEnv": ["CLOUD_URL", "VERCEL_AUTOMATION_BYPASS_SECRET", "PLAYWRIGHT_*", "PWDEBUG", "DEBUG", "GITHUB_*"]
    },
    // The packed CLI against the deployment CLOUD_URL names, beside the
    // console's and the schemas' suites in `pnpm check:cloud` and the
    // deployment-checks workflow (previews only: each run leaves a project in
    // the deployment's database). It packs the CLI with the release's own
    // code, so its inputs reach outside the package.
    "cli-deployment": {
      "inputs": [
        "cli/**",
        "package.json",
        "playwright.shared.ts",
        "$TURBO_ROOT$/scripts/release-artifacts.mjs",
        "$TURBO_ROOT$/scripts/release-manifest.mjs",
        "$TURBO_ROOT$/scripts/server-build.mjs",
        "!**/README.md",
        "!**/AGENTS.md"
      ],
      "dependsOn": ["install-browsers", "@zitadel/cli#build", "@zitadel/testing#build"],
      "cache": false,
      "passThroughEnv": ["CLOUD_URL", "VERCEL_AUTOMATION_BYPASS_SECRET", "PLAYWRIGHT_*", "PWDEBUG", "DEBUG", "GITHUB_*", "NODE_EXTRA_CA_CERTS"]
    },
    // Mock lanes run api-mock's `start` and the demo's `dev`, so they need what
    // those need rather than a production build of the demo.
    "demo-next-mock": {
      "inputs": ["package.json"],
      "dependsOn": ["demo-next-base", "@zitadel/api-mock#build", "@zitadel/sdk-next#build"],
      "env": ["ZITADEL_*", "NEXTGEN_*", "REAL_*", "EMBEDDED_*", "PLATFORM_*", "!ZITADEL_TELEMETRY*"],
      "passThroughEnv": ["ZITADEL_TELEMETRY*", "JOURNEY_*", "PLAYWRIGHT_*", "PWDEBUG", "DEBUG", "RUNNER_TEMP", "GITHUB_*", "DOCKER_*", "TESTCONTAINERS_*"]
    },
    // The same journey against a real ephemeral instance seeded via
    // @zitadel/testing. The script keeps the server-hosted UIs and the platform
    // project off.
    "demo-next-real": {
      "inputs": ["package.json"],
      "dependsOn": ["demo-next-base", "real-instance"],
      "env": ["ZITADEL_*", "NEXTGEN_*", "REAL_*", "EMBEDDED_*", "PLATFORM_*", "!ZITADEL_TELEMETRY*"],
      "passThroughEnv": ["ZITADEL_TELEMETRY*", "JOURNEY_*", "PLAYWRIGHT_*", "PWDEBUG", "DEBUG", "RUNNER_TEMP", "GITHUB_*", "DOCKER_*", "TESTCONTAINERS_*"]
    },
    "demo-nuxt-mock": {
      "inputs": [
        "demo-nuxt/**",
        "package.json",
        "playwright.shared.ts",
        "$TURBO_ROOT$/apps/demo-nuxt/**",
        "!**/test-results/**",
        "!**/playwright-report/**",
        "!**/test-output/**",
        "!**/.zitadel-testing/**",
        "!**/README.md",
        "!**/AGENTS.md",
        "!$TURBO_ROOT$/apps/demo-nuxt/node_modules/**",
        "!$TURBO_ROOT$/apps/demo-nuxt/.nuxt/**",
        "!$TURBO_ROOT$/apps/demo-nuxt/.output/**",
        "!$TURBO_ROOT$/apps/demo-nuxt/.nuxt-typecheck/**",
        "!$TURBO_ROOT$/apps/demo-nuxt/.turbo/**",
        "!$TURBO_ROOT$/apps/demo-nuxt/test-output/**",
        "!$TURBO_ROOT$/apps/demo-nuxt/README.md",
        "!$TURBO_ROOT$/apps/demo-nuxt/AGENTS.md"
      ],
      // It serves the demo's production build (`.output/`).
      "dependsOn": ["install-browsers", "@zitadel/api-mock#build", "@zitadel/demo-nuxt#build"],
      "env": ["ZITADEL_*", "NEXTGEN_*", "REAL_*", "EMBEDDED_*", "PLATFORM_*", "!ZITADEL_TELEMETRY*"],
      "passThroughEnv": ["ZITADEL_TELEMETRY*", "JOURNEY_*", "PLAYWRIGHT_*", "PWDEBUG", "DEBUG", "RUNNER_TEMP", "GITHUB_*", "DOCKER_*", "TESTCONTAINERS_*"]
    },
    // The journey runner with caller-supplied flags (`turbo run journey
    // --filter=@zitadel/e2e -- <flags>`); the script defaults
    // ZITADEL_TELEMETRY to 0.
    "journey": {
      "inputs": ["package.json"],
      "dependsOn": ["journey-base"],
      "cache": false,
      "passThroughEnv": ["ZITADEL_*", "NEXTGEN_*", "JOURNEY_*", "REAL_*", "EMBEDDED_*", "PLATFORM_*", "PLAYWRIGHT_*", "PWDEBUG", "DEBUG", "RUNNER_TEMP", "GITHUB_*", "DOCKER_*", "TESTCONTAINERS_*"]
    },
    // The CI journey set, one task per journey (`--only`, run-local.mjs): a
    // process each, with its own slice of the journey port block, work dir
    // and registry, so turbo runs them side by side. The root `ci` script
    // names each, so `--affected` runs only the affected ones; `journey-local`
    // runs them all. frameworks.test.mjs fails when a journey of the `--ci`
    // set has no task here or in `ci`. Each packs the npm tarballs it installs
    // (`--packed`, journey-packages.mjs) from the builds it depends on: the
    // ones every journey installs (`journey-packages`, all five server
    // binaries included) and its framework's SDK. So a change to one SDK
    // selects only the journeys that install it; frameworks.test.mjs checks
    // these edges against the packages' manifests.
    "journey-packages": {
      "inputs": ["package.json"],
      "dependsOn": ["@zitadel/api#build", "@zitadel/cli#build", "@zitadel/components#build", "@zitadel/config#build", "@zitadel/sdk-core#build", "@zitadel/server-darwin-arm64#build-binary", "@zitadel/server-darwin-x64#build-binary", "@zitadel/server-linux-arm64#build-binary", "@zitadel/server-linux-x64#build-binary", "@zitadel/server-win32-x64#build-binary"]
    },
    "journey-local": {
      "cache": false,
      "inputs": ["package.json"],
      "dependsOn": ["journey:next", "journey:nuxt", "journey:react", "journey:vue", "journey:angular", "journey:solid", "journey:svelte", "journey:qwik", "journey:passkey", "journey:preexisting-next", "journey:preexisting-nuxt", "journey:testkit", "journey:remote"]
    },
    "journey:next": {
      "inputs": ["package.json"],
      "dependsOn": ["journey-base", "journey-packages", "@zitadel/sdk-next#build", "@zitadel/sdk-react#build"],
      "cache": false,
      "passThroughEnv": ["ZITADEL_*", "NEXTGEN_*", "JOURNEY_*", "REAL_*", "EMBEDDED_*", "PLATFORM_*", "PLAYWRIGHT_*", "PWDEBUG", "DEBUG", "RUNNER_TEMP", "GITHUB_*", "DOCKER_*", "TESTCONTAINERS_*"]
    },
    "journey:nuxt": {
      "inputs": ["package.json"],
      "dependsOn": ["journey-base", "journey-packages", "@zitadel/sdk-nuxt#build"],
      "cache": false,
      "passThroughEnv": ["ZITADEL_*", "NEXTGEN_*", "JOURNEY_*", "REAL_*", "EMBEDDED_*", "PLATFORM_*", "PLAYWRIGHT_*", "PWDEBUG", "DEBUG", "RUNNER_TEMP", "GITHUB_*", "DOCKER_*", "TESTCONTAINERS_*"]
    },
    "journey:react": {
      "inputs": ["package.json"],
      "dependsOn": ["journey-base", "journey-packages", "@zitadel/sdk-react#build"],
      "cache": false,
      "passThroughEnv": ["ZITADEL_*", "NEXTGEN_*", "JOURNEY_*", "REAL_*", "EMBEDDED_*", "PLATFORM_*", "PLAYWRIGHT_*", "PWDEBUG", "DEBUG", "RUNNER_TEMP", "GITHUB_*", "DOCKER_*", "TESTCONTAINERS_*"]
    },
    "journey:vue": {
      "inputs": ["package.json"],
      "dependsOn": ["journey-base", "journey-packages", "@zitadel/sdk-vue#build"],
      "cache": false,
      "passThroughEnv": ["ZITADEL_*", "NEXTGEN_*", "JOURNEY_*", "REAL_*", "EMBEDDED_*", "PLATFORM_*", "PLAYWRIGHT_*", "PWDEBUG", "DEBUG", "RUNNER_TEMP", "GITHUB_*", "DOCKER_*", "TESTCONTAINERS_*"]
    },
    "journey:angular": {
      "inputs": ["package.json"],
      "dependsOn": ["journey-base", "journey-packages", "@zitadel/sdk-angular#build"],
      "cache": false,
      "passThroughEnv": ["ZITADEL_*", "NEXTGEN_*", "JOURNEY_*", "REAL_*", "EMBEDDED_*", "PLATFORM_*", "PLAYWRIGHT_*", "PWDEBUG", "DEBUG", "RUNNER_TEMP", "GITHUB_*", "DOCKER_*", "TESTCONTAINERS_*"]
    },
    "journey:solid": {
      "inputs": ["package.json"],
      "dependsOn": ["journey-base", "journey-packages", "@zitadel/sdk-solid#build"],
      "cache": false,
      "passThroughEnv": ["ZITADEL_*", "NEXTGEN_*", "JOURNEY_*", "REAL_*", "EMBEDDED_*", "PLATFORM_*", "PLAYWRIGHT_*", "PWDEBUG", "DEBUG", "RUNNER_TEMP", "GITHUB_*", "DOCKER_*", "TESTCONTAINERS_*"]
    },
    "journey:svelte": {
      "inputs": ["package.json"],
      "dependsOn": ["journey-base", "journey-packages", "@zitadel/sdk-svelte#build"],
      "cache": false,
      "passThroughEnv": ["ZITADEL_*", "NEXTGEN_*", "JOURNEY_*", "REAL_*", "EMBEDDED_*", "PLATFORM_*", "PLAYWRIGHT_*", "PWDEBUG", "DEBUG", "RUNNER_TEMP", "GITHUB_*", "DOCKER_*", "TESTCONTAINERS_*"]
    },
    "journey:qwik": {
      "inputs": ["package.json"],
      "dependsOn": ["journey-base", "journey-packages", "@zitadel/sdk-qwik#build"],
      "cache": false,
      "passThroughEnv": ["ZITADEL_*", "NEXTGEN_*", "JOURNEY_*", "REAL_*", "EMBEDDED_*", "PLATFORM_*", "PLAYWRIGHT_*", "PWDEBUG", "DEBUG", "RUNNER_TEMP", "GITHUB_*", "DOCKER_*", "TESTCONTAINERS_*"]
    },
    "journey:passkey": {
      "inputs": ["package.json"],
      "dependsOn": ["journey-base", "journey-packages", "@zitadel/sdk-next#build", "@zitadel/sdk-react#build"],
      "cache": false,
      "passThroughEnv": ["ZITADEL_*", "NEXTGEN_*", "JOURNEY_*", "REAL_*", "EMBEDDED_*", "PLATFORM_*", "PLAYWRIGHT_*", "PWDEBUG", "DEBUG", "RUNNER_TEMP", "GITHUB_*", "DOCKER_*", "TESTCONTAINERS_*"]
    },
    "journey:preexisting-next": {
      "inputs": ["package.json"],
      "dependsOn": ["journey-base", "journey-packages", "@zitadel/sdk-next#build", "@zitadel/sdk-react#build"],
      "cache": false,
      "passThroughEnv": ["ZITADEL_*", "NEXTGEN_*", "JOURNEY_*", "REAL_*", "EMBEDDED_*", "PLATFORM_*", "PLAYWRIGHT_*", "PWDEBUG", "DEBUG", "RUNNER_TEMP", "GITHUB_*", "DOCKER_*", "TESTCONTAINERS_*"]
    },
    "journey:preexisting-nuxt": {
      "inputs": ["package.json"],
      "dependsOn": ["journey-base", "journey-packages", "@zitadel/sdk-nuxt#build"],
      "cache": false,
      "passThroughEnv": ["ZITADEL_*", "NEXTGEN_*", "JOURNEY_*", "REAL_*", "EMBEDDED_*", "PLATFORM_*", "PLAYWRIGHT_*", "PWDEBUG", "DEBUG", "RUNNER_TEMP", "GITHUB_*", "DOCKER_*", "TESTCONTAINERS_*"]
    },
    "journey:testkit": {
      "inputs": ["package.json"],
      "dependsOn": ["journey-base", "journey-packages", "@zitadel/sdk-next#build", "@zitadel/sdk-react#build", "@zitadel/testing#build"],
      "cache": false,
      "passThroughEnv": ["ZITADEL_*", "NEXTGEN_*", "JOURNEY_*", "REAL_*", "EMBEDDED_*", "PLATFORM_*", "PLAYWRIGHT_*", "PWDEBUG", "DEBUG", "RUNNER_TEMP", "GITHUB_*", "DOCKER_*", "TESTCONTAINERS_*"]
    },
    "journey:remote": {
      "inputs": ["package.json"],
      "dependsOn": ["journey-base", "journey-packages", "@zitadel/sdk-react#build"],
      "cache": false,
      "passThroughEnv": ["ZITADEL_*", "NEXTGEN_*", "JOURNEY_*", "REAL_*", "EMBEDDED_*", "PLATFORM_*", "PLAYWRIGHT_*", "PWDEBUG", "DEBUG", "RUNNER_TEMP", "GITHUB_*", "DOCKER_*", "TESTCONTAINERS_*"]
    }
  }
}
