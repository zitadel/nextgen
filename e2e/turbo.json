{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // One package holds every end-to-end lane, so each lane has its own task
    // name here and in moon.yml (the four packages it replaces each had an
    // `e2e` / `e2e-real`, which no longer fit side by side). The lanes boot real
    // servers and browsers, so none is cached and each passes through the
    // switches the Playwright configs and the journey runner read — the same
    // settings the root turbo.json gives its old e2e* tasks.
    //
    // `test` is the journey harness's unit tests in both runners. Where this
    // differs from moon.yml on purpose: moon runs the lanes through its `e2e:all`
    // aggregate in ci.yml's own e2e step; there is no `all` here, a
    // `turbo run` names the lanes it runs. Each
    // lane's inputs are its own folder plus the shared files (and, for the
    // demo lanes, the demo app they serve), less the docs and the ignored
    // trees, so a console spec edit does not select the journey and a demo
    // app edit selects the demo's lanes. The two demo-next lanes share a
    // task-guard mutex in package.json (both serve the demo on :3002),
    // standing in for moon's mutex of the same name.
    // The packed-CLI helpers and the journey's registry scripts import the
    // root release scripts; the harness's unit tests (`test`) also read the
    // CLI's skill and the router skill, the mock OIDC provider's users and the
    // built-in schemas.
    "typecheck": {
      "dependsOn": ["@zitadel/testing#build"],
      "inputs": ["$TURBO_EXTENDS$", "$TURBO_ROOT$/scripts/*.mjs", "$TURBO_ROOT$/scripts/*.d.mts"]
    },
    "test": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/scripts/*.mjs",
        "$TURBO_ROOT$/apps/cli/skills/**",
        "$TURBO_ROOT$/skills/zitadel/**",
        "$TURBO_ROOT$/tools/oidc-mock/users.json",
        "$TURBO_ROOT$/apps/api/api/openapi/endpoints/schemas/*.json"
      ]
    },
    "console-smoke": {
      "inputs": [
        "console/**",
        "package.json",
        "playwright.shared.ts",
        "!**/README.md",
        "!**/AGENTS.md"
      ],
      "dependsOn": ["install-browsers", "@zitadel/console#build"],
      "cache": false,
      "passThroughEnv": ["ZITADEL_*", "NEXTGEN_*", "JOURNEY_*", "REAL_*", "EMBEDDED_*", "PLATFORM_*", "PLAYWRIGHT_*", "PWDEBUG", "DEBUG", "RUNNER_TEMP", "GITHUB_*", "DOCKER_*", "TESTCONTAINERS_*"]
    },
    // The three real-instance console lanes boot the server build (which embeds
    // the working tree's UI dists) through the kit. The ports (8093, 8095,
    // 8097) and the binary path are the Playwright configs' defaults; the
    // scripts set the NEXTGEN_* switches each lane asserts.
    "console-real": {
      "inputs": [
        "console/**",
        "package.json",
        "playwright.shared.ts",
        "!**/README.md",
        "!**/AGENTS.md"
      ],
      "dependsOn": ["install-browsers", "@zitadel/testing#build", "@zitadel/cli#build", "@zitadel/server#build"],
      "cache": false,
      "passThroughEnv": ["ZITADEL_*", "NEXTGEN_*", "JOURNEY_*", "REAL_*", "EMBEDDED_*", "PLATFORM_*", "PLAYWRIGHT_*", "PWDEBUG", "DEBUG", "RUNNER_TEMP", "GITHUB_*", "DOCKER_*", "TESTCONTAINERS_*"]
    },
    "console-embedded": {
      "inputs": [
        "console/**",
        "package.json",
        "playwright.shared.ts",
        "!**/README.md",
        "!**/AGENTS.md"
      ],
      "dependsOn": ["install-browsers", "@zitadel/testing#build", "@zitadel/cli#build", "@zitadel/server#build"],
      "cache": false,
      "passThroughEnv": ["ZITADEL_*", "NEXTGEN_*", "JOURNEY_*", "REAL_*", "EMBEDDED_*", "PLATFORM_*", "PLAYWRIGHT_*", "PWDEBUG", "DEBUG", "RUNNER_TEMP", "GITHUB_*", "DOCKER_*", "TESTCONTAINERS_*"]
    },
    "console-platform": {
      "inputs": [
        "console/**",
        "package.json",
        "playwright.shared.ts",
        "!**/README.md",
        "!**/AGENTS.md"
      ],
      "dependsOn": ["install-browsers", "@zitadel/testing#build", "@zitadel/cli#build", "@zitadel/server#build"],
      "cache": false,
      "passThroughEnv": ["ZITADEL_*", "NEXTGEN_*", "JOURNEY_*", "REAL_*", "EMBEDDED_*", "PLATFORM_*", "PLAYWRIGHT_*", "PWDEBUG", "DEBUG", "RUNNER_TEMP", "GITHUB_*", "DOCKER_*", "TESTCONTAINERS_*"]
    },
    // The hosted cloud's console on a deployment, which CLOUD_URL names
    // (VERCEL_AUTOMATION_BYPASS_SECRET opens its protection); the root's
    // `pnpm check:cloud` runs it beside every other deployment suite, and the
    // deployment-checks workflow runs it for every deployment. Nothing to build.
    // The Playwright config refuses to run without CLOUD_URL.
    "console-deployment": {
      "inputs": [
        "console/**",
        "package.json",
        "playwright.shared.ts",
        "!**/README.md",
        "!**/AGENTS.md"
      ],
      "cache": false,
      "dependsOn": ["install-browsers"],
      "passThroughEnv": ["CLOUD_URL", "VERCEL_AUTOMATION_BYPASS_SECRET", "PLAYWRIGHT_*", "PWDEBUG", "DEBUG", "GITHUB_*"]
    },
    // The built-in schemas the `schemas` service publishes under /schemas/v1/
    // on the deployment CLOUD_URL names, beside the console's suite in
    // `pnpm check:cloud` and the deployment-checks workflow. The spec renders
    // the expected documents with the repo's own renderer, so its inputs
    // reach outside the package.
    "schemas-deployment": {
      "inputs": [
        "schemas/**",
        "package.json",
        "playwright.shared.ts",
        "$TURBO_ROOT$/scripts/render-builtin-schemas.mjs",
        "$TURBO_ROOT$/apps/api/api/openapi/endpoints/schemas/*.json",
        "!**/README.md",
        "!**/AGENTS.md"
      ],
      "cache": false,
      "dependsOn": ["install-browsers"],
      "passThroughEnv": ["CLOUD_URL", "VERCEL_AUTOMATION_BYPASS_SECRET", "PLAYWRIGHT_*", "PWDEBUG", "DEBUG", "GITHUB_*"]
    },
    // The packed CLI against the deployment CLOUD_URL names, beside the
    // console's and the schemas' suites in `pnpm check:cloud` and the
    // deployment-checks workflow (previews only: each run leaves a project in
    // the deployment's database). It packs the CLI with the release's own
    // code, so its inputs reach outside the package.
    "cli-deployment": {
      "inputs": [
        "cli/**",
        "package.json",
        "playwright.shared.ts",
        "$TURBO_ROOT$/scripts/release-artifacts.mjs",
        "$TURBO_ROOT$/scripts/release-manifest.mjs",
        "$TURBO_ROOT$/scripts/server-build.mjs",
        "!**/README.md",
        "!**/AGENTS.md"
      ],
      "dependsOn": ["install-browsers", "@zitadel/cli#build", "@zitadel/testing#build"],
      "cache": false,
      "passThroughEnv": ["CLOUD_URL", "VERCEL_AUTOMATION_BYPASS_SECRET", "PLAYWRIGHT_*", "PWDEBUG", "DEBUG", "GITHUB_*", "NODE_EXTRA_CA_CERTS"]
    },
    // Mock lanes run api-mock's `start` and the demo's `dev`, so they need what
    // those need rather than a production build of the demo.
    "demo-next-mock": {
      "inputs": [
        "demo-next/**",
        "package.json",
        "playwright.shared.ts",
        "$TURBO_ROOT$/apps/demo-next/**",
        "$TURBO_ROOT$/scripts/task-guard.mjs",
        "!**/README.md",
        "!**/AGENTS.md",
        "!$TURBO_ROOT$/apps/demo-next/node_modules/**",
        "!$TURBO_ROOT$/apps/demo-next/.next/**",
        "!$TURBO_ROOT$/apps/demo-next/README.md",
        "!$TURBO_ROOT$/apps/demo-next/AGENTS.md"
      ],
      "dependsOn": ["install-browsers", "@zitadel/api-mock#build", "@zitadel/sdk-next#build"],
      "cache": false,
      "passThroughEnv": ["ZITADEL_*", "NEXTGEN_*", "JOURNEY_*", "REAL_*", "EMBEDDED_*", "PLATFORM_*", "PLAYWRIGHT_*", "PWDEBUG", "DEBUG", "RUNNER_TEMP", "GITHUB_*", "DOCKER_*", "TESTCONTAINERS_*"]
    },
    // The same journey against a real ephemeral instance seeded via
    // @zitadel/testing. The script keeps the server-hosted UIs and the platform
    // project off.
    "demo-next-real": {
      "inputs": [
        "demo-next/**",
        "package.json",
        "playwright.shared.ts",
        "$TURBO_ROOT$/apps/demo-next/**",
        "$TURBO_ROOT$/scripts/task-guard.mjs",
        "!**/README.md",
        "!**/AGENTS.md",
        "!$TURBO_ROOT$/apps/demo-next/node_modules/**",
        "!$TURBO_ROOT$/apps/demo-next/.next/**",
        "!$TURBO_ROOT$/apps/demo-next/README.md",
        "!$TURBO_ROOT$/apps/demo-next/AGENTS.md"
      ],
      "dependsOn": ["install-browsers", "@zitadel/testing#build", "@zitadel/cli#build", "@zitadel/server#build"],
      "cache": false,
      "passThroughEnv": ["ZITADEL_*", "NEXTGEN_*", "JOURNEY_*", "REAL_*", "EMBEDDED_*", "PLATFORM_*", "PLAYWRIGHT_*", "PWDEBUG", "DEBUG", "RUNNER_TEMP", "GITHUB_*", "DOCKER_*", "TESTCONTAINERS_*"]
    },
    "demo-nuxt-mock": {
      "inputs": [
        "demo-nuxt/**",
        "package.json",
        "playwright.shared.ts",
        "$TURBO_ROOT$/apps/demo-nuxt/**",
        "!**/README.md",
        "!**/AGENTS.md",
        "!$TURBO_ROOT$/apps/demo-nuxt/node_modules/**",
        "!$TURBO_ROOT$/apps/demo-nuxt/.nuxt/**",
        "!$TURBO_ROOT$/apps/demo-nuxt/.output/**",
        "!$TURBO_ROOT$/apps/demo-nuxt/README.md",
        "!$TURBO_ROOT$/apps/demo-nuxt/AGENTS.md"
      ],
      "dependsOn": ["install-browsers", "@zitadel/api-mock#build", "@zitadel/sdk-nuxt#build"],
      "cache": false,
      "passThroughEnv": ["ZITADEL_*", "NEXTGEN_*", "JOURNEY_*", "REAL_*", "EMBEDDED_*", "PLATFORM_*", "PLAYWRIGHT_*", "PWDEBUG", "DEBUG", "RUNNER_TEMP", "GITHUB_*", "DOCKER_*", "TESTCONTAINERS_*"]
    },
    // The journey harness drives the real CLI binary and the mock OIDC
    // provider binary, imports the kit's virtual-passkey helper, and its claim
    // suite the console copy in
    // console/support/copy.ts. The scripts default ZITADEL_TELEMETRY to 0.
    // `e2e-local` is the runner with caller-supplied flags; `journey` is the
    // by-hand alias; `journey-local`, CI's lane, bakes in the `--ci` set and,
    // like moon's lane of the same name, also depends on every framework SDK
    // build so an SDK-only change selects it (sdk-next arrives via cli#build).
    // Unlike moon's, it also depends on the server's build: the server it runs
    // comes packed in the release snapshot, which CI builds in a step before
    // it, and without the edge a Go change would not select the journey. Moon
    // runs it with every other lane through `e2e:all`.
    "e2e-local": {
      "inputs": [
        "journey/**",
        "package.json",
        "console/support/copy.ts",
        "$TURBO_ROOT$/scripts/*.mjs",
        "$TURBO_ROOT$/apps/cli/skills/**",
        "$TURBO_ROOT$/tools/oidc-mock/users.json",
        "!**/README.md",
        "!**/AGENTS.md"
      ],
      "dependsOn": ["install-browsers", "@zitadel/cli#build", "@zitadel/testing#build", "oidc-mock#build"],
      "cache": false,
      "passThroughEnv": ["ZITADEL_*", "NEXTGEN_*", "JOURNEY_*", "REAL_*", "EMBEDDED_*", "PLATFORM_*", "PLAYWRIGHT_*", "PWDEBUG", "DEBUG", "RUNNER_TEMP", "GITHUB_*", "DOCKER_*", "TESTCONTAINERS_*"]
    },
    "journey": {
      "inputs": [
        "journey/**",
        "package.json",
        "console/support/copy.ts",
        "$TURBO_ROOT$/scripts/*.mjs",
        "$TURBO_ROOT$/apps/cli/skills/**",
        "$TURBO_ROOT$/tools/oidc-mock/users.json",
        "!**/README.md",
        "!**/AGENTS.md"
      ],
      "dependsOn": ["install-browsers", "@zitadel/cli#build", "@zitadel/testing#build", "oidc-mock#build"],
      "cache": false,
      "passThroughEnv": ["ZITADEL_*", "NEXTGEN_*", "JOURNEY_*", "REAL_*", "EMBEDDED_*", "PLATFORM_*", "PLAYWRIGHT_*", "PWDEBUG", "DEBUG", "RUNNER_TEMP", "GITHUB_*", "DOCKER_*", "TESTCONTAINERS_*"]
    },
    // The CI journey set, one task per journey (`--only`, run-local.mjs): a
    // process each, with its own slice of the journey port block, work dir
    // and registry, so turbo runs them side by side and `--affected` picks a
    // journey by its own SDK's build (the CLI build brings sdk-next's). Each
    // installs the release tarballs JOURNEY_TARBALLS_DIR names; the snapshot
    // the server it runs comes packed in lies outside the graph, hence the
    // server#build edge. RELEASE_HOST_ONLY: that snapshot may hold only this
    // machine's server platform package (verify-tarballs.mjs).
    "journey-local": {
      "cache": false,
      "dependsOn": ["journey:next", "journey:nuxt", "journey:react", "journey:vue", "journey:angular", "journey:solid", "journey:svelte", "journey:qwik", "journey:passkey", "journey:preexisting-next", "journey:preexisting-nuxt", "journey:testkit", "journey:remote"]
    },
    "journey:next": {
      "inputs": [
        "journey/**",
        "package.json",
        "console/support/copy.ts",
        "$TURBO_ROOT$/scripts/*.mjs",
        "$TURBO_ROOT$/apps/cli/skills/**",
        "$TURBO_ROOT$/tools/oidc-mock/users.json",
        "!**/README.md",
        "!**/AGENTS.md"
      ],
      "dependsOn": ["install-browsers", "@zitadel/cli#build", "@zitadel/testing#build", "oidc-mock#build", "@zitadel/server#build"],
      "cache": false,
      "passThroughEnv": ["ZITADEL_*", "NEXTGEN_*", "JOURNEY_*", "REAL_*", "EMBEDDED_*", "PLATFORM_*", "PLAYWRIGHT_*", "PWDEBUG", "DEBUG", "RUNNER_TEMP", "GITHUB_*", "DOCKER_*", "TESTCONTAINERS_*", "RELEASE_HOST_ONLY"]
    },
    "journey:nuxt": {
      "inputs": [
        "journey/**",
        "package.json",
        "console/support/copy.ts",
        "$TURBO_ROOT$/scripts/*.mjs",
        "$TURBO_ROOT$/apps/cli/skills/**",
        "$TURBO_ROOT$/tools/oidc-mock/users.json",
        "!**/README.md",
        "!**/AGENTS.md"
      ],
      "dependsOn": ["install-browsers", "@zitadel/cli#build", "@zitadel/testing#build", "oidc-mock#build", "@zitadel/server#build", "@zitadel/sdk-nuxt#build"],
      "cache": false,
      "passThroughEnv": ["ZITADEL_*", "NEXTGEN_*", "JOURNEY_*", "REAL_*", "EMBEDDED_*", "PLATFORM_*", "PLAYWRIGHT_*", "PWDEBUG", "DEBUG", "RUNNER_TEMP", "GITHUB_*", "DOCKER_*", "TESTCONTAINERS_*", "RELEASE_HOST_ONLY"]
    },
    "journey:react": {
      "inputs": [
        "journey/**",
        "package.json",
        "console/support/copy.ts",
        "$TURBO_ROOT$/scripts/*.mjs",
        "$TURBO_ROOT$/apps/cli/skills/**",
        "$TURBO_ROOT$/tools/oidc-mock/users.json",
