{
  "name": "@zitadel/e2e",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "test": "vitest run --config journey/vitest.config.ts",
    "api-contract-unit": "vitest run --config api-contract/vitest.unit.config.ts",
    "install-browsers": "playwright install chromium",
    "console-smoke": "playwright test --config console/playwright.config.mts",
    "console-real": "NEXTGEN_PLATFORM_BOOTSTRAP_PROJECT=${NEXTGEN_PLATFORM_BOOTSTRAP_PROJECT-false} NEXTGEN_SERVER_CONSOLE_ENABLED=${NEXTGEN_SERVER_CONSOLE_ENABLED-false} playwright test --config console/playwright.real.config.mts",
    "console-embedded": "NEXTGEN_PLATFORM_BOOTSTRAP_PROJECT=${NEXTGEN_PLATFORM_BOOTSTRAP_PROJECT-false} playwright test --config console/playwright.embedded.config.mts",
    "console-platform": "playwright test --config console/playwright.platform.config.mts",
    "api-contract": "NEXTGEN_SERVER_CONSOLE_ENABLED=${NEXTGEN_SERVER_CONSOLE_ENABLED-false} NEXTGEN_PLATFORM_BOOTSTRAP_PROJECT=${NEXTGEN_PLATFORM_BOOTSTRAP_PROJECT-false} vitest run --config api-contract/vitest.config.ts",
    "console-deployment": "playwright test --config console/playwright.deployment.config.mts",
    "schemas-deployment": "playwright test --config schemas/playwright.deployment.config.mts",
    "cli-deployment": "playwright test --config cli/playwright.deployment.config.mts",
    "demo-next-mock": "node ../scripts/task-guard.mjs --mutex demo-next-app -- playwright test --config demo-next/playwright.config.mts",
    "demo-next-real": "NEXTGEN_SERVER_CONSOLE_ENABLED=${NEXTGEN_SERVER_CONSOLE_ENABLED-false} NEXTGEN_PLATFORM_BOOTSTRAP_PROJECT=${NEXTGEN_PLATFORM_BOOTSTRAP_PROJECT-false} node ../scripts/task-guard.mjs --mutex demo-next-app -- playwright test --config demo-next/playwright.real.config.mts",
    "demo-nuxt-mock": "playwright test --config demo-nuxt/playwright.config.mts",
    "journey": "ZITADEL_TELEMETRY=${ZITADEL_TELEMETRY-0} node journey/scripts/run-local.mjs",
    "journey-packages": "node journey/scripts/pack-shared-packages.mjs",
    "journey:next": "ZITADEL_TELEMETRY=${ZITADEL_TELEMETRY-0} node journey/scripts/run-local.mjs --ci --runtime binary --packed --only fresh-app/next",
    "journey:nuxt": "ZITADEL_TELEMETRY=${ZITADEL_TELEMETRY-0} node journey/scripts/run-local.mjs --ci --runtime binary --packed --only fresh-app/nuxt",
    "journey:react": "ZITADEL_TELEMETRY=${ZITADEL_TELEMETRY-0} node journey/scripts/run-local.mjs --ci --runtime binary --packed --only fresh-app/react",
    "journey:vue": "ZITADEL_TELEMETRY=${ZITADEL_TELEMETRY-0} node journey/scripts/run-local.mjs --ci --runtime binary --packed --only fresh-app/vue",
    "journey:angular": "ZITADEL_TELEMETRY=${ZITADEL_TELEMETRY-0} node journey/scripts/run-local.mjs --ci --runtime binary --packed --only fresh-app/angular",
    "journey:solid": "ZITADEL_TELEMETRY=${ZITADEL_TELEMETRY-0} node journey/scripts/run-local.mjs --ci --runtime binary --packed --only fresh-app/solid",
    "journey:svelte": "ZITADEL_TELEMETRY=${ZITADEL_TELEMETRY-0} node journey/scripts/run-local.mjs --ci --runtime binary --packed --only fresh-app/svelte",
    "journey:qwik": "ZITADEL_TELEMETRY=${ZITADEL_TELEMETRY-0} node journey/scripts/run-local.mjs --ci --runtime binary --packed --only fresh-app/qwik",
    "journey:passkey": "ZITADEL_TELEMETRY=${ZITADEL_TELEMETRY-0} node journey/scripts/run-local.mjs --ci --runtime binary --packed --only passkey/next",
    "journey:preexisting-next": "ZITADEL_TELEMETRY=${ZITADEL_TELEMETRY-0} node journey/scripts/run-local.mjs --ci --runtime binary --packed --only preexisting/next",
    "journey:preexisting-nuxt": "ZITADEL_TELEMETRY=${ZITADEL_TELEMETRY-0} node journey/scripts/run-local.mjs --ci --runtime binary --packed --only preexisting/nuxt",
    "journey:testkit": "ZITADEL_TELEMETRY=${ZITADEL_TELEMETRY-0} node journey/scripts/run-local.mjs --ci --runtime binary --packed --only testkit/next",
    "journey:remote": "ZITADEL_TELEMETRY=${ZITADEL_TELEMETRY-0} node journey/scripts/run-local.mjs --ci --runtime binary --packed --only remote/react"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@zitadel/api": "workspace:*",
    "@zitadel/api-mock": "workspace:*",
    "@zitadel/config": "workspace:*",
    "@zitadel/sdk-nuxt": "workspace:*",
    "@zitadel/testing": "workspace:*",
    "@zitadel/vitest-config": "workspace:*",
    "p-map": "catalog:",
    "testcontainers": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
