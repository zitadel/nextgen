# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
api/openapi/bundled.yaml
bruno/

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env files (keep .env.example tracked)
.env*
!.env.example

# Editor/IDE
.idea/
.vscode/

__debug_bin*

# API clients
.kreya/

# Local agent workspace metadata (Nx writes these on update; not project-owned)
.claude/
.codex/
.opencode/
opencode.json
.agents/
.cursor/

# OSX
.DS_Store

#Frontend
## compiled output
dist
apps/server-*/bin/
tmp
.tmp/
out-tsc
coverage/
**/.vitest-attachments/
**/__screenshots__/
test-results/
playwright-report/
*.har

## dependencies
node_modules
npm-debug.log*
pnpm-debug.log*
*.code-workspace

## vite
vite.config.*.timestamp*
vitest.config.*.timestamp*
test-output

## moon
.moon/cache
.moon/docker

## Framework build outputs (Next.js / Nuxt / SvelteKit)
.next/
.nuxt/
.nuxt-typecheck/
.output/
.svelte-kit/

## Docs generated artifacts
apps/docs/.source/
apps/docs/.generated/

## Storybook static build
storybook-static/

## Go build cache
.go/

## Local runtime config
nextgen.yaml
/nextgen
nextgen-data/
.zitadel/local/

# Keep the embed placeholder so //go:embed all:dist works in clean checkouts.
# `dist/` above ignores the directory entirely, so we have to un-ignore the
# directory before re-ignoring its contents and re-allowing the placeholder.
!/internal/staticui/console/dist/
/internal/staticui/console/dist/*
!/internal/staticui/console/dist/.gitkeep
!/internal/staticui/login/dist/
/internal/staticui/login/dist/*
!/internal/staticui/login/dist/.gitkeep
apps/demo-next/tsconfig.tsbuildinfo
packages/api-mock/tsconfig.tsbuildinfo

.nx/
# Root TS incremental build info (generated)
tsconfig.tsbuildinfo
