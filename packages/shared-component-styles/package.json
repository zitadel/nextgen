{
  "name": "@zitadel/shared-component-styles",
  "version": "0.0.1-alpha.0",
  "private": true,
  "description": "Shared surface CSS for paired Lit atoms and React components that ship the same Figma look. Opt-in per component — Lit-only and React-only UI do not live here.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zitadel/nextgen.git",
    "directory": "packages/shared-component-styles"
  },
  "type": "module",
  "files": [
    "dist",
    "src",
    "pairs.json"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "exports": {
    "./package.json": "./package.json",
    "./styles.css": "./src/styles.css",
    "./button.css": "./src/button.css",
    "./text-field.css": "./src/text-field.css",
    "./alert.css": "./src/alert.css",
    "./pill.css": "./src/pill.css",
    "./attribution-markup": {
      "@zitadel/source": "./src/attribution-markup.ts",
      "types": "./dist/attribution-markup.d.mts",
      "import": "./dist/attribution-markup.mjs",
      "default": "./dist/attribution-markup.mjs"
    },
    "./icon.css": "./src/icon.css",
    "./card.css": "./src/card.css",
    "./page-shell.css": "./src/page-shell.css",
    "./checkbox.css": "./src/checkbox.css",
    "./select.css": "./src/select.css",
    "./lit/button-host.css": "./src/lit/button-host.css",
    "./lit/text-field-host.css": "./src/lit/text-field-host.css",
    "./lit/alert-host.css": "./src/lit/alert-host.css",
    "./lit/pill-host.css": "./src/lit/pill-host.css",
    "./lit/icon-host.css": "./src/lit/icon-host.css",
    "./lit/card-host.css": "./src/lit/card-host.css",
    "./lit/page-shell-host.css": "./src/lit/page-shell-host.css",
    "./lit/checkbox-host.css": "./src/lit/checkbox-host.css",
    "./lit/select-host.css": "./src/lit/select-host.css",
    "./pairs.json": "./pairs.json"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "tslib": "catalog:"
  }
}
