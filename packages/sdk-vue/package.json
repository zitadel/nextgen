    "test:all": "pnpm run test",
    "lint": "eslint ."
  },
  "dependencies": {
    "@zitadel/api": "workspace:*",
    "@zitadel/components": "workspace:*",
    "@zitadel/sdk-core": "workspace:*"
  },
  "peerDependencies": {
    "vue": ">=3"
  },
  "devDependencies": {
    "@testing-library/vue": "^8.1.0",
    "@vitest/coverage-v8": "catalog:sdk",
    "@zitadel/eslint-config": "workspace:*",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:sdk",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:sdk",
    "vue": "catalog:"
  }
}
