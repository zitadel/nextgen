{
  "name": "@zitadel/design-tokens",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "Figma-driven design tokens for the pre-release Zitadel preview — CSS variables, typed TypeScript constants, and a Tailwind v4 @theme block built from the published Zitadel Design System library.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zitadel/nextgen.git",
    "directory": "packages/design-tokens"
  },
  "type": "module",
  "files": [
    "dist",
    "src/generated",
    "src/overrides.ts"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@zitadel/source": "./src/generated/tokens.ts",
      "types": "./dist/tokens.d.mts",
      "import": "./dist/tokens.mjs"
    },
    "./css/tokens.css": "./src/generated/tokens.css",
    "./css/tailwind.css": "./src/generated/tailwind.css",
    "./css/shadcn.css": "./src/generated/shadcn.css"
  },
  "scripts": {
    "sync": "tsx scripts/sync-from-figma.ts",
    "sync:export": "tsx scripts/sync-from-export.ts",
    "generate": "tsx scripts/build.ts",
    "build": "tsdown",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "tslib": "catalog:",
    "tsx": "catalog:"
  }
}
