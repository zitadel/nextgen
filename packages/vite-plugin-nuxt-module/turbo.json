{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // The contract harness imports the plugin by its package name, from its dist.
    "typecheck": {
      "dependsOn": ["build"]
    },
    // Builds a fixture Nuxt module with the plugin, installs it into a Nuxt app and starts the
    // app: never cached, and not part of `test`.
    "test:contract": {
      "cache": false,
      "dependsOn": ["build"]
    }
  }
}
