{
  "name": "vite-plugin-nuxt-module",
  "version": "0.1.0",
  "private": true,
  "description": "A Vite plugin that builds a Nuxt module the way @nuxt/module-builder does: a bundled module with declarations, a per-file runtime, module.json and types.d.mts.",
  "homepage": "https://github.com/zitadel/nextgen/tree/main/packages/vite-plugin-nuxt-module#readme",
  "bugs": {
    "url": "https://github.com/zitadel/nextgen/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zitadel/nextgen.git",
    "directory": "packages/vite-plugin-nuxt-module"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json && tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run",
    "test:all": "pnpm run test",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "lint": "biome check .",
    "prepack": "publint --strict"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "dependencies": {
    "picomatch": "^4.0.4",
    "rolldown": "^1.2.12",
    "rolldown-plugin-dts": "^0.28.6"
  },
  "peerDependencies": {
    "@nuxt/kit": ">=3",
    "@nuxt/schema": ">=3",
    "nuxt": ">=3",
    "sass": ">=1",
    "sass-embedded": ">=1",
    "typescript": ">=5",
    "vite": ">=8",
    "vue-sfc-transformer": ">=0.1",
    "vue-tsc": ">=2"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    },
    "@nuxt/schema": {
      "optional": true
    },
    "nuxt": {
      "optional": true
    },
    "sass": {
      "optional": true
    },
    "sass-embedded": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "vue-sfc-transformer": {
      "optional": true
    },
    "vue-tsc": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/core": "catalog:",
    "@nuxt/kit": "catalog:",
    "@nuxt/schema": "catalog:",
    "@nuxt/test-utils": "catalog:",
    "@types/node": "catalog:",
    "@types/picomatch": "^4.0.2",
    "@vitest/coverage-v8": "catalog:",
    "h3": "catalog:",
    "nuxt": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "unplugin-dts": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-router": "^5.2.0",
    "vue-tsc": "catalog:"
  }
}
