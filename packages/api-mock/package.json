{
  "name": "@zitadel-nextgen/api-mock",
  "version": "0.0.0",
  "description": "Mock support library for @zitadel-nextgen/api",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./public-dir": {
      "types": "./src/public-dir.ts",
      "import": "./src/public-dir.ts"
    }
  },
  "scripts": {},
  "dependencies": {
    "@zitadel-nextgen/api": "workspace:*",
    "xstate": "catalog:"
  },
  "peerDependencies": {
    "msw": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "msw": "catalog:"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:noop",
        "dependsOn": [
          "^build"
        ]
      }
    }
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
