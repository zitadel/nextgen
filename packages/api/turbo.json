{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // Code generation reads the OpenAPI source outside the package. The
    // script holds the `generated-sources` lock (scripts/task-guard.mjs):
    // the server's generation and its checks rewrite the *-error-response.yaml
    // files this reads.
    "generate": {
      "inputs": ["$TURBO_EXTENDS$", "$TURBO_ROOT$/api/openapi/**/*.yaml", "$TURBO_ROOT$/scripts/task-guard.mjs"],
      "outputs": ["src/generated/**"]
    },
    "typecheck": {
      "dependsOn": ["generate"]
    },
    "build": {
      "dependsOn": ["generate"]
    },
    "test": {
      "dependsOn": ["generate"]
    },
    // Release writes wait for cli:test and server:test, including the normal
    // console build Go embeds. Every other release build reaches this one,
    // so no release dist is cleaned while those readers are running. Moon
    // orders server:test through its release entrypoints' serial deps to
    // avoid a project cycle.
    "build-release": {
      "dependsOn": ["generate", "@zitadel/cli#test", "@zitadel/server#test"]
    }
  }
}
