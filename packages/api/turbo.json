{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // Code generation reads the OpenAPI source outside the package. The
    // script holds the `generated-sources` lock (scripts/task-guard.mjs):
    // the server's generation and its checks rewrite the *-error-response.yaml
    // files this reads.
    "generate": {
      "inputs": ["$TURBO_EXTENDS$", "$TURBO_ROOT$/apps/api/api/openapi/**/*.yaml", "$TURBO_ROOT$/scripts/task-guard.mjs"],
      "outputs": ["src/generated/**"]
    },
    "typecheck": {
      "dependsOn": ["generate"]
    },
    "build": {
      "dependsOn": ["generate"]
    },
    "test": {
      "dependsOn": ["generate"]
    }
  }
}
