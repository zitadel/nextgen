{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // Code generation reads the OpenAPI source outside the package, the
    // server's committed *-error-response.yaml among it.
    "generate": {
      "inputs": ["$TURBO_EXTENDS$", "$TURBO_ROOT$/apps/api/api/openapi/**/*.yaml"],
      "outputs": ["src/generated/**"]
    },
    "typecheck": {
      "dependsOn": ["generate"]
    },
    "build": {
      "dependsOn": ["generate"]
    },
    "test": {
      "dependsOn": ["generate"]
    }
  }
}
