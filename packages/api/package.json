{
  "name": "@zitadel-nextgen/api",
  "version": "0.0.0",
  "description": "Generated TypeScript API client for Zitadel NextGen",
  "homepage": "https://github.com/zitadel/nextgen/tree/main/packages/api#readme",
  "bugs": {
    "url": "https://github.com/zitadel/nextgen/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zitadel/nextgen.git",
    "directory": "packages/api"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "orval": "catalog:"
  },
  "nx": {
    "targets": {
      "generate": {
        "executor": "nx:run-commands",
        "options": {
          "command": "pnpm exec orval --config orval.config.ts --clean",
          "cwd": "{projectRoot}"
        },
        "cache": true,
        "inputs": [
          "{workspaceRoot}/pnpm-lock.yaml",
          "{workspaceRoot}/api/openapi/**/*.yaml",
          "{projectRoot}/orval.config.ts",
          "{projectRoot}/src/index.ts",
          "{projectRoot}/src/runtime/base-url.ts"
        ],
        "outputs": [
          "{projectRoot}/src/generated"
        ]
      },
      "build": {
        "dependsOn": [
          "generate"
        ]
      },
      "typecheck": {
        "dependsOn": [
          "generate"
        ]
      },
      "test": {
        "dependsOn": [
          "generate"
        ]
      },
      "lint": {
        "dependsOn": [
          "generate"
        ]
      }
    }
  }
}
