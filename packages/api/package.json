{
  "name": "@zitadel-nextgen/api",
  "version": "0.0.0",
  "description": "Generated TypeScript API client for Zitadel NextGen",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "orval --config orval.config.ts --clean"
  },
  "devDependencies": {
    "orval": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-query": "catalog:"
  },
  "nx": {
    "targets": {
      "generate": {
        "cache": true,
        "inputs": [
          "{workspaceRoot}/pnpm-lock.yaml",
          "{workspaceRoot}/api/openapi/**/*.yaml",
          "{projectRoot}/package.json",
          "{projectRoot}/orval.config.ts",
          "{projectRoot}/src/runtime/base-url.ts"
        ],
        "outputs": [
          "{projectRoot}/src/generated"
        ]
      },
      "build": {
        "dependsOn": [
          "generate"
        ]
      },
      "typecheck": {
        "dependsOn": [
          "generate"
        ]
      },
      "test": {
        "dependsOn": [
          "generate"
        ]
      },
      "lint": {
        "dependsOn": [
          "generate"
        ]
      }
    }
  }
}
