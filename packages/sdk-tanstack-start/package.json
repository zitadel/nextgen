{
  "name": "@zitadel/sdk-tanstack-start",
  "version": "0.2.0",
  "description": "TanStack Start request middleware and helpers for Zitadel",
  "homepage": "https://github.com/zitadel/nextgen/tree/main/packages/sdk-tanstack-start#readme",
  "bugs": {
    "url": "https://github.com/zitadel/nextgen/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zitadel/nextgen.git",
    "directory": "packages/sdk-tanstack-start"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && attw --pack . --profile=esm-only",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json && tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run",
    "test:all": "pnpm run test",
    "lint": "biome check .",
    "build-release": "node ../../scripts/release-clean.mjs local-dist && pnpm run build",
    "prepack": "publint --strict"
  },
  "dependencies": {
    "@zitadel/api": "workspace:*",
    "@zitadel/components": "workspace:*",
    "@zitadel/sdk-core": "workspace:*",
    "@zitadel/sdk-react": "workspace:*",
    "ufo": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-start": ">=1.168.10",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@zitadel/vite": "workspace:*",
    "@zitadel/vitest-config": "workspace:*",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "unplugin-dts": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
