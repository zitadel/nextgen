    "test:all": "pnpm run test",
    "lint": "eslint ."
  },
  "dependencies": {
    "@zitadel/api": "workspace:*",
    "@zitadel/components": "workspace:*",
    "@zitadel/sdk-core": "workspace:*"
  },
  "peerDependencies": {
    "@builder.io/qwik": "^1.5.0"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.19.0",
    "@vitest/coverage-v8": "catalog:sdk",
    "@zitadel/eslint-config": "workspace:*",
    "eslint": "catalog:",
    "eslint-plugin-qwik": "catalog:",
    "jsdom": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:sdk",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:sdk"
  }
