    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.3.1",
    "@vitest/coverage-v8": "catalog:",
    "@zitadel/api-mock": "workspace:*",
    "jsdom": "catalog:",
    "msw": "catalog:",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "svelte2tsx": "^0.7.0",
    "typescript": "^5.7.3",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
