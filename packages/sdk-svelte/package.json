{
  "name": "@zitadel/sdk-svelte",
  "version": "0.1.0",
  "description": "Svelte components for the Zitadel auth UI (client-side SPA).",
  "homepage": "https://github.com/zitadel/nextgen/tree/main/packages/sdk-svelte#readme",
  "bugs": {
    "url": "https://github.com/zitadel/nextgen/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zitadel/nextgen.git",
    "directory": "packages/sdk-svelte"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "src/lib",
    "!src/lib/**/*.spec.ts"
  ],
  "svelte": "./src/lib/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./src/lib/index.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && (attw --pack . --profile=esm-only || true)",
    "typecheck": "svelte-check --tsconfig ./tsconfig.lib.json && svelte-check --tsconfig ./tsconfig.spec.json",
    "test": "vitest run",
    "test:all": "pnpm run test",
    "lint": "biome check .",
    "build-release": "node ../../scripts/release-clean.mjs local-dist && pnpm run build",
    "prepack": "publint --strict"
  },
  "dependencies": {
    "@zitadel/api": "workspace:*",
    "@zitadel/components": "workspace:*",
    "@zitadel/sdk-core": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "catalog:",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.3.1",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@zitadel/api-mock": "workspace:*",
    "jsdom": "catalog:",
    "msw": "catalog:",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "svelte2tsx": "^0.7.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
