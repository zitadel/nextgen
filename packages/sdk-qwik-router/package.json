{
  "name": "@zitadel/sdk-qwik-router",
  "version": "0.9.0",
  "description": "Qwik Router request handler and helpers for Zitadel",
  "homepage": "https://github.com/zitadel/nextgen/tree/main/packages/sdk-qwik-router#readme",
  "bugs": {
    "url": "https://github.com/zitadel/nextgen/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zitadel/nextgen.git",
    "directory": "packages/sdk-qwik-router"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.js"
    }
  },
  "files": [
    "dist",
    "!dist/api-docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && attw --pack . --profile=esm-only --no-emoji --no-summary",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json && tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run",
    "lint": "biome check . && knip --directory ../.. --workspace @zitadel/sdk-qwik-router --reporter symbols --reporter github-actions",
    "docs:api": "typedoc",
    "prepack": "publint --strict"
  },
  "dependencies": {
    "@zitadel/sdk-core": "workspace:*",
    "@zitadel/sdk-qwik": "workspace:*",
    "ufo": "catalog:"
  },
  "peerDependencies": {
    "@qwik.dev/core": "^2.0.0-beta.45",
    "@qwik.dev/router": "^2.0.0-beta.45"
  },
  "devDependencies": {
    "@qwik.dev/core": "catalog:",
    "@qwik.dev/router": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@zitadel/server-sdk-contract": "workspace:*",
    "@zitadel/vite": "workspace:*",
    "@zitadel/vitest-config": "workspace:*",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
