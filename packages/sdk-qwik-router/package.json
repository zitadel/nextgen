{
  "name": "@zitadel/sdk-qwik-router",
  "version": "0.3.0",
  "description": "Qwik Router request handler and helpers for Zitadel",
  "homepage": "https://github.com/zitadel/nextgen/tree/main/packages/sdk-qwik-router#readme",
  "bugs": {
    "url": "https://github.com/zitadel/nextgen/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zitadel/nextgen.git",
    "directory": "packages/sdk-qwik-router"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && attw --pack . --profile=esm-only",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json && tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run",
    "test:all": "pnpm run test",
    "lint": "biome check .",
    "build-release": "node ../../scripts/release-clean.mjs local-dist && pnpm run build",
    "prepack": "publint --strict"
  },
  "dependencies": {
    "@zitadel/api": "workspace:*",
    "@zitadel/sdk-core": "workspace:*",
    "ufo": "catalog:"
  },
  "peerDependencies": {
    "@qwik.dev/core": "^2.0.0-beta.45",
    "@qwik.dev/router": "^2.0.0-beta.45"
  },
  "devDependencies": {
    "@qwik.dev/core": "catalog:",
    "@qwik.dev/router": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@zitadel/vite": "workspace:*",
    "@zitadel/vitest-config": "workspace:*",
    "typescript": "catalog:",
    "unplugin-dts": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
