{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    // Qwik 2 JSX runtime, matching the `@qwik.dev/core` peer. The source here is
    // `.ts`-only today but the setting keeps the SDK Qwik-authorable.
    "jsx": "react-jsx",
    "jsxImportSource": "@qwik.dev/core",
    // tsup's dts step (rollup-plugin-dts) sets the deprecated `baseUrl` itself,
    // which TypeScript 6 rejects with TS5101 unless deprecations are ignored.
    "ignoreDeprecations": "6.0",
    "declaration": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__tests__/**",
    "src/test-setup.ts"
  ]
}
