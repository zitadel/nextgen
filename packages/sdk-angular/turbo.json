{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // The specs run the cases of @zitadel/framework-contract; its typecheck edge
    // puts their source in the typecheck and test hashes.
    "typecheck": {
      "dependsOn": ["build", "@zitadel/api-mock#build", "@zitadel/framework-contract#typecheck"]
    },
    "build": {
      "dependsOn": ["@zitadel/components#build", "@zitadel/sdk-core#build"]
    },
    // api-mock serves the Flow API to the specs (test-setup.ts).
    "test": {
      "dependsOn": ["@zitadel/api-mock#build", "build", "@zitadel/framework-contract#typecheck"]
    }
  }
}
