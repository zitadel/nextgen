    "outDir": "./dist/types",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true
  },
  "angularCompilerOptions": {
    "compilationMode": "partial",
    "_experimentalAllowEmitDeclarationOnly": true
  },
  "references": [
