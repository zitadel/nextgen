{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // Angular decorators are the legacy (experimental) kind, and Angular's
    // property initialisation semantics require [[Set]] class fields.
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "declaration": true
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictTemplates": true,
    "compilationMode": "partial"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts", "src/**/*.test.ts", "src/**/__tests__/**", "src/test-setup.ts"]
}
