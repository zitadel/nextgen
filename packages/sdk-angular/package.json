{
  "name": "@zitadel/sdk-angular",
  "version": "1.0.0-alpha.25",
  "description": "Angular components for the Zitadel auth UI (client-side SPA).",
  "homepage": "https://github.com/zitadel/nextgen/tree/main/packages/sdk-angular#readme",
  "bugs": {
    "url": "https://github.com/zitadel/nextgen/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zitadel/nextgen.git",
    "directory": "packages/sdk-angular"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "module": "./dist/index.js",
  "types": "./dist/types/public-api.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/public-api.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && ngc -p tsconfig.lib.json",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json && tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run",
    "test:all": "vitest run"
  },
  "dependencies": {
    "@zitadel/api": "workspace:*",
    "@zitadel/components": "workspace:*",
    "@zitadel/sdk-core": "workspace:*",
    "tslib": "^2.6.0"
  },
  "peerDependencies": {
    "@angular/common": ">=17",
    "@angular/core": ">=17"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.8.0",
    "@analogjs/vitest-angular": "^2.8.0",
    "@angular/build": "^22.2.2",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@testing-library/angular": "^19.4.1",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@zitadel/api-mock": "workspace:*",
    "jsdom": "catalog:",
    "msw": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zone.js": "~0.16.0"
  }
}
