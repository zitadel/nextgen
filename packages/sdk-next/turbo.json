{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "typecheck": {
      "dependsOn": ["@zitadel/components#build", "@zitadel/sdk-core#build"]
    },
    "build": {
      "dependsOn": ["@zitadel/components#build", "@zitadel/sdk-core#build"]
    },
    "build-release": {
      "dependsOn": ["@zitadel/components#build-release", "@zitadel/sdk-core#build-release"]
    },
    "test": {
      "dependsOn": ["build"]
    }
  }
}
