{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // The edge tests import this package's built dist. The middleware and
    // edge specs run the cases of @zitadel/server-sdk-contract, the client edge
    // spec those of @zitadel/client-sdk-contract; each typecheck edge puts that
    // package's source in this task's hash.
    "typecheck": {
      "dependsOn": [
        "build",
        "@zitadel/server-sdk-contract#typecheck",
        "@zitadel/client-sdk-contract#typecheck"
      ]
    },
    // src/components.ts re-exports the sdk-react wrappers, so tsc reads its
    // built dist; sdk-react's build waits for components and sdk-core.
    "build": {
      "dependsOn": ["@zitadel/sdk-react#build"]
    },
    "test": {
      "dependsOn": [
        "build",
        "@zitadel/server-sdk-contract#typecheck",
        "@zitadel/client-sdk-contract#typecheck"
      ]
    }
  }
}
