{
  "extends": "./tsconfig.lib.json",
  "compilerOptions": {
    "outDir": "dist",
    // The dist build resolves workspace dependencies through their built
    // dist types (like a real consumer), not the "@zitadel/source" condition:
    // source resolution would pull dependency .ts files into this program and
    // violate rootDir. Requires dependency dist/ to exist — Moon's build task
    // graph guarantees that.
    "customConditions": []
  }
}
