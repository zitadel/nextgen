{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "declaration": true,
    "skipLibCheck": true,
    "types": [],
    "customConditions": ["@zitadel/source"]
  },
  "include": ["src"],
  "references": [
    {
      "path": "../sdk-core"
    },
    {
      "path": "../components"
    },
    {
      "path": "../api"
    }
  ]
}
