{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "out-tsc/lib",
    "tsBuildInfoFile": "out-tsc/lib/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "dom",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "experimentalDecorators": true,
    "plugins": [
      {
        "name": "ts-lit-plugin"
      }
    ],
    "composite": false,
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/css-inline.d.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "src/jsx.d.ts"
  ]
}
