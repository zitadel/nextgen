{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2022", "dom", "DOM.Iterable"],
    "types": ["node"],
    "experimentalDecorators": true,
    "plugins": [
      {
        "name": "ts-lit-plugin"
      }
    ]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/css-inline.d.ts"],
  "exclude": ["src/**/*.spec.ts"],
  "references": [
    {
      "path": "../shared-component-styles"
    },
    {
      "path": "../api-mock/tsconfig.lib.json"
    },
    {
      "path": "../api/tsconfig.lib.json"
    },
    {
      "path": "../design-tokens/tsconfig.lib.json"
    }
  ]
}
