{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "out-tsc/lib",
    "tsBuildInfoFile": "out-tsc/lib/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": [
      "ES2022",
      "dom",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "experimentalDecorators": true,
    "plugins": [
      {
        "name": "ts-lit-plugin"
      }
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/css-inline.d.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "src/jsx.d.ts"
  ],
  "references": [
    {
      "path": "../api-mock/tsconfig.lib.json"
    },
    {
      "path": "../api/tsconfig.lib.json"
    },
    {
      "path": "../design-tokens/tsconfig.lib.json"
    }
  ]
}
