{
  "name": "@zitadel/sdk-solid-start",
  "version": "0.9.0",
  "description": "SolidStart middleware and helpers for Zitadel",
  "homepage": "https://github.com/zitadel/nextgen/tree/main/packages/sdk-solid-start#readme",
  "bugs": {
    "url": "https://github.com/zitadel/nextgen/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zitadel/nextgen.git",
    "directory": "packages/sdk-solid-start"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "solid": "./dist/components.js",
      "import": "./dist/components.js"
    }
  },
  "files": [
    "dist",
    "!dist/api-docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && attw --pack . --profile=esm-only --no-emoji --no-summary",
    "dev": "vite build --watch --emptyOutDir=false",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json && tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run",
    "lint": "biome check . && knip --directory ../.. --workspace @zitadel/sdk-solid-start --reporter symbols --reporter github-actions",
    "docs:api": "typedoc",
    "prepack": "publint --strict"
  },
  "dependencies": {
    "@zitadel/sdk-core": "workspace:*",
    "@zitadel/sdk-solid": "workspace:*",
    "ufo": "catalog:"
  },
  "peerDependencies": {
    "@solidjs/start": "^2.0.0",
    "solid-js": "^1.8.0"
  },
  "devDependencies": {
    "@solidjs/router": "^1.0.1",
    "@solidjs/start": "^2.2.2",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@zitadel/server-sdk-contract": "workspace:*",
    "@zitadel/vitest-config": "workspace:*",
    "solid-js": "^1.9.18",
    "typescript": "catalog:",
    "unplugin-dts": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
