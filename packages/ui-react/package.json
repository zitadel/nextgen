{
  "name": "@zitadel/ui-react",
  "version": "0.1.0-alpha.2",
  "private": true,
  "description": "Paired React implementations of @zitadel/components Lit atoms. Visually identical, consume @zitadel/design-tokens, used by the internal Zitadel console.",
  "homepage": "https://github.com/zitadel/nextgen/tree/main/packages/ui-react#readme",
  "bugs": {
    "url": "https://github.com/zitadel/nextgen/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zitadel/nextgen.git",
    "directory": "packages/ui-react"
  },
  "type": "module",
  "files": [
    "dist",
    "src/styles.css"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@zitadel/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@zitadel/design-tokens": "workspace:*",
    "@zitadel/shared-component-styles": "workspace:*",
    "lucide-react": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "tslib": "catalog:"
  }
}
