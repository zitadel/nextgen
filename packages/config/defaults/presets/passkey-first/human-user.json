{
  "title": "DefaultHumanUserSchema",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "metaSchema": "${SERVER_URL}/user-schema.json",
  "$id": "${USER_SCHEMA_URL}",
  "objectType": "human-user",
  "kind": "user-schema",
  "type": "object",
  "description": "The default editable schema for human users (passkey-first sign-in).",
  "x-auth-methods": {
    "passkey": {
      "enabled": true,
      "position": 1
    },
    "password": {
      "enabled": true,
      "position": 2
    }
  },
  "required": [
    "email"
  ],
  "properties": {
    "email": {
      "type": "string",
      "format": "email",
      "x-unique": "project",
      "description": "The user's email address."
    },
    "givenName": {
      "type": "string",
      "maxLength": 50,
      "description": "The user's given (first) name."
    },
    "familyName": {
      "type": "string",
      "maxLength": 50,
      "description": "The user's family (last) name."
    },
    "dateOfBirth": {
      "type": "string",
      "format": "date",
      "description": "The user's date of birth (ISO 8601, YYYY-MM-DD)."
    },
    "maritalStatus": {
      "type": "string",
      "enum": ["Single", "Married", "Divorced", "Widowed"],
      "description": "The user's marital status."
    },
    "newsletterOptIn": {
      "type": "boolean",
      "description": "The user's consent to receive newsletter."
    }
  }
}
