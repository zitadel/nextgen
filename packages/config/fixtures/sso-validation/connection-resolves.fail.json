{
  "rule": "sso/connection-resolves",
  "description": "The schema and a step both name google, and no connection file has that slug.",
  "tree": {
    "schemas": {
      ".zitadel/schemas/staff.json": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        },
        "x-auth-methods": {
          "sso": {
            "enabled": true,
            "providers": [
              "google"
            ]
          }
        }
      }
    },
    "flows": {
      ".zitadel/flows/login.json": {
        "schemaPath": ".zitadel/schemas/staff.json",
        "body": {
          "name": "login",
          "purposes": {
            "login": "identifier"
          },
          "steps": [
            {
              "name": "identifier",
              "fields": [
                "email"
              ],
              "sso_providers": [
                "google"
              ],
              "transitions": {
                "sso_authenticated": {
                  "target": "done"
                },
                "sso_user_not_found": {
                  "target": "done"
                },
                "user_already_exists": {
                  "target": "done"
                },
                "submit": {
                  "target": "done"
                }
              }
            },
            {
              "name": "register-sso",
              "fields": [
                "email"
              ],
              "on_success": "create_user_with_sso",
              "transitions": {
                "sso_authenticated": {
                  "target": "done"
                },
                "sso_user_not_found": {
                  "target": "done"
                },
                "user_already_exists": {
                  "target": "done"
                },
                "submit": {
                  "target": "done"
                }
              }
            }
          ]
        }
      }
    },
    "connections": {}
  },
  "expect": [
    {
      "rule": "sso/connection-resolves",
      "file": ".zitadel/schemas/staff.json",
      "includes": [
        "sso.providers",
        "google"
      ]
    },
    {
      "rule": "sso/connection-resolves",
      "file": ".zitadel/flows/login.json",
      "steps": [
        "identifier"
      ],
      "includes": [
        "identifier",
        "google"
      ]
    }
  ]
}
