{
  "rule": "sso/flow-enables-sso",
  "description": "A step offers a provider but the schema it pins has sso switched off.",
  "tree": {
    "schemas": {
      ".zitadel/schemas/staff.json": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        },
        "x-auth-methods": {
          "sso": {
            "enabled": false,
            "providers": []
          }
        }
      }
    },
    "flows": {
      ".zitadel/flows/login.json": {
        "schemaPath": ".zitadel/schemas/staff.json",
        "body": {
          "name": "login",
          "purposes": {
            "login": "identifier"
          },
          "steps": [
            {
              "name": "identifier",
              "fields": [
                "email"
              ],
              "sso_providers": [
                "google"
              ],
              "transitions": {
                "sso_authenticated": {
                  "target": "done"
                },
                "sso_user_not_found": {
                  "target": "done"
                },
                "user_already_exists": {
                  "target": "done"
                },
                "submit": {
                  "target": "done"
                }
              }
            },
            {
              "name": "register-sso",
              "fields": [
                "email"
              ],
              "on_success": "create_user_with_sso",
              "transitions": {
                "sso_authenticated": {
                  "target": "done"
                },
                "sso_user_not_found": {
                  "target": "done"
                },
                "user_already_exists": {
                  "target": "done"
                },
                "submit": {
                  "target": "done"
                }
              }
            }
          ]
        }
      }
    },
    "connections": {
      ".zitadel/idps/google.json": {
        "slug": "google",
        "protocol": "oidc",
        "display_name": "Google",
        "claim_mapping": {
          "email": "email"
        },
        "oidc": {
          "issuer": "https://accounts.google.com",
          "client_id": "${{ GOOGLE_CLIENT_ID }}",
          "client_secret": "${{ GOOGLE_CLIENT_SECRET }}",
          "scopes": [
            "openid"
          ]
        }
      }
    }
  },
  "expect": [
    {
      "rule": "sso/flow-enables-sso",
      "file": ".zitadel/flows/login.json",
      "steps": [
        "identifier"
      ],
      "includes": [
        "identifier",
        "not an enabled authentication method"
      ]
    }
  ]
}
