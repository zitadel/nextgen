{
  "rule": "sso/empty-claim-mapping",
  "description": "A provider that only signs people in needs no mapping or register routes; a nested mapping name resolves.",
  "tree": {
    "schemas": {
      ".zitadel/schemas/staff.json": {
        "type": "object",
        "properties": {
          "email": {},
          "address": {
            "properties": {
              "street": {}
            }
          }
        },
        "x-auth-methods": {
          "sso": {
            "enabled": true,
            "providers": [
              "google",
              "acme"
            ]
          }
        }
      }
    },
    "flows": {
      ".zitadel/flows/login.json": {
        "schemaPath": ".zitadel/schemas/staff.json",
        "body": {
          "name": "login",
          "purposes": {
            "login": "identifier"
          },
          "steps": [
            {
              "name": "identifier",
              "fields": [
                "email"
              ],
              "sso_providers": [
                "google"
              ],
              "transitions": {
                "sso_authenticated": {
                  "target": "done"
                }
              }
            },
            {
              "name": "register",
              "fields": [
                "email"
              ],
              "sso_providers": [
                "acme"
              ],
              "transitions": {
                "sso_authenticated": {
                  "target": "done"
                },
                "sso_user_not_found": {
                  "target": "done"
                },
                "user_already_exists": {
                  "target": "done"
                },
                "submit": {
                  "target": "done"
                }
              }
            },
            {
              "name": "register-sso",
              "fields": [
                "email"
              ],
              "on_success": "create_user_with_sso",
              "transitions": {
                "sso_authenticated": {
                  "target": "done"
                },
                "sso_user_not_found": {
                  "target": "done"
                },
                "user_already_exists": {
                  "target": "done"
                },
                "submit": {
                  "target": "done"
                }
              }
            }
          ]
        }
      }
    },
    "connections": {
      ".zitadel/idps/google.json": {
        "slug": "google",
        "protocol": "oidc",
        "display_name": "Google",
        "claim_mapping": {},
        "oidc": {
          "issuer": "https://accounts.google.com",
          "client_id": "${{ GOOGLE_CLIENT_ID }}",
          "client_secret": "${{ GOOGLE_CLIENT_SECRET }}",
          "scopes": [
            "openid"
          ]
        },
        "provisioning": {
          "creation": "disabled"
        }
      },
      ".zitadel/idps/acme.json": {
        "slug": "acme",
        "protocol": "oidc",
        "display_name": "Acme",
        "claim_mapping": {
          "address.street": "street"
        },
        "oidc": {
          "issuer": "https://accounts.google.com",
          "client_id": "${{ GOOGLE_CLIENT_ID }}",
          "client_secret": "${{ GOOGLE_CLIENT_SECRET }}",
          "scopes": [
            "openid"
          ]
        }
      }
    }
  },
  "expect": []
}
