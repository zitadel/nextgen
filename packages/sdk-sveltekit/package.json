{
  "name": "@zitadel/sdk-sveltekit",
  "version": "0.1.0-alpha.11",
  "description": "SvelteKit handle hook and helpers for Nextgen Auth",
  "homepage": "https://github.com/zitadel/nextgen/tree/main/packages/sdk-sveltekit#readme",
  "bugs": {
    "url": "https://github.com/zitadel/nextgen/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zitadel/nextgen.git",
    "directory": "packages/sdk-sveltekit"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/server.ts src/client.ts src/types.ts --format esm --dts --clean --external @sveltejs/kit",
    "dev": "tsup src/index.ts src/server.ts src/client.ts --format esm --dts --watch --external @sveltejs/kit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint ."
  },
  "dependencies": {
    "@zitadel/api": "workspace:*",
    "@zitadel/components": "workspace:*",
    "@zitadel/sdk-core": "workspace:*"
  },
  "peerDependencies": {
    "@sveltejs/kit": ">=2",
    "svelte": ">=5"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@eslint/json": "catalog:",
    "@eslint/markdown": "catalog:",
    "@sveltejs/kit": "^2.0.0",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-perfectionist": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "prettier": "catalog:",
    "svelte": "^5.0.0",
    "tsup": "catalog:",
    "typescript": "^5.7.3",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "^3.0.0"
  }
}
