{
  "entries": {
    ".": {
      "source": "src/index.ts",
      "kind": "other",
      "extras": [
        "AuthResult",
        "AuthState",
        "ClientAuthResult",
        "NextgenMiddlewareOptions",
        "NextgenSession",
        "UnauthState",
        "ZitadelConfig",
        "ZitadelProject",
        "configureZitadel",
        "createNextgenMiddleware",
        "getApi",
        "getAuth",
        "getZitadelConfig"
      ]
    },
    "./server": {
      "source": "src/server.ts",
      "kind": "server",
      "extras": ["NextgenHandle"]
    },
    "./client": {
      "source": "src/client.ts",
      "kind": "client"
    }
  }
}
