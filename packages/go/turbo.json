{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  // The public Go API client: the Go module turbo finds through go.work as
  // the package `zitadel/v5`. Its api/ package is the server's committed
  // generation output (@zitadel/server#check-generate). A Go module has no
  // scripts, so each task gives its `command`. vet compiles the module, so
  // turbo's built-in `build` is dropped, and its `lint` (go vet) too. Their
  // keys hold the Go toolchain and target (docs/design/build/turborepo.md).
  "tasks": {
    // Tracked Go files only, as the server project checks them. Turbo's own
    // `format` (go fmt) rewrites and stays uncached; this one only checks.
    "format": {
      "cache": true,
      "command": ["node", "../../scripts/go-format-check.mjs"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/go-format-check.mjs", "$TURBO_ROOT$/scripts/dev-process.mjs"]
    },
    "vet": {
      "command": ["go", "vet", "./..."],
      "env": ["GOFLAGS", "CGO_ENABLED", "GOOS", "GOARCH"]
    },
    // The lint group: vet and format do the work. A Go module's task always
    // gets turbo's built-in command (go vet for lint), hence the no-op.
    "lint": { "extends": false, "dependsOn": ["vet", "format"], "command": ["node", "-e", "0"] },
    "build": { "extends": false },
    "test": {
      "command": ["go", "test", "-count=1", "-timeout", "5m", "./..."],
      "env": ["GOFLAGS", "CGO_ENABLED", "GOOS", "GOARCH"],
      // api/client_test.go holds PathPrefix to the spec's servers URL, a file
      // outside the module that Go's result cache does not see (-count=1).
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/api/api/openapi/openapi-spec.yaml"]
    }
  }
}
