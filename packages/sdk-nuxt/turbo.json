{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // The edge spec imports this package's built dist.
    "typecheck": {
      "dependsOn": ["build"]
    },
    // demo-nuxt:build resolves modules from this dist; moon shares a mutex
    // (`sdk-nuxt-dist`) between its two builders and demo-nuxt. Under turbo
    // this build is the only one that writes the dist (the release graph
    // packs it too), and demo-nuxt's build waits for it through its edge.
    "build": {
      "dependsOn": ["@zitadel/components#build", "@zitadel/sdk-core#build"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    // tsup's declaration pass resolves the workspace packages, which need
    // api's generated client and the built dependencies.
    "dev": {
      "dependsOn": ["@zitadel/components#build", "@zitadel/sdk-core#build"]
    }
  }
}
