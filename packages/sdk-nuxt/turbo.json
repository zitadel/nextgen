{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // The edge spec imports this package's built dist, and the middleware and
    // edge specs run the cases of @zitadel/server-sdk-contract, whose
    // typecheck edge puts its source in this task's hash.
    "typecheck": {
      "dependsOn": ["build", "@zitadel/server-sdk-contract#typecheck"]
    },
    // @zitadel/demo-nuxt#build resolves modules from this dist. This build is
    // the only one that writes the dist (the release graph packs it too), and
    // demo-nuxt's build waits for it through its edge.
    "build": {
      "dependsOn": ["@zitadel/components#build", "@zitadel/sdk-core#build"]
    },
    "test": {
      "dependsOn": ["build", "@zitadel/server-sdk-contract#typecheck"]
    },
    // tsup's declaration pass resolves the workspace packages, which need
    // api's generated client and the built dependencies.
    "dev": {
      "dependsOn": ["@zitadel/components#build", "@zitadel/sdk-core#build"]
    }
  }
}
