{
  "name": "@zitadel/sdk-nuxt",
  "version": "0.2.0",
  "description": "Nuxt proxy middleware and helpers for the pre-release Zitadel preview.",
  "homepage": "https://github.com/zitadel/nextgen/tree/main/packages/sdk-nuxt#readme",
  "bugs": {
    "url": "https://github.com/zitadel/nextgen/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zitadel/nextgen.git",
    "directory": "packages/sdk-nuxt"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./module": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && attw --pack . --profile=esm-only",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json && tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run",
    "test:all": "pnpm run test",
    "lint": "biome check .",
    "build-release": "node ../../scripts/release-clean.mjs local-dist && pnpm run build",
    "prepack": "publint --strict"
  },
  "dependencies": {
    "@zitadel/api": "workspace:*",
    "@zitadel/components": "workspace:*",
    "@zitadel/sdk-core": "workspace:*",
    "ufo": "catalog:"
  },
  "peerDependencies": {
    "h3": ">=1",
    "nuxt": ">=4"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@mridang/vite-plugin-nuxt-module": "^0.1.1",
    "@nuxt/kit": "catalog:",
    "@nuxt/schema": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@zitadel/vite": "workspace:*",
    "@zitadel/vitest-config": "workspace:*",
    "h3": "^1.15.3",
    "nuxt": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
