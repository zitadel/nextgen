{
  "name": "@nextgen/sdk-nuxt",
  "version": "0.0.0",
  "description": "Nuxt proxy middleware and helpers for Nextgen Auth",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": ["dist"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsup src/index.ts src/server.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts src/server.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nextgen/ui-lit": "workspace:*"
  },
  "peerDependencies": {
    "h3": ">=1",
    "nuxt": ">=4"
  },
  "devDependencies": {
    "h3": "^1.15.3",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  }
}
