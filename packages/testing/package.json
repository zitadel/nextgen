{
  "name": "@zitadel/testing",
  "version": "0.2.0",
  "description": "Test-kit for seeded ephemeral local Zitadel instances",
  "homepage": "https://github.com/zitadel/nextgen/tree/main/packages/testing#readme",
  "bugs": {
    "url": "https://github.com/zitadel/nextgen/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zitadel/nextgen.git",
    "directory": "packages/testing"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@zitadel/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./playwright": {
      "@zitadel/source": "./src/playwright.ts",
      "types": "./dist/playwright.d.mts",
      "import": "./dist/playwright.mjs",
      "require": "./dist/playwright.cjs",
      "default": "./dist/playwright.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && attw --pack . --profile=esm-only --ignore-rules=false-esm",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json && tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run",
    "test:all": "pnpm run test",
    "test:integration": "ZITADEL_SERVER_BINARY=${ZITADEL_SERVER_BINARY-$PWD/../../dist/server/nextgen} NEXTGEN_SERVER_CONSOLE_ENABLED=${NEXTGEN_SERVER_CONSOLE_ENABLED-false} vitest run --config vitest.integration.config.ts",
    "lint": "biome check .",
    "build-release": "node ../../scripts/release-clean.mjs local-dist && pnpm run build",
    "prepack": "publint --strict"
  },
  "dependencies": {
    "@zitadel/api": "workspace:*",
    "@zitadel/cli": "workspace:*",
    "@zitadel/config": "workspace:*"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.60"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@zitadel/vitest-config": "workspace:*",
    "msw": "catalog:",
    "tsdown": "catalog:",
    "tslib": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
