{
  "name": "@zitadel/sdk-core",
  "version": "1.0.0-alpha.26",
  "description": "Core types and shared utilities for Zitadel SDKs",
  "homepage": "https://github.com/zitadel/nextgen/tree/main/packages/sdk-core#readme",
  "bugs": {
    "url": "https://github.com/zitadel/nextgen/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zitadel/nextgen.git",
    "directory": "packages/sdk-core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json && tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run",
    "test:all": "pnpm run test"
  },
  "exports": {
    ".": {
      "@zitadel/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./types": {
      "@zitadel/source": "./src/types.ts",
      "types": "./dist/types.d.mts",
      "import": "./dist/types.mjs"
    },
    "./jwt": {
      "@zitadel/source": "./src/jwt.ts",
      "types": "./dist/jwt.d.mts",
      "import": "./dist/jwt.mjs"
    },
    "./middleware": {
      "@zitadel/source": "./src/middleware.ts",
      "types": "./dist/middleware.d.mts",
      "import": "./dist/middleware.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@zitadel/api": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@zitadel/components": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
