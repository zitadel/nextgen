{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // contract.spec.ts imports @zitadel/components/events from its dist, and
    // the edge specs import this package's built dist.
    "typecheck": {
      "dependsOn": ["@zitadel/components#build", "build"]
    },
    "build": {
      "dependsOn": ["@zitadel/api#build"]
    },
    // contract.spec.ts reads these SDK specs to check their copied
    // SERVER_RENDER_CASES tables and standard-attribute test titles and bodies for drift,
    // and that every server SDK spec still runs @zitadel/server-sdk-contract,
    // and every SDK's manifest and docs and the demo apps' manifests and sources
    // to check that apps go through their SDK, skipping what that check skips
    // (dependencies, build output and Next's next-env.d.ts).
    "test": {
      "dependsOn": ["@zitadel/components#build", "build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/vitest-config/vitest.shared.mjs",
        "$TURBO_ROOT$/packages/vitest-config/vitest.shared.d.mts",
        "$TURBO_ROOT$/packages/sdk-react/src/index.spec.tsx",
        "$TURBO_ROOT$/packages/sdk-vue/src/components.spec.ts",
        "$TURBO_ROOT$/packages/sdk-angular/src/lib/components.spec.ts",
        "$TURBO_ROOT$/packages/sdk-svelte/src/index.spec.ts",
        "$TURBO_ROOT$/packages/sdk-svelte/src/index.ssr.spec.ts",
        "$TURBO_ROOT$/packages/sdk-solid/src/index.spec.tsx",
        "$TURBO_ROOT$/packages/sdk-solid/src/index.ssr.spec.tsx",
        "$TURBO_ROOT$/packages/sdk-qwik/src/index.spec.tsx",
        "$TURBO_ROOT$/packages/sdk-qwik/src/index.ssr.spec.tsx",
        "$TURBO_ROOT$/packages/sdk-react/src/index.tsx",
        "$TURBO_ROOT$/packages/sdk-vue/src/index.ts",
        "$TURBO_ROOT$/packages/sdk-angular/src/public-api.ts",
        "$TURBO_ROOT$/packages/sdk-svelte/src/lib/index.ts",
        "$TURBO_ROOT$/packages/sdk-solid/src/index.tsx",
        "$TURBO_ROOT$/packages/sdk-qwik/src/index.tsx",
        "$TURBO_ROOT$/packages/sdk-next/src/client.ts",
        "$TURBO_ROOT$/packages/sdk-nuxt/src/index.ts",
        "$TURBO_ROOT$/packages/sdk-tanstack-start/src/react.tsx",
        "$TURBO_ROOT$/packages/sdk-*/src/*.edge.spec.{ts,tsx}",
        "$TURBO_ROOT$/packages/*/vitest.config.ts",
        "$TURBO_ROOT$/packages/sdk-next/src/__tests__/client.edge.test.ts",
        "$TURBO_ROOT$/packages/sdk-next/src/__tests__/middleware.test.ts",
        "$TURBO_ROOT$/packages/sdk-nuxt/src/__tests__/server/middleware.test.ts",
        "$TURBO_ROOT$/packages/sdk-sveltekit/src/__tests__/handle.test.ts",
        "$TURBO_ROOT$/packages/sdk-solid-start/src/__tests__/middleware.test.ts",
        "$TURBO_ROOT$/packages/sdk-qwik-router/src/__tests__/request-handler.test.ts",
        "$TURBO_ROOT$/packages/sdk-tanstack-start/src/__tests__/middleware.test.ts",
        "$TURBO_ROOT$/packages/sdk-next/src/__tests__/middleware.edge.test.ts",
        "$TURBO_ROOT$/packages/sdk-nuxt/src/__tests__/server/middleware.edge.test.ts",
        "$TURBO_ROOT$/packages/sdk-sveltekit/src/__tests__/handle.edge.test.ts",
        "$TURBO_ROOT$/packages/sdk-solid-start/src/__tests__/middleware.edge.test.ts",
        "$TURBO_ROOT$/packages/sdk-qwik-router/src/__tests__/request-handler.edge.test.ts",
        "$TURBO_ROOT$/packages/sdk-tanstack-start/src/__tests__/middleware.edge.test.ts",
        "$TURBO_ROOT$/packages/sdk-*/package.json",
        "$TURBO_ROOT$/packages/sdk-*/README.md",
        "$TURBO_ROOT$/packages/sdk-*/skills/**/SKILL.md",
        "$TURBO_ROOT$/apps/demo-*/package.json",
        "$TURBO_ROOT$/apps/demo-*/**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts,vue,svelte,astro}",
        "!$TURBO_ROOT$/apps/demo-*/**/node_modules/**",
        "!$TURBO_ROOT$/apps/demo-*/**/dist/**",
        "!$TURBO_ROOT$/apps/demo-*/**/.output/**",
        "!$TURBO_ROOT$/apps/demo-*/**/.next*/**",
        "!$TURBO_ROOT$/apps/demo-*/**/.nuxt*/**",
        "!$TURBO_ROOT$/apps/demo-*/**/next-env.d.ts",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/packages/*/tsconfig.lib.json"
      ]
    }
  }
}
