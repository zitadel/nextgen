{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/*.gen.ts",
      "!**/next-env.d.ts",
      "!**/*.css",
      "!**/*.svg",
      "!**/*.html",
      "!**/*.json",
      "!**/*.jsonc",
      "!**/*.svelte",
      "!**/*.vue",
      "!**/mockServiceWorker.js",
      "!**/generated",
      "!**/dist",
      "!**/out-tsc",
      "!**/.nuxt-typecheck",
      "!**/conformance/fixtures"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "bracketSpacing": true,
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noSvgWithoutTitle": "error",
        "useAriaPropsSupportedByRole": "error",
        "useButtonType": "error",
        "useKeyWithClickEvents": "error",
        "useSemanticElements": "error"
      },
      "complexity": {
        "useLiteralKeys": "error",
        "useOptionalChain": "off"
      },
      "correctness": {
        "noEmptyPattern": "error",
        "noInnerDeclarations": "error",
        "noUnknownProperty": "error",
        "noUnusedFunctionParameters": "error",
        "noUnusedVariables": "error",
        "noQwikUseVisibleTask": "off",
        "useQwikValidLexicalScope": "off"
      },
      "performance": {
        "noAccumulatingSpread": "error"
      },
      "style": {
        "noDescendingSpecificity": "off",
        "noNonNullAssertion": "error",
        "useTemplate": "error"
      },
      "suspicious": {
        "noArrayIndexKey": "error",
        "noAssignInExpressions": "error",
        "noDoubleEquals": "error",
        "noDocumentCookie": "error",
        "noExplicitAny": "error",
        "noImplicitAnyLet": "error",
        "noShadowRestrictedNames": "error",
        "noTemplateCurlyInString": "off",
        "noThenProperty": "error",
        "useIterableCallbackReturn": "error"
      }
    }
  },
  "assist": {
    "enabled": false
  },
  "plugins": ["./biome-plugins/no-swallowed-chmod.grit", "./biome-plugins/no-removed-key.grit"],
  "overrides": [
    {
      "includes": ["**/apps/cli/src/**"],
      "plugins": [
        "./biome-plugins/no-raw-next-commands.grit",
        "./biome-plugins/no-consent-bypass.grit",
        "./biome-plugins/no-flag-alias.grit",
        "./biome-plugins/no-cli-spelling-read.grit",
        "./biome-plugins/no-own-colour.grit"
      ]
    },
    {
      "includes": [
        "**/apps/cli/src/**",
        "**/apps/cli/tests/**",
        "!**/apps/cli/src/lib/orca/patchers/**"
      ],
      "plugins": ["./biome-plugins/no-let.grit"]
    },
    {
      "includes": ["**/*.{test,spec}.{ts,tsx,mts,cts}", "**/__tests__/**", "**/tests/**"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": ["**/apps/console/src/lib/**", "**/apps/console/src/hooks/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/routes/**", "**/../routes/**"],
                    "message": "`routes` is above this layer (Console ADR 0007)."
                  },
                  {
                    "group": ["@/addon", "@/addon/**", "**/../addon/**"],
                    "message": "`addon` is above this layer (Console ADR 0007)."
                  },
                  {
                    "group": ["@/app-shell/**", "**/../app-shell/**"],
                    "message": "`app-shell` is above this layer (Console ADR 0007)."
                  },
                  {
                    "group": ["@/features/**", "**/../features/**"],
                    "message": "`features` is above this layer (Console ADR 0007)."
                  },
                  {
                    "group": ["@/components/**", "**/../components/**"],
                    "message": "`components` is above this layer (Console ADR 0007)."
                  },
                  {
                    "group": ["@/api/**", "**/../api/**"],
                    "message": "`api` is above this layer (Console ADR 0007)."
                  },
                  {
                    "group": ["@/auth/**", "**/../auth/**"],
                    "message": "`auth` is above this layer (Console ADR 0007)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/apps/console/src/components/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/routes/**", "**/../routes/**"],
                    "message": "`routes` is above this layer (Console ADR 0007)."
                  },
                  {
                    "group": ["@/addon", "@/addon/**", "**/../addon/**"],
                    "message": "`addon` is above this layer (Console ADR 0007)."
                  },
                  {
                    "group": ["@/app-shell/**", "**/../app-shell/**"],
                    "message": "`app-shell` is above this layer (Console ADR 0007)."
                  },
                  {
                    "group": ["@/features/**", "**/../features/**"],
                    "message": "`features` is above this layer (Console ADR 0007)."
                  },
                  {
                    "group": ["@/api/**", "**/../api/**"],
                    "message": "`api` is above this layer (Console ADR 0007)."
                  },
                  {
                    "group": ["@/auth/**", "**/../auth/**"],
                    "message": "`auth` is above this layer (Console ADR 0007)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/apps/console/src/features/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/routes/**", "**/../routes/**"],
                    "message": "`routes` is above this layer (Console ADR 0007)."
                  },
                  {
                    "group": ["@/app-shell/**", "**/../app-shell/**"],
                    "message": "`app-shell` is above this layer (Console ADR 0007)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/apps/console/src/app-shell/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/routes/**", "**/../routes/**"],
                    "message": "`routes` is above this layer (Console ADR 0007)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
