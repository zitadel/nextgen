{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "server": {
      "root": ".",
      "framework": "go",
      "installCommand": "sh apps/cloud/install.sh",
      "buildCommand": "sh apps/cloud/build.sh"
    },
    "console": {
      "root": "apps/console",
      "framework": "vite",
      "installCommand": "sh ../cloud/install.sh",
      "buildCommand": "cd ../.. && VITE_CONSOLE_VERCEL_INSIGHTS=1 corepack pnpm exec moon run console:build && rm -rf apps/console/dist && mkdir -p apps/console/dist/ui/console && cp -R internal/staticui/console/dist/. apps/console/dist/ui/console/",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/ui/console/(.*)",
          "destination": "/ui/console/index.html"
        }
      ]
    },
    "storybook": {
      "root": "apps/storybook",
      "framework": "storybook",
      "installCommand": "sh ../cloud/install.sh",
      "buildCommand": "cd ../.. && corepack pnpm exec moon run storybook:build && cd apps/storybook && mv dist storybook && mkdir dist && mv storybook dist/",
      "outputDirectory": "dist"
    },
    "docs": {
      "root": "apps/docs",
      "framework": "nextjs",
      "installCommand": "sh ../cloud/install.sh",
      "buildCommand": "corepack pnpm run build"
    }
  },
  "redirects": [
    {
      "source": "/ui/console",
      "destination": "/ui/console/",
      "permanent": true
    },
    {
      "source": "/storybook",
      "destination": "/storybook/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/ui/console/(.*)",
      "destination": {
        "service": "console"
      }
    },
    {
      "source": "/storybook/(.*)",
      "destination": {
        "service": "storybook"
      }
    },
    {
      "source": "/docs",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/docs/(.*)",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "server"
      }
    }
  ],
  "regions": ["fra1"]
}
