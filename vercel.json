{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "server": {
      "root": ".",
      "framework": "go",
      "installCommand": "sh apps/cloud/install.sh",
      "buildCommand": "sh apps/cloud/build.sh"
    },
    "console": {
      "root": "apps/console",
      "framework": "vite",
      "installCommand": "sh ../cloud/install.sh",
      "buildCommand": "cd ../.. && CONSOLE_BASE_PATH=/console/ CONSOLE_VERCEL_INSIGHTS=1 sh apps/cloud/turbo-build.sh @zitadel/console && rm -rf apps/console/dist && mkdir -p apps/console/dist/console && cp -R internal/staticui/console/dist/. apps/console/dist/console/",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/console/(.*)",
          "destination": "/console/index.html"
        }
      ]
    },
    "storybook": {
      "root": "apps/storybook",
      "framework": "storybook",
      "installCommand": "sh ../cloud/install.sh",
      "buildCommand": "cd ../.. && sh apps/cloud/turbo-build.sh @zitadel/storybook && cd apps/storybook && mv dist storybook && mkdir dist && mv storybook dist/",
      "outputDirectory": "dist"
    },
    "docs": {
      "root": "apps/docs",
      "framework": "nextjs",
      "installCommand": "sh ../cloud/install.sh",
      "buildCommand": "corepack pnpm run build"
    },
    "website": {
      "root": "apps/website",
      "framework": "nextjs",
      "installCommand": "sh ../cloud/install.sh",
      "buildCommand": "corepack pnpm run build"
    }
  },
  "redirects": [
    {
      "source": "/console",
      "destination": "/console/",
      "permanent": true
    },
    {
      "source": "/ui/console",
      "destination": "/console/",
      "permanent": false
    },
    {
      "source": "/ui/console/:path(.*)",
      "destination": "/console/:path",
      "permanent": false
    },
    {
      "source": "/storybook",
      "destination": "/storybook/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/console/runtime.json",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/console/(.*)",
      "destination": {
        "service": "console"
      }
    },
    {
      "source": "/storybook/(.*)",
      "destination": {
        "service": "storybook"
      }
    },
    {
      "source": "/docs",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/docs/(.*)",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/",
      "destination": {
        "service": "website"
      }
    },
    {
      "source": "/_next/(.*)",
      "destination": {
        "service": "website"
      }
    },
    {
      "source": "/favicon.ico",
      "destination": {
        "service": "website"
      }
    },
    {
      "source": "/favicons/(.*)",
      "destination": {
        "service": "website"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "server"
      }
    }
  ],
  "regions": ["fra1"],
  "git": {
    "deploymentEnabled": {
      "changeset-release/*": false,
      "gh-readonly-queue/**": false
    }
  }
}
