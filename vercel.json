{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "home": {
      "root": ".",
      "framework": "vite",
      "installCommand": "echo no install step",
      "buildCommand": "CLOUD_SERVICE=home sh apps/cloud/build-output.sh"
    },
    "server_eu": {
      "root": ".",
      "framework": "vite",
      "installCommand": "echo no install step",
      "buildCommand": "CLOUD_SERVICE=server_eu sh apps/cloud/build-output.sh"
    },
    "server_us": {
      "root": ".",
      "framework": "vite",
      "installCommand": "echo no install step",
      "buildCommand": "CLOUD_SERVICE=server_us sh apps/cloud/build-output.sh"
    },
    "cloud": {
      "root": ".",
      "framework": "vite",
      "installCommand": "echo no install step",
      "buildCommand": "CLOUD_SERVICE=cloud sh apps/cloud/build-output.sh"
    },
    "migrate": {
      "root": ".",
      "framework": "go",
      "buildCommand": "sh apps/cloud/vercel-build.sh"
    },
    "console": {
      "root": "apps/console",
      "framework": "vite",
      "installCommand": "corepack pnpm install --frozen-lockfile",
      "buildCommand": "cd ../.. && corepack pnpm exec moon run console:build && cd apps/console && rm -rf out && mkdir -p out/console && cp -R ../../internal/staticui/console/dist/. out/console/",
      "outputDirectory": "out",
      "rewrites": [
        {
          "source": "/console/(.*)",
          "destination": "/console/index.html"
        }
      ]
    },
    "docs": {
      "root": "apps/docs",
      "framework": "vite",
      "installCommand": "corepack pnpm install --filter @zitadel/docs... --frozen-lockfile",
      "buildCommand": "corepack pnpm run build"
    },
    "storybook": {
      "root": "apps/storybook",
      "framework": "storybook",
      "installCommand": "corepack pnpm install --frozen-lockfile",
      "buildCommand": "cd ../.. && corepack pnpm exec moon run storybook:build && cd apps/storybook && rm -rf out && mkdir -p out/storybook && cp -R dist/. out/storybook/",
      "outputDirectory": "out"
    },
    "website": {
      "root": "apps/website",
      "framework": "nextjs",
      "installCommand": "corepack pnpm install --filter @zitadel/website... --frozen-lockfile",
      "buildCommand": "corepack pnpm run build"
    }
  },
  "redirects": [
    {
      "source": "/storybook",
      "destination": "/storybook/",
      "permanent": true
    },
    {
      "source": "/console",
      "destination": "/console/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": {
        "service": "website"
      }
    },
    {
      "source": "/_next/(.*)",
      "destination": {
        "service": "website"
      }
    },
    {
      "source": "/console/runtime.json",
      "destination": {
        "service": "home"
      }
    },
    {
      "source": "/console/(.*)",
      "destination": {
        "service": "console"
      }
    },
    {
      "source": "/storybook/(.*)",
      "destination": {
        "service": "storybook"
      }
    },
    {
      "source": "/docs",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/docs/(.*)",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/docs.md",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/reference",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/reference/(.*)",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/assets/(.*)",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/RSC/(.*)",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/api/search",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/llms.txt",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/llms-full.txt",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/mcp",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/mcp/(.*)",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/eu",
      "destination": {
        "service": "server_eu"
      }
    },
    {
      "source": "/eu/(.*)",
      "destination": {
        "service": "server_eu"
      }
    },
    {
      "source": "/us",
      "destination": {
        "service": "server_us"
      }
    },
    {
      "source": "/us/(.*)",
      "destination": {
        "service": "server_us"
      }
    },
    {
      "source": "/cloud",
      "destination": {
        "service": "cloud"
      }
    },
    {
      "source": "/cloud/(.*)",
      "destination": {
        "service": "cloud"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "home"
      }
    }
  ],
  "regions": [
    "fra1"
  ],
  "git": {
    "deploymentEnabled": true
  }
}
