{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "server": {
      "root": ".",
      "entrypoint": "Dockerfile.vercel"
    },
    "console": {
      "root": "apps/console",
      "framework": "vite",
      "installCommand": "corepack pnpm install --frozen-lockfile",
      "buildCommand": "cd ../.. && corepack pnpm exec moon run console:build && cd apps/console && rm -rf out && mkdir -p out/console && cp -R ../../internal/staticui/console/dist/. out/console/",
      "outputDirectory": "out",
      "rewrites": [
        {
          "source": "/console/(.*)",
          "destination": "/console/index.html"
        }
      ]
    },
    "login": {
      "root": "apps/login-ui",
      "framework": "vite",
      "installCommand": "corepack pnpm install --frozen-lockfile",
      "buildCommand": "cd ../.. && corepack pnpm exec moon run login-ui:build && cd apps/login-ui && rm -rf out && mkdir -p out/login && cp -R ../../internal/staticui/login/dist/. out/login/",
      "outputDirectory": "out",
      "rewrites": [
        {
          "source": "/login/(.*)",
          "destination": "/login/index.html"
        }
      ]
    },
    "docs": {
      "root": "apps/docs",
      "framework": "vite",
      "installCommand": "corepack pnpm install --filter @zitadel/docs... --frozen-lockfile",
      "buildCommand": "corepack pnpm run build"
    },
    "storybook": {
      "root": "apps/storybook",
      "framework": "storybook",
      "installCommand": "corepack pnpm install --frozen-lockfile",
      "buildCommand": "cd ../.. && corepack pnpm exec moon run storybook:build && cd apps/storybook && rm -rf out && mkdir -p out/storybook && cp -R dist/. out/storybook/",
      "outputDirectory": "out"
    },
    "website": {
      "root": "apps/website",
      "framework": "nextjs",
      "installCommand": "corepack pnpm install --filter @zitadel/website... --frozen-lockfile",
      "buildCommand": "corepack pnpm run build"
    }
  },
  "redirects": [
    {
      "source": "/storybook",
      "destination": "/storybook/",
      "permanent": true
    },
    {
      "source": "/console",
      "destination": "/console/",
      "permanent": true
    },
    {
      "source": "/login",
      "destination": "/login/",
      "permanent": true
    },
    {
      "source": "/docs",
      "destination": "/docs/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": {
        "service": "website"
      }
    },
    {
      "source": "/_next/(.*)",
      "destination": {
        "service": "website"
      }
    },
    {
      "source": "/console/runtime.json",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/console/(.*)",
      "destination": {
        "service": "console"
      }
    },
    {
      "source": "/login/(.*)",
      "destination": {
        "service": "login"
      }
    },
    {
      "source": "/storybook/(.*)",
      "destination": {
        "service": "storybook"
      }
    },
    {
      "source": "/docs/(.*)",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "server"
      }
    }
  ],
  "regions": [
    "fra1"
  ],
  "crons": [
    {
      "path": "/readyz",
      "schedule": "*/5 * * * *"
    }
  ],
  "git": {
    "deploymentEnabled": false
  }
}
