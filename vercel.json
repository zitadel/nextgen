{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "server": {
      "root": "apps/cloud",
      "runtime": "container"
    },
    "docs": {
      "root": "apps/docs",
      "framework": "vite",
      "installCommand": "corepack pnpm install --filter @zitadel/docs... --frozen-lockfile",
      "buildCommand": "corepack pnpm run build"
    },
    "website": {
      "root": "apps/website",
      "framework": "nextjs",
      "installCommand": "corepack pnpm install --filter @zitadel/website... --frozen-lockfile",
      "buildCommand": "corepack pnpm run build"
    },
    "storybook": {
      "root": "apps/storybook",
      "framework": "storybook",
      "installCommand": "corepack pnpm install --frozen-lockfile",
      "buildCommand": "cd ../.. && corepack pnpm exec moon run storybook:build && cd apps/storybook && rm -rf out && mkdir -p out/storybook && cp -R dist/. out/storybook/",
      "outputDirectory": "out"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": {
        "service": "website"
      }
    },
    {
      "source": "/_next/(.*)",
      "destination": {
        "service": "website"
      }
    },
    {
      "source": "/storybook",
      "destination": {
        "service": "storybook"
      }
    },
    {
      "source": "/storybook/(.*)",
      "destination": {
        "service": "storybook"
      }
    },
    {
      "source": "/docs",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/docs/(.*)",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/docs.md",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/reference",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/reference/(.*)",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/assets/(.*)",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/RSC/(.*)",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/api/search",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/llms.txt",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/llms-full.txt",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/mcp",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/mcp/(.*)",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "server"
      }
    }
  ],
  "regions": [
    "fra1"
  ],
  "crons": [
    {
      "path": "/readyz",
      "schedule": "*/5 * * * *"
    }
  ],
  "git": {
    "deploymentEnabled": false
  }
}
