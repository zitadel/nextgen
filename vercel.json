{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "server": {
      "root": ".",
      "framework": "go",
      "buildCommand": "sh apps/cloud/build.sh"
    },
    "console": {
      "root": "apps/console",
      "framework": "vite",
      "installCommand": "pnpm install --os=current --cpu=current --optimistic-repeat-install",
      "buildCommand": "CONSOLE_BASE_PATH=/console/ CONSOLE_VERCEL_INSIGHTS=1 turbo run build",
      "outputDirectory": "../../internal/staticui/console/dist",
      "rewrites": [
        {
          "source": "/console/:path(.*)?",
          "destination": "/:path"
        },
        {
          "source": "/:path*",
          "destination": "/index.html"
        }
      ]
    },
    "storybook": {
      "root": "apps/storybook",
      "framework": "storybook",
      "installCommand": "pnpm install --os=current --cpu=current --optimistic-repeat-install",
      "buildCommand": "turbo run build",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/storybook/:path(.*)?",
          "destination": "/:path"
        }
      ]
    },
    "docs": {
      "root": "apps/docs",
      "framework": "nextjs",
      "installCommand": "pnpm install --os=current --cpu=current --optimistic-repeat-install",
      "buildCommand": "pnpm run build"
    },
    "website": {
      "root": "apps/website",
      "framework": "nextjs",
      "installCommand": "pnpm install --os=current --cpu=current --optimistic-repeat-install",
      "buildCommand": "turbo run build --filter=@zitadel/components && pnpm run build"
    }
  },
  "redirects": [
    {
      "source": "/console",
      "destination": "/console/",
      "permanent": true
    },
    {
      "source": "/ui/console",
      "destination": "/console/",
      "permanent": false
    },
    {
      "source": "/ui/console/:path(.*)",
      "destination": "/console/:path",
      "permanent": false
    },
    {
      "source": "/storybook",
      "destination": "/storybook/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/console/runtime.json",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/console/(.*)",
      "destination": {
        "service": "console"
      }
    },
    {
      "source": "/storybook/(.*)",
      "destination": {
        "service": "storybook"
      }
    },
    {
      "source": "/docs",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/docs/(.*)",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/",
      "destination": {
        "service": "website"
      }
    },
    {
      "source": "/_next/(.*)",
      "destination": {
        "service": "website"
      }
    },
    {
      "source": "/favicon.ico",
      "destination": {
        "service": "website"
      }
    },
    {
      "source": "/favicons/(.*)",
      "destination": {
        "service": "website"
      }
    },
    {
      "source": "/llms.txt",
      "destination": {
        "service": "website"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "server"
      }
    }
  ],
  "regions": ["fra1"],
  "git": {
    "deploymentEnabled": {
      "changeset-release/*": false,
      "gh-readonly-queue/**": false
    }
  }
}
