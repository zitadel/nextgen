{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "server": {
      "root": "apps/cloud",
      "framework": "node",
      "entrypoint": "server/index.mjs",
      "installCommand": "pnpm -w run install:cloud",
      "buildCommand": "cd ../.. && . apps/cloud/install-go.sh && GOCACHE=\"$PWD/.vercel/cache/cloud-go/build\" GOMODCACHE=\"$PWD/.vercel/cache/cloud-go/modules\" node_modules/.bin/turbo run deploy --filter=@zitadel/cloud",
      "functions": {
        "server/index.mjs": {
          "regions": ["fra1"],
          "includeFiles": "dist/nextgen-launcher"
        }
      }
    },
    "console": {
      "root": "apps/console",
      "framework": "vite",
      "installCommand": "pnpm -w run install:cloud",
      "buildCommand": "CONSOLE_BASE_PATH=/console/ CONSOLE_ADDON=../cloud-console turbo run build",
      "devCommand": "NODE_ENV=production CONSOLE_BASE_PATH=/console/ CONSOLE_ADDON=../cloud-console vite build --outDir node_modules/.cloud-dev && vite preview --outDir node_modules/.cloud-dev --base / --port $PORT --strictPort",
      "outputDirectory": "../api/internal/staticui/console/dist",
      "headers": [
        {
          "source": "/(.*)",
          "headers": [
            {
              "key": "Content-Security-Policy",
              "value": "script-src 'self' 'sha256-8uazrJgLK9xksqbl8B40+OlfBNJOCmls8ZpXp3Pr0xk=' https://vercel.live; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; report-uri /csp-report"
            },
            {
              "key": "Content-Security-Policy-Report-Only",
              "value": "default-src 'self'; script-src 'self' 'sha256-8uazrJgLK9xksqbl8B40+OlfBNJOCmls8ZpXp3Pr0xk=' https://vercel.live; style-src 'self' 'unsafe-inline' https://vercel.live; img-src 'self' data: https: blob:; font-src 'self' https://vercel.live https://assets.vercel.com; connect-src 'self' https://vercel.live wss://ws-us3.pusher.com; frame-src https://vercel.live; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; report-uri /csp-report"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/console/:path(.*)?",
          "destination": "/:path"
        },
        {
          "source": "/((?!assets/).*)",
          "destination": "/index.html"
        }
      ]
    },
    "docs": {
      "root": "apps/docs",
      "framework": "nextjs",
      "installCommand": "pnpm -w run install:cloud",
      "buildCommand": "turbo run build --filter=@zitadel/docs"
    },
    "website": {
      "root": "apps/website",
      "framework": "nextjs",
      "installCommand": "pnpm -w run install:cloud",
      "buildCommand": "turbo run build --filter=@zitadel/website"
    },
    "cloud-functions": {
      "root": "apps/cloud-functions",
      "framework": "nextjs",
      "installCommand": "pnpm -w run install:cloud",
      "buildCommand": "turbo run build --filter=@zitadel/cloud-functions"
    },
    "go-import": {
      "root": "apps/cloud/go-import",
      "installCommand": "true",
      "buildCommand": "true",
      "devCommand": "node serve.mjs",
      "outputDirectory": "public",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/(.*)",
          "headers": [
            {
              "key": "Content-Type",
              "value": "text/html; charset=utf-8"
            },
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600, stale-while-revalidate=86400"
            }
          ]
        }
      ]
    },
    "schemas": {
      "root": "apps/cloud",
      "installCommand": "pnpm -w run install:cloud",
      "buildCommand": "turbo run schemas --filter=@zitadel/cloud",
      "devCommand": "node ../../scripts/render-builtin-schemas.mjs --serve",
      "outputDirectory": "dist/cloud-schemas",
      "headers": [
        {
          "source": "/schemas/v1/(.*)",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/schema+json"
            },
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600, stale-while-revalidate=86400"
            },
            {
              "key": "Access-Control-Allow-Origin",
              "value": "*"
            },
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'none'; frame-ancestors 'none'"
            }
          ]
        }
      ]
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/console",
      "destination": "/console/",
      "permanent": true
    },
    {
      "source": "/ui/console",
      "destination": "/console/",
      "permanent": false
    },
    {
      "source": "/ui/console/:path(.*)",
      "destination": "/console/:path",
      "permanent": false
    },
    {
      "source": "/changelog/",
      "destination": "/changelog",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "go.zitadel.com"
        }
      ],
      "destination": {
        "service": "go-import"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/console/runtime.json",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/console/(.*)",
      "destination": {
        "service": "console"
      }
    },
    {
      "source": "/schemas/v1/(.*)",
      "destination": {
        "service": "schemas"
      }
    },
    {
      "source": "/telemetry/mixpanel/:path(.*)",
      "destination": "https://api-eu.mixpanel.com/:path"
    },
    {
      "source": "/docs",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/docs/(.*)",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/cloud/(.*)",
      "destination": {
        "service": "cloud-functions"
      }
    },
    {
      "source": "/livez",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/readyz",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/csp-report",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/cron/events-retention",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/idp/:slug/callback",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/__nextgen/idp/:slug/callback",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/:resource(auth_attempts|branding|deployments|events|flow|flow_definitions|grants|idps|policies|projects|releases|schemas|sessions|teams|users|variables)/:path(.*)?",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "website"
      }
    }
  ],
  "crons": [
    {
      "path": "/cron/events-retention",
      "schedule": "17 * * * *"
    }
  ],
  "regions": ["iad1", "sfo1", "fra1", "sin1", "hnd1"],
  "git": {
    "deploymentEnabled": {
      "changeset-release/*": false,
      "gh-readonly-queue/**": false
    }
  }
}
