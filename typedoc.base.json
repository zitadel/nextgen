{
  "$schema": "https://typedoc.org/schema.json",
  "excludeInternal": true,
  "excludePrivate": true,
  "excludeExternals": true,
  "githubPages": false,
  "hideGenerator": true,
  "treatWarningsAsErrors": true,
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": true
  },
  "requiredToBeDocumented": [
    "Class",
    "Function",
    "Interface",
    "TypeAlias",
    "Variable",
    "Property",
    "Method",
    "Accessor",
    "Constructor",
    "Enum",
    "EnumMember"
  ],
  "disableSources": true
}
