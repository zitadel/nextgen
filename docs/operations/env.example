# Copy to .env next to docker-compose.yaml (see docs/quick-start/index.md).

NEXTGEN_IMAGE=ghcr.io/zitadel/nextgen:latest
NEXTGEN_PORT=8080

# 32-byte key, hex-encoded (64 characters). Dev-only value — do not reuse in production.
NEXTGEN_SERVER_COOKIE_SEALER_KEY=4d61737465726b65794e65656473546f48617665333243686172616374657273
