# Copy to .env next to docker-compose.yaml (see docs/quick-start/index.md).
# On main CI, quickstart-smoke overrides NEXTGEN_IMAGE with the Goreleaser snapshot tag.

NEXTGEN_IMAGE=ghcr.io/zitadel/nextgen:latest
NEXTGEN_PORT=8080

# Optional: enable claiming projects on this deployment (provisions the
# platform project's keys, default schema, and login flow at startup).
# See docs/quick-start/configuration.md#platform.
# NEXTGEN_PLATFORM_BOOTSTRAP_PROJECT=true
# NEXTGEN_SERVER_PUBLIC_BASE=http://localhost:8080
