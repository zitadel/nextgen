{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@zitadel/sdk-core": ["./packages/sdk-core/src/index.ts"],
      "@zitadel/sdk-next": ["./packages/sdk-next/src/index.tsx"],
      "@zitadel/sdk-next/server": ["./packages/sdk-next/src/server.ts"],
      "@zitadel/sdk-next/client": ["./packages/sdk-next/src/client.ts"],
      "@nextgen/ui-lit": ["./packages/ui-lit/src/index.ts"],
      "@nextgen/sdk-nuxt": ["./packages/sdk-nuxt/src/index.ts"],
      "@nextgen/sdk-nuxt/server": ["./packages/sdk-nuxt/src/server.ts"]
    },
    "forceConsistentCasingInFileNames": true
  }
}
