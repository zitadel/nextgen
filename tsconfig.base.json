{
  "compilerOptions": {
    "importHelpers": true,
    "isolatedModules": true,
    "lib": [
      "ES2022"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": [
      "@zitadel/source"
    ],
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true
  }
}
