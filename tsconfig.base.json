{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@zitadel/sdk-core": ["./packages/sdk-core/src/index.ts"],
      "@zitadel/sdk-next": ["./packages/sdk-next/src/index.tsx"]
    },
    "forceConsistentCasingInFileNames": true
  }
}
