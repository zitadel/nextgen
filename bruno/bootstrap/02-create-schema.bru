meta {
  name: 02 - Create User Schema
  type: http
  seq: 2
}

post {
  url: {{base_url}}/schemas?project_id={{project_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{project_secret}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "{{schema_id}}",
    "title": "DemoCombinedUser",
    "metaSchema": "https://nextgen.com/api/schemas/user-schema.json",
    "kind": "user-schema",
    "type": "object",
    "description": "Demo user schema supporting password registration and passkey-only registration.",
    "x-auth-methods": {
      "password": {
        "enabled": true,
        "position": 1
      },
      "passkey": {
        "enabled": true,
        "position": 2
      }
    },
    "required": ["email"],
    "properties": {
      "email": {
        "type": "string",
        "format": "email",
        "description": "The user's email address.",
        "x-unique": "project"
      },
      "password": {
        "type": "string",
        "minLength": 6,
        "description": "The user's password.",
        "x-password": true
      }
    }
  }
}

docs {
  Creates the user schema that both registration paths share.

  `required` contains only `email` — password is intentionally optional.
  This allows the passkey-only registration path (collect-passkey-email step)
  to create a user with just an email address and no password hash.

  The schema is stored under the URL in `schema_id`. The flow definition
  created in the next request references that same URL.
}
