{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flow-definition.schema.json",
  "title": "Flow Definition",
  "version": "1.0.0",
  "description": "Server-side configuration that describes a complete authentication or identity flow. The flow engine evaluates it and produces step payloads for the frontend.",
  "type": "object",
  "required": ["slug", "name", "purposes", "initial_steps", "steps"],
  "additionalProperties": false,
  "properties": {
    "slug": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Stable identifier for this flow. Used in pivot/switch transitions to reference other flows. Must be unique within the project. Renaming the flow does not change the slug.",
      "examples": ["default-login", "saas-registration", "password-recovery"]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable display name for this flow definition.",
      "examples": ["Default Login", "Acme Corp SSO Login"]
    },
    "purposes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["login", "register", "recovery", "profiling", "reauth", "link_account"]
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Which flow purposes this definition handles."
    },
    "initial_steps": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "description": "Maps each purpose to the step name that starts the flow. Keys must be a subset of purposes."
    },
    "audience": {
      "$ref": "#/$defs/audience"
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      },
      "minItems": 1,
      "description": "Steps in this flow. Order is for readability — sequencing is determined by transitions."
    }
  },
  "$defs": {
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "description": "Scopes which teams or apps this flow applies to. Empty = project-wide default. Resolution order: app > team > project.",
      "properties": {
        "team_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Restrict to specific teams."
        },
        "app_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Restrict to specific applications."
        }
      }
    },
    "step": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Unique step identifier within this flow. Used as transition targets."
        },
        "type": {
          "type": "string",
          "enum": [
            "identifier", "credential", "form", "verification",
            "consent", "info", "redirect", "captcha", "complete",
            "policy_check", "action"
          ],
          "description": "Step type. Rendered types are sent to the frontend. Server-only types (policy_check, action) auto-transition and never reach the client."
        },
        "texts": {
          "$ref": "#/$defs/texts"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/field"
          },
          "description": "Input fields keyed by field name."
        },
        "actions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/action"
          },
          "description": "User actions keyed by action name. The key is sent back in the submit request."
        },
        "gates": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/gate"
          },
          "description": "Security gates that must be satisfied before submission."
        },
        "sso_providers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sso_provider"
          },
          "description": "Available SSO identity providers for this step."
        },
        "behavior": {
          "type": "string",
          "enum": ["redirect", "show"],
          "description": "Only for complete steps. redirect = navigate to redirect_uri; show = render success screen."
        },
        "config": {
          "$ref": "#/$defs/step_config"
        },
        "transitions": {
          "$ref": "#/$defs/transitions"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "complete" } }
          },
          "then": {
            "required": ["behavior"]
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "policy_check" } }
          },
          "then": {
            "required": ["config", "transitions"],
            "properties": {
              "config": {
                "type": "object",
                "required": ["check"]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "action" } }
          },
          "then": {
            "required": ["config", "transitions"],
            "properties": {
              "config": {
                "type": "object",
                "required": ["action"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": ["identifier", "credential", "form", "verification", "consent", "info", "captcha"]
              }
            }
          },
          "then": {
            "required": ["texts", "transitions"]
          }
        }
      ]
    },
    "texts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title_key"],
      "properties": {
        "title_key": {
          "type": "string",
          "minLength": 1,
          "description": "i18n key for the step title."
        },
        "description_key": {
          "type": "string",
          "minLength": 1,
          "description": "i18n key for the step description."
        }
      }
    },
    "field": {
      "type": "object",
      "required": ["type", "text_key"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["text", "email", "password", "tel", "number", "url", "date", "hidden"]
        },
        "text_key": {
          "type": "string",
          "minLength": 1,
          "description": "i18n key for the field label."
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "value": {
          "type": "string",
          "description": "Pre-filled value (e.g. email carried over from a pivot)."
        },
        "validation": {
          "$ref": "#/$defs/field_validation"
        }
      }
    },
    "field_validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "string",
          "description": "Named format (e.g. email, uri)."
        },
        "pattern": {
          "type": "string",
          "description": "Regex pattern the value must match."
        },
        "min_length": {
          "type": "integer",
          "minimum": 0
        },
        "max_length": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "action": {
      "type": "object",
      "required": ["text_key"],
      "additionalProperties": false,
      "properties": {
        "text_key": {
          "type": "string",
          "minLength": 1,
          "description": "i18n key for the action label."
        },
        "primary": {
          "type": "boolean",
          "default": false,
          "description": "Whether this is the primary/default action."
        }
      }
    },
    "gate": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["captcha", "passkey"]
        },
        "provider": {
          "type": "string",
          "description": "Provider identifier (e.g. altcha, turnstile)."
        },
        "required": {
          "type": "boolean",
          "default": true
        },
        "satisfied": {
          "type": "boolean",
          "default": false,
          "description": "Whether this gate has already been satisfied."
        },
        "config": {
          "type": "object",
          "additionalProperties": true,
          "description": "Provider-specific challenge parameters."
        }
      }
    },
    "sso_provider": {
      "type": "object",
      "required": ["id", "name", "template"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Provider instance ID."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Display name."
        },
        "template": {
          "type": "string",
          "minLength": 1,
          "description": "Icon/brand template key (e.g. google, github, okta)."
        }
      }
    },
    "step_config": {
      "type": "object",
      "additionalProperties": false,
      "description": "Server-only config for policy_check and action steps. Never sent to frontend.",
      "properties": {
        "check": {
          "type": "string",
          "minLength": 1,
          "description": "Policy check identifier. Used by policy_check steps."
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "description": "Mutation identifier. Used by action steps."
        }
      }
    },
    "transitions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/transition_target"
      },
      "description": "Maps action/outcome names to the next step. Keys match action names, SSO events, or policy outcomes. Use \"_default\" as a catch-all for unmatched outcomes."
    },
    "transition_target": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Next step name within this flow."
        },
        {
          "type": "object",
          "required": ["pivot"],
          "additionalProperties": false,
          "properties": {
            "pivot": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9-]*$",
              "description": "Slug of the flow to push onto the stack. Current flow resumes after the pivoted flow completes."
            }
          }
        },
        {
          "type": "object",
          "required": ["switch"],
          "additionalProperties": false,
          "properties": {
            "switch": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9-]*$",
              "description": "Slug of the flow to replace the current flow. No return."
            }
          }
        }
      ]
    }
  }
}
