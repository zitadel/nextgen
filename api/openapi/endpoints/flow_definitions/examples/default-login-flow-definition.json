{
  "project_id": "${PROJECT_ID}",
  "schema_uri": "https://nextgen.com/flow-definition.json",
  "flow_definition": {
    "name": "default-login",
    "user_schema": "${USER_SCHEMA_URL}",
    "purposes": {
      "login": "identifier",
      "register": "register"
    },
    "steps": [
      {
        "name": "identifier",
        "fields": [
          "email"
        ],
        "actions": {
          "submit": {
            "primary": true,
            "text_key": "identifier.action.continue"
          }
        },
        "transitions": {
          "submit": {
            "target": "password"
          },
          "user_not_found": {
            "target": "register"
          }
        }
      },
      {
        "name": "password",
        "fields": [
          "password"
        ],
        "actions": {
          "submit": {
            "primary": true,
            "text_key": "password.action.signin"
          }
        },
        "transitions": {
          "submit": {
            "target": "done"
          }
        }
      },
      {
        "name": "register",
        "fields": [
          "email",
          "password"
        ],
        "actions": {
          "submit": {
            "primary": true,
            "text_key": "register.action.submit"
          }
        },
        "on_success": "create_user",
        "transitions": {
          "submit": {
            "target": "done"
          },
          "user_already_exists": {
            "target": "password"
          }
        }
      },
      {
        "name": "done",
        "complete": "show"
      }
    ]
  }
}
