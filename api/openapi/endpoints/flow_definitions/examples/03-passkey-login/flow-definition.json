{
  "project_id": "${PROJECT_ID}",
  "schema_uri": "https://nextgen.com/flow-definition.json",
  "flow_definition": {
    "name": "passkey-login",
    "user_schema": "${USER_SCHEMA_URL}",
    "purposes": {
      "login": "signin"
    },
    "steps": [
      {
        "name": "signin",
        "actions": {
          "passkey": {
            "primary": true,
            "text_key": "signin.action.passkey"
          }
        },
        "transitions": {
          "passkey": { "target": "done" }
        }
      },
      {
        "name": "done",
        "complete": "show"
      }
    ]
  }
}
