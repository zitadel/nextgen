{
  "project_id": "${PROJECT_ID}",
  "schema_uri": "https://nextgen.com/flow-definition.json",
  "flow_definition": {
    "name": "combined-password-passkey",
    "user_schema": "${USER_SCHEMA_URL}",
    "purposes": {
      "login": "identifier",
      "register": "register"
    },
    "steps": [
      {
        "name": "identifier",
        "fields": ["email"],
        "actions": {
          "submit": { "primary": true },
          "passkey": {}
        },
        "transitions": {
          "submit": { "target": "password" },
          "passkey": { "target": "done" },
          "user_not_found": { "target": "register" }
        }
      },
      {
        "name": "password",
        "fields": ["password"],
        "actions": {
          "submit": { "primary": true },
          "passkey": {}
        },
        "transitions": {
          "submit": { "target": "done" },
          "passkey": { "target": "done" }
        }
      },
      {
        "name": "register",
        "fields": ["email"],
        "actions": {
          "submit": { "primary": true },
          "passkey_register": {}
        },
        "transitions": {
          "submit": { "target": "register-password" },
          "passkey_register": { "target": "done" },
          "user_already_exists": { "target": "password" }
        }
      },
      {
        "name": "register-password",
        "fields": ["password"],
        "actions": {
          "submit": { "primary": true }
        },
        "on_success": "create_user",
        "transitions": {
          "submit": { "target": "passkey-upsell" }
        }
      },
      {
        "name": "passkey-upsell",
        "actions": {
          "passkey_register": { "primary": true },
          "skip": {}
        },
        "transitions": {
          "passkey_register": { "target": "done" },
          "skip": { "target": "done" }
        }
      },
      {
        "name": "done",
        "complete": "redirect"
      }
    ]
  }
}
