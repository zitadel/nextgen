{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UserProperty",
  "type": "object",
  "required": [
    "type",
    "title"
  ],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "string",
        "number",
        "boolean",
        "object",
        "array"
      ]
    },
    "format": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "email",
            "date-time",
            "uuid",
            "uri"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "type": "string",
      "description": "The title of the user property"
    },
    "minLength": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "description": "The minimum length of the property value, if applicable"
    },
    "maxLength": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "description": "The maximum length of the property value, if applicable"
    },
    "x-identifier": {
      "type": "boolean",
      "default": false,
      "description": "Whether this property is an identifier for the user or not"
    },
    "x-verify": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "The verification method for this property, if applicable"
    },
    "x-unique": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "instance",
            "organization"
          ]
        },
        {
          "type": "null"
        }
      ],
      "description": "The level of uniqueness for this property, if applicable"
    },
    "x-claim": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "The claim name for this property, if applicable"
    },
    "x-editable": {
      "type": "boolean",
      "default": true,
      "description": "Whether this property is editable by the user or not"
    },
    "x-sensitive": {
      "type": "boolean",
      "default": false,
      "description": "Whether this property contains sensitive information or not"
    },
    "x-mfa": {
      "type": "boolean",
      "default": false,
      "description": "Whether this property is used for multi-factor authentication or not"
    },
    "properties": {
      "type": "object",
      "description": "A map of additional properties for the user definition, where the key is the property name and the value is the property schema",
      "additionalProperties": {
        "$ref": "nested-user-property.json"
      }
    },
    "example": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "object"
        },
        {
          "type": "array",
          "items": {}
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
