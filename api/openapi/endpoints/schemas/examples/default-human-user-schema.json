{
  "title": "ExampleUserSchema",
  "metaSchema": "${SERVER_URL}/user-schema.json",
  "$id": "${SERVER_URL}/user.json",
  "kind": "user-schema",
  "type": "object",
  "description": "This is an example of a user schema definition.",
  "x-auth-methods": {
    "password": {
      "enabled": false,
      "position": 1
    }
  },
  "required": [
    "email"
  ],
  "properties": {
    "email": {
      "type": "string",
      "format": "email",
      "description": "The user's email address.",
      "x-unique": "team"
    },
    "password": {
      "type": "string",
      "minLength": 8,
      "description": "The user's password.",
      "x-password": true
    },
    "name": {
      "type": "string",
      "maxLength": 50,
      "description": "The user's name."
    },
    "phoneNumber": {
      "type": "string",
      "description": "The user's phone number."
    }
  }
}