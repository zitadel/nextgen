{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/**/*.spec.tsx",
      "!{projectRoot}/**/*.test.ts",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/vitest.config.ts"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/tsconfig.json"
    ]
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "compiler": "tsgo"
      }
    },
    {
      "plugin": "@nx/vite/plugin",
      "options": {
        "typecheckTargetName": "typecheck-vite"
      }
    },
    {
      "plugin": "@nx/playwright/plugin"
    },
    {
      "plugin": "@nx/vitest"
    },
    {
      "plugin": "@zitadel/lint"
    }
  ],
  "targetDefaults": {
    "test": {
      "dependsOn": ["^build", "^typecheck"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"],
      "outputs": [
        "{projectRoot}/dist/**/*.d.ts",
        "{projectRoot}/dist/**/*.d.ts.map",
        "{projectRoot}/dist/**/*.d.mts",
        "{projectRoot}/dist/**/*.d.mts.map",
        "{projectRoot}/dist/tsconfig.*.tsbuildinfo",
        "{projectRoot}/out-tsc/vitest/**/*.d.ts",
        "{projectRoot}/out-tsc/vitest/**/*.d.ts.map",
        "{projectRoot}/out-tsc/vitest/tsconfig.*.tsbuildinfo"
      ]
    },
    "typecheck-vite": {
      "options": {
        "command": "echo 'use nx target typecheck instead' >&2 && exit 1"
      }
    },
    "build": {
      "dependsOn": ["^build", "^typecheck"],
      "outputs": [
        "{projectRoot}/dist/**/*.html",
        "{projectRoot}/dist/**/*.css",
        "{projectRoot}/dist/**/*.mjs",
        "{projectRoot}/dist/**/*.js"
      ]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "e2e": {
      "dependsOn": ["^build"]
    }
  },
  "analytics": false
}
