# syntax=docker/dockerfile:1.7
#
# The server container of the hosted preview cloud, built by Vercel from the
# repository (service `server` in vercel.json next to this file). It lives at
# the repo root because buildah's build context is this file's directory and
# the Go module is here. Main is production: the binary is compiled from the
# deployed commit, no registry in between. Version tags for self-hosters are
# built separately by release-publish.yml from the plain Dockerfile.
#
# The console and the login UI are not embedded here: they are their own
# Vercel services (apps/console, apps/login-ui) routed at /ui/console and
# /ui/login, so the Go build only sees the embed placeholders and stays a
# pure Go compile.

FROM golang:1.26-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# The UIs are services, not embedded. The server still validates at boot
# that each enabled UI has an index.html in its embed (ValidateDist) and
# mounts /console/runtime.json only while a UI is enabled, so each UI dist
# gets a stub index.html. The stubs are unreachable: Vercel routes /console
# and /login to the UI services before the container sees them. Follow-up:
# let the server serve the runtime endpoint with both embedded UIs disabled.
RUN mkdir -p internal/staticui/console/dist internal/staticui/login/dist \
  && for ui in console login; do \
       printf '<!doctype html><title>%s is served by its own service</title>\n' "$ui" \
         > "internal/staticui/$ui/dist/index.html"; \
     done
# Build metadata: the server version from its package manifest, the commit
# from apps/cloud/commit.txt when the deploy workflow wrote it (CLI deploys
# have no git context, Vercel build env does not reach Docker ARGs).
RUN set -eu; \
    version="$(sed -n 's/^  "version": *"\([^"]*\)".*/\1/p' apps/server/package.json | head -1)"; \
    commit="$(cat apps/cloud/commit.txt 2>/dev/null || echo local)"; \
    date="$(date -u +%Y-%m-%dT%H:%M:%SZ)"; \
    CGO_ENABLED=0 go build -trimpath \
      -ldflags "-s -w \
        -X github.com/zitadel/nextgen/internal/build.version=${version}+cloud \
        -X github.com/zitadel/nextgen/internal/build.commit=${commit} \
        -X github.com/zitadel/nextgen/internal/build.date=${date}" \
      -o /out/nextgen .

# Runtime: same base and non-root user as the release image (root Dockerfile).
FROM debian:12-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates libicu72 libssl3 \
  && rm -rf /var/lib/apt/lists/* \
  && groupadd --system --gid 65532 nonroot \
  && useradd --system --uid 65532 --gid 65532 --home-dir /nonexistent --shell /usr/sbin/nologin nonroot
COPY --from=build /out/nextgen /usr/local/bin/nextgen

# The function filesystem is read-only except /tmp, and the data dir only
# needs to hold the rendered config: the master key is injected, so nothing
# durable is ever written here.
ENV NEXTGEN_SERVER_DATA_DIR=/tmp/nextgen-data

# The entrypoint renders the master key into a YAML config (the only way the
# server loads master keys) and refuses --migrate: migrations run in
# cloud-deploy.yml before the deploy, never in a serving container.
COPY --chmod=755 apps/cloud/entrypoint.sh /usr/local/bin/preview-entrypoint
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/preview-entrypoint"]
CMD []
