# syntax=docker/dockerfile:1.7
#
# The server container of the hosted preview cloud, built by Vercel from the
# repository (service `server` in vercel.json next to this file; the file
# lives at the repo root because the build context is its directory and the
# Go module is here). Main is production: the binary is compiled from the
# deployed commit, no registry in between. Version tags for self-hosters are
# built separately by release-publish.yml from the plain Dockerfile.
#
# The image holds one static binary, apps/cloud/launcher, which renders the
# master key config, follows PORT and runs the server in process. It never
# migrates: the `migrate` service in vercel.json runs the migrations in its
# build step before the deployment goes live (apps/cloud/vercel-build.sh).
#
# Why a container and not Vercel's Go runtime: the Go runtime (Beta) is not
# on Fluid compute and serves one request per instance; on 2026-10-08 it
# failed 10 of 24 concurrent requests outright. A container instance serves
# concurrent requests, which Vercel reports per instance. See
# docs/design/platform/preview-cloud-vercel-planetscale.md.

FROM golang:1.26-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# Vercel's build environment does not reach Docker ARGs, so the commit is
# usually "unknown" in the container; the migrate service's binary carries
# the real one in the build log.
ARG VERCEL_GIT_COMMIT_SHA=
RUN VERCEL_GIT_COMMIT_SHA="$VERCEL_GIT_COMMIT_SHA" OUT=/out/nextgen-launcher sh apps/cloud/build.sh

# Runtime: same base and non-root user as the release image (root Dockerfile).
FROM debian:12-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && groupadd --system --gid 65532 nonroot \
  && useradd --system --uid 65532 --gid 65532 --home-dir /nonexistent --shell /usr/sbin/nologin nonroot
COPY --from=build /out/nextgen-launcher /usr/local/bin/nextgen-launcher

# The function filesystem is read-only except /tmp, and the data dir only
# holds the rendered config: the master key is injected, nothing durable is
# written here. The launcher listens on PORT (project setting, 8080).
ENV NEXTGEN_SERVER_DATA_DIR=/tmp/nextgen-data
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/nextgen-launcher"]
CMD []
