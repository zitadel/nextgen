# shellcheck shell=bash disable=SC2034
# The SQLite lane: the server on SQLite in a data directory on a local volume.
# No database process, so no database cgroup. These four keys are everything
# the lanes may differ in; the test suite rejects any other.
BENCH_LANE=sqlite
BENCH_DB_DIALECT=sqlite
BENCH_DB_ROLE=0
# Exactly one server process. SQLite with a second server is not a degraded
# benchmark: each gets its own database, load splits across datasets that
# diverge, and no request fails. bench-lane refuses any other value here, runs
# the server under an exclusive lock on its data directory, and counts server
# processes at the start and end of every window.
BENCH_SERVER_REPLICAS=1
