# shellcheck shell=bash
# What both lanes share: the hardware budget, the server configuration and the
# collector (ADR 069). Sourced by bench-lane and bench-partition. Every default
# can be overridden from the environment, but the workflow sets one value for
# both lanes, and each run records what it actually used, so two runs that
# disagree are visible in `bench-lane compare` rather than in the numbers.
#
# Sized for depot-ubuntu-24.04-32 (an m8i.8xlarge: 16 cores of 2 threads, 128
# GiB): 14 of the 16 cores are given out and 2 are left to the runner. The pull
# request proof runs on the 16 vCPU size (8 cores) and overrides the core
# counts. Set any of them through the workflow's environment; the run metadata
# records what was used.
#
# CPU is counted in whole physical cores, never in threads: both SMT siblings
# of a core always belong to one role. Memory is in MiB.

# Cores per role. `system` is the runner agent, the step shells and the
# lane tooling; it is carved out so none of them runs on a measured core.
# Roles that do not run in a lane (the database in the SQLite lane, the
# collector until #1106 lands) keep their cores reserved and idle, so the
# server and the load generator get the same cores in every lane.
: "${BENCH_CORES_SYSTEM:=2}"
: "${BENCH_CORES_SERVER:=4}"
: "${BENCH_CORES_DB:=3}"
: "${BENCH_CORES_COLLECTOR:=1}"
: "${BENCH_CORES_LOADGEN:=4}"

# The API server's memory.max is the argon2id budget: every in-flight password
# verification holds password_hasher.hasher.memory (read from server.yaml, 64
# MiB by default), so login concurrency is bounded by
#   (memory.max - BENCH_SERVER_BASE_MIB) / argon2id memory.
# BENCH_LOGIN_CONCURRENCY is the highest number of simultaneous password
# verifications the lane is sized to serve; the base covers the Go heap, the
# caches and, in the SQLite lane, the page cache of the database file (file
# pages are charged to the cgroup that read them). Set BENCH_MEM_SERVER_MIB to
# override the whole figure.
: "${BENCH_SERVER_BASE_MIB:=1024}"
: "${BENCH_LOGIN_CONCURRENCY:=32}"
: "${BENCH_MEM_LOADGEN_MIB:=2048}"
: "${BENCH_MEM_DB_MIB:=4096}"
: "${BENCH_MEM_COLLECTOR_MIB:=512}"

# The server: one configuration for every lane. The database is the only thing
# that differs, and it is chosen by the environment the lane gives the
# process, never by this file.
: "${BENCH_SERVER_CONFIG:=$(bench_home)/server.yaml}"
: "${BENCH_SERVER_ADDR:=127.0.0.1:8080}"

# The collector (#1106). Not on main yet: until it is, the collector role is
# disabled and no collector runs in either lane. When enabled, both lanes run
# the same command with the same configuration file, and the file's checksum
# is recorded in the run metadata.
: "${BENCH_COLLECTOR_ENABLED:=0}"
: "${BENCH_COLLECTOR_CONFIG:=}"
: "${BENCH_COLLECTOR_CMD:=}"

# Where the lane's data lives. Ideally a local disk: a network-attached volume
# makes fsync the measurement. The disk kind is recorded and checked; kinds that
# are not a local disk (memory, overlay, network-block) are refused unless listed
# in BENCH_ALLOW_DISK_KINDS.
: "${BENCH_DATA_ROOT:=${BENCH_STATE_DIR}/data}"
# Filesystem kinds refused outright. tmpfs and overlay are refused too unless
# the operator says so, because neither says what the disk underneath is.
: "${BENCH_ALLOW_DISK_KINDS:=}"

# cpuset.cpus.partition for the role cgroups in delegated mode: none (disjoint
# cpusets, the default) or root (the kernel also removes the cores from every
# other cgroup; needs the delegated cgroup to be a partition root itself). In
# host mode the lane's own cgroup is always the partition root.
: "${BENCH_CPUSET_PARTITION:=none}"
