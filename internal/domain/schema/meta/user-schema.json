{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "{{ .SchemaURL }}",
  "kind": "user-schema",
  "title": "UserSchema",
  "type": "object",
  "required": ["$schema", "$id", "kind", "title", "x-auth-methods"],
  "properties": {
    "$schema": { "type": "string"},
    "$id":     { "type": "string", "format": "uri" },
    "kind":    { "type": "string", "const": "user-schema" },
    "title":   { "type": "string", "minLength": 1, "maxLength": 255 },
    "description": { "type": "string", "maxLength": 1024 },
    "x-auth-methods": {
      "type": "object",
      "properties": {
        "password":   { "$ref": "{{ .BaseURL }}/auth-method.json" },
        "passkey":    { "$ref": "{{ .BaseURL }}/auth-method.json" },
        "magic_link": { "$ref": "{{ .BaseURL }}/auth-method.json" },
        "sso":        { "$ref": "{{ .BaseURL }}/auth-method.json" },
        "otp":        { "$ref": "{{ .BaseURL }}/auth-method.json" }
      }
    },
    "required": {
      "type": "array",
      "items": { "type": "string" }
    },
    "properties": {
      "type": "object",
      "additionalProperties": { "$ref": "{{ .BaseURL }}/user-property.json" }
    }
  }
}