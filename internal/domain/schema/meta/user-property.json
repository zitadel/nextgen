{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "{{ .SchemaURL }}",
  "kind": "user-property",
  "title": "UserProperty",
  "type": "object",
  "required": ["type", "title"],
  "properties": {
    "type":    { "type": "string", "enum": ["string", "number", "boolean", "object", "array"] },
    "format":  { "oneOf": [{ "type": "string", "enum": ["email", "date-time", "uuid", "uri"] }, { "type": "null" }] },
    "title":   { "type": "string" },
    "minLength": { "oneOf": [{ "type": "integer" }, { "type": "null" }] },
    "maxLength": { "oneOf": [{ "type": "integer" }, { "type": "null" }] },
    "x-identifier": { "type": "boolean" },
    "x-verify":     { "oneOf": [{ "type": "string" }, { "type": "null" }] },
    "x-unique":     { "oneOf": [{ "type": "string", "enum": ["instance", "organization"] }, { "type": "null" }] },
    "x-claim":      { "oneOf": [{ "type": "string" }, { "type": "null" }] },
    "x-editable":   { "type": "boolean" },
    "x-sensitive":  { "type": "boolean" },
    "x-mfa":        { "type": "boolean" },
    "properties": {
      "type": "object",
      "additionalProperties": { "$ref": "{{ .BaseURL }}/nested-user-property.json" }
    }
  }
}