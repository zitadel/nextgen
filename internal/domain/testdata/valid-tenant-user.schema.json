{
  "slug": "tenant-user",
  "name": "Tenant User",
  "schema": {
    "type": "object",
    "title": "Tenant User",
    "description": "Standard interactive user for a SaaS tenant. Authenticates with email + password or passkey.",
    "required": ["email", "given_name", "family_name"],
    "x-auth-methods": {
      "password": { "enabled": true, "position": 1 },
      "passkey":  { "enabled": true, "position": 0 }
    },
    "properties": {
      "email": {
        "type": "string",
        "format": "email",
        "title": "Email address",
        "x-identifier": true,
        "x-verify": "email",
        "x-unique": "instance",
        "x-claim": "claims.email",
        "x-editable": true
      },
      "given_name": {
        "type": "string",
        "title": "First name",
        "minLength": 1,
        "maxLength": 100,
        "x-claim": "claims.given_name",
        "x-editable": true
      },
      "family_name": {
        "type": "string",
        "title": "Last name",
        "minLength": 1,
        "maxLength": 100,
        "x-claim": "claims.family_name",
        "x-editable": true
      },
      "address": {
        "type": "object",
        "title": "Address",
        "x-editable": true,
        "properties": {
          "street": { "type": "string", "title": "Street" },
          "city":   { "type": "string", "title": "City" },
          "zip":    { "type": "string", "title": "ZIP code", "pattern": "^[0-9]{4,10}$" }
        }
      }
    }
  }
}

