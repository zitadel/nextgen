<zl-page-shell data-zl-template-root>
  {% if branding.logo_url %}
    <img slot="header" class="zl-card-logo" src="{{ branding.logo_url }}" alt="" />
  {% endif %}
  <zl-card>
    <h1 slot="header" class="zl-card-title">{{ step.texts.title_key | t: identity.display_name }}</h1>
    {% if step.texts.description_key %}
      <p slot="header" class="zl-card-subtitle">{{ step.texts.description_key | t: identity.display_name }}</p>
    {% endif %}

    {% if errors and errors.size > 0 %}
      {% for err in errors %}
        {% if err | formLevelError %}
          {% assign alert_heading = err.text_key | alertHeading %}
          {% assign alert_body = err.text_key | alertBody %}
          <zl-alert severity="error"{% if alert_heading != "" %} heading="{{ alert_heading | t }}"{% endif %}>
            {% if alert_body != "" %}{{ alert_body | t }}{% elsif err.text_key %}{{ err.text_key | t }}{% else %}{{ err.message }}{% endif %}
          </zl-alert>
        {% endif %}
      {% endfor %}
    {% endif %}

    {% fields %}


    {% assign has_email = fields | where: "name", "email" | first %}
    {% assign has_password = fields | where: "name", "password" | first %}
    {% if has_email and has_password and step.name == 'identifier' %}
      <p class="zl-card-forgot">
        <a href="#" class="zl-card-forgot__link" data-action="recover">{{ 'action.forgot_password' | t }}</a>
      </p>
    {% endif %}

    {% for a in actions %}
      {% if a.primary %}
        <zl-button
          hierarchy="primary"
          size="medium"
          type="submit"
          block
          action="{{ a.name }}"
          label="{{ a.text_key | t }}"
          {% if loading %}loading{% endif %}
        ></zl-button>
      {% endif %}
    {% endfor %}

    {% for a in actions %}
      {% unless a.primary or a.name == 'passkey' or a.name == 'register' or a.name == 'sign_in' %}
        <zl-button
          hierarchy="secondary"
          size="medium"
          type="button"
          block
          action="{{ a.name }}"
          label="{{ a.text_key | t }}"
        ></zl-button>
      {% endunless %}
    {% endfor %}

    {% assign passkey = actions | where: "name", "passkey" | first %}
    {% if passkey %}
      <zl-button
        hierarchy="secondary"
        size="medium"
        block
        action="passkey"
        label="{{ passkey.text_key | t }}"
      ></zl-button>
    {% endif %}


    {% assign register = actions | where: "name", "register" | first %}
    {% if register %}
      <p class="zl-card-nav">
        {{ 'identifier.action.register.lead' | t }}<a href="#" class="zl-card-nav__link" data-action="register">{{ 'identifier.action.register.link' | t }}</a>
      </p>
    {% endif %}

    {% assign sign_in = actions | where: "name", "sign_in" | first %}
    {% if sign_in %}
      <p class="zl-card-nav">
        {{ 'register.action.sign_in.lead' | t }}<a href="#" class="zl-card-nav__link" data-action="sign_in">{{ 'register.action.sign_in.link' | t }}</a>
      </p>
    {% endif %}

    {% if challenge %}
      {% if challenge.method == "passkey" %}
        {% assign ceremony = "authenticate" %}
        {% assign submit_method = "passkey" %}
        {% if challenge.options.user %}
          {% assign ceremony = "register" %}
          {% assign submit_method = "passkey_register" %}
        {% endif %}
        <zl-passkey
          ceremony="{{ ceremony }}"
          method="{{ submit_method }}"
          challenge-id="{{ challenge.challenge_id }}"
          options='{{ challenge.options | json }}'
        ></zl-passkey>
      {% endif %}
    {% endif %}
  </zl-card>
</zl-page-shell>
