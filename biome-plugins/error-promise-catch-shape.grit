language js

// A value that falls back to a default uses one `.catch` that recognises the
// error by class and rethrows the rest (apps/cli/AGENTS.md, Errors). A
// `.then(ok, err)` pair, a chained `.catch` or a handler that swallows
// everything is the same catch written another way.
or {
  `$promise.then($ok, $err)` as $call where {
    register_diagnostic(span=$call, message="Do not catch with `.then(ok, err)`. Use one `.catch((error: unknown) => { if (error instanceof X) { return fallback; } throw error; })`.", severity="error")
  },
  `$promise.catch($first).catch($second)` as $call where {
    register_diagnostic(span=$call, message="Do not chain `.catch`. Use one `.catch` with a flat check per class.", severity="error")
  },
  `$promise.catch($handler)` as $call where {
    not $handler <: r"^\s*(?:async )?\(error: unknown\) => \{[\s\S]*\bthrow [^;]+;\s*\}\s*$",
    register_diagnostic(span=$call, message="A `.catch` takes `(error: unknown) => { if (error instanceof X) { return fallback; } throw error; }`.", severity="error")
  }
}
