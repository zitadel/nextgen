language js

// A delete is confirmed with `deleted: true` (see `deletedData()` in
// apps/cli/src/cli/core/envelope.ts), never `removed: true`, so an agent reads
// "did the delete succeed?" the same way for every command.
`removed: true` as $member where {
  register_diagnostic(span=$member, message="Confirm a delete with deletedData() from cli/core/envelope (`deleted: true`), not `removed: true`.", severity="error")
}
