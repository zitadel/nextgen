language js

// A command's next steps go on its result as `next` (apps/cli/src/lib/oclif/
// next-steps.ts), which the base command writes into the envelope and prints.
// A `next_commands:` or `next_actions:` key written by hand into data reaches
// the envelope without being printed, and its commands skip the
// SuggestedCommand check that keeps the run's --env/--env-file/--server (#1689).
or {
  `next_commands: $_`,
  `next_actions: $_`
} as $member where {
  $filename <: r".*/apps/cli/src/.*",
  $filename <: not r".*/lib/oclif/next-steps\.ts$",
  $filename <: not r".*/lib/oclif/base\.ts$",
  $filename <: not r".*/lib/oclif/types\.ts$",
  register_diagnostic(span=$member, message="Pass a command's next steps as the result's `next` (lib/oclif/next-steps), never as next_commands or next_actions in its data.", severity="error")
}
