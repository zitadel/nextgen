language js

// Every catch in the CLI reads the same (apps/cli/AGENTS.md, Errors): it names
// its error `error`, recognises what it handles with one flat
// `if (error instanceof X)` per class, and ends by rethrowing what it did not
// anticipate (or, at a boundary, by throwing one of our classes around it). A
// catch that swallows everything hides the bugs nobody anticipated.
or {
  JsCatchClause() as $catch where {
    not $catch <: r"^catch \(error\) \{[\s\S]*\bthrow [^;]+;\s*\}$",
    register_diagnostic(span=$catch, message="Catch as `catch (error) { if (error instanceof X) { ... } throw error; }`: name it `error` and end by rethrowing what it did not anticipate.", severity="error")
  },
  JsCatchClause() as $catch where {
    $catch <: r"^catch \(error\) \{[\s\S]*\breturn\b[\s\S]*",
    not $catch <: r"^catch \(error\) \{[\s\S]*\binstanceof\b[\s\S]*",
    register_diagnostic(span=$catch, message="A catch returns a fallback only for a class it names: `if (error instanceof X) { return fallback; }`.", severity="error")
  }
}
