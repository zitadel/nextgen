language js

// A bare `chmod(...).catch(() => undefined)` hides a failed permission change
// from the user and from the JSON envelope. The file may hold a credential, so
// a mode we could not apply is something to report. `Project.lockDown()`
// (apps/cli/src/lib/project/secret-file.ts) re-asserts the mode and warns once instead.
`chmod($path, $mode).catch($handler)` where {
  register_diagnostic(span=$handler, message="Do not swallow a chmod failure. Use Project.lockDown() from lib/project, which warns once instead of hiding it.", severity="error")
}
