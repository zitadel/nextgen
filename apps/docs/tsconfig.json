{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["dom", "DOM.Iterable", "ES2023"],
    "types": ["node", "vite/client", "react/experimental", "react-dom/experimental"],
    "allowJs": true,
    "checkJs": true,
    "rootDir": "."
  },
  "exclude": ["dist", "node_modules"],
  "include": [
    "press.config.tsx",
    "source.config.ts",
    "waku.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
