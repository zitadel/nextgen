{
  // The API reference's TypeScript samples, which scripts/sdk-samples.ts
  // writes: each compiles against @zitadel/api as a reader's code would.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    // A sample names what the call returns without using it.
    "noUnusedLocals": false
  },
  "include": [".generated/sdk-samples/*.ts"],
  "exclude": []
}
