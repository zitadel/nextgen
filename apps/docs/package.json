{
  "name": "@zitadel/docs",
  "version": "0.0.2",
  "engines": {
    "node": "24.x"
  },
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "generate": "node scripts/bundle-openapi.mjs && node scripts/bundle-cli.mjs",
    "dev": "next dev --port 3003",
    "build": "next build",
    "start": "next start --port 3003",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json && node scripts/sdk-samples.ts && tsc -p tsconfig.samples.json",
    "lint": "biome check .",
    "e2e": "playwright test",
    "e2e-deployment": "playwright test --config playwright.deployment.config.mts"
  },
  "dependencies": {
    "@fumadocs/json-schema": "catalog:",
    "@fumadocs/story": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "@vercel/analytics": "catalog:",
    "@vercel/speed-insights": "catalog:",
    "@zitadel/api": "workspace:*",
    "@zitadel/api-mock": "workspace:*",
    "@zitadel/components": "workspace:*",
    "@zitadel/design-tokens": "workspace:*",
    "fumadocs-core": "catalog:",
    "fumadocs-mdx": "catalog:",
    "fumadocs-openapi": "catalog:",
    "fumadocs-ui": "catalog:",
    "lucide-react": "catalog:",
    "msw": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "remark": "catalog:",
    "shiki": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@redocly/openapi-core": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/mdx": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@zitadel/cli": "workspace:*",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  }
}
