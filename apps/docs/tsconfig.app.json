{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The site config (press/source/waku) lives at the package root.
    "rootDir": ".",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // press.config.tsx imports the generated `.generated/openapi.mjs`; without
    // these it would be an untyped module instead of a checked document.
    "allowJs": true,
    "checkJs": true,
    // Waku renders with React Server Components, typed by the experimental
    // React builds.
    "types": ["node", "vite/client", "react/experimental", "react-dom/experimental"]
  },
  "include": [
    "press.config.tsx",
    "source.config.ts",
    "waku.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": ["dist", "node_modules"]
}
