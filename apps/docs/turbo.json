{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // Bundles api/openapi into .generated/, which lib/openapi.ts imports,
    // applying the repo's Redocly config.
    "generate": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/api/openapi/**/*.yaml", "$TURBO_ROOT$/redocly.yaml"],
      "outputs": [".generated/openapi.mjs", ".generated/openapi.d.mts"]
    },
    "typecheck": {
      "dependsOn": ["generate"]
    },
    // The build script bundles again before `next build`, because the
    // hosted cloud's docs service runs the script without a task runner.
    "build": {
      "dependsOn": ["generate"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["generate"]
    },
    "start": {
      "dependsOn": ["build"]
    },
    // The site's contract suite (tests/, playwright.config.mts); Playwright
    // serves the build on port 3003.
    "e2e": {
      "dependsOn": ["build"],
      "passThroughEnv": ["DOCS_*", "VERCEL_AUTOMATION_BYPASS_SECRET", "PLAYWRIGHT_*", "PWDEBUG", "DEBUG", "GITHUB_*"]
    },
    // The same suite against a deployment of the hosted cloud, which
    // DOCS_BASE_URL names (VERCEL_AUTOMATION_BYPASS_SECRET opens its
    // protection); .github/workflows/deployment-checks.yml runs it for every
    // deployment. The script refuses to run without DOCS_BASE_URL.
    "e2e-deployment": {
      "cache": false,
      "passThroughEnv": ["DOCS_*", "VERCEL_AUTOMATION_BYPASS_SECRET", "PLAYWRIGHT_*", "PWDEBUG", "DEBUG", "GITHUB_*"]
    }
  }
}
