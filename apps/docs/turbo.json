{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // Turns the committed OpenAPI embed and its error YAML into .generated/,
    // which lib/openapi.ts and lib/error-reference.ts import, plus the CLI's
    // command reference (its reference test) and release notes (Changesets).
    // Regenerate the embed (@zitadel/server#generate) before this when the OpenAPI
    // YAML changes.
    //
    // Turbo's Next.js inference hashes NEXT_PUBLIC_*, NEXT_DEPLOYMENT_ID and,
    // when VERCEL_SKEW_PROTECTION_ENABLED is set, VERCEL_DEPLOYMENT_ID into
    // every task of this package. The hosted cloud's project has Skew
    // Protection on, so every deployment brings a new ID (see build). Vercel's
    // NEXT_PUBLIC_VERCEL_* (its URL, its commit) change with it, and turbo
    // drops those only where Vercel names their prefix in
    // TURBO_CI_VENDOR_ENV_KEY. Neither task reads any of them, so both drop
    // them all and hit the cache across deployments.
    "generate": {
      "env": ["!NEXT_*", "!VERCEL_DEPLOYMENT_ID"],
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/apps/api/api/openapi/bundled/openapi.json",
        "$TURBO_ROOT$/apps/api/api/openapi/components/schemas/errors/**/*.yaml",
        "$TURBO_ROOT$/apps/api/api/openapi/endpoints/**/*-error-response.yaml",
        "$TURBO_ROOT$/apps/cli/command-reference.json",
        "$TURBO_ROOT$/apps/cli/CHANGELOG.md"
      ],
      "outputs": [
        ".generated/openapi.mjs",
        ".generated/openapi.d.mts",
        ".generated/errors.mjs",
        ".generated/errors.d.mts",
        ".generated/cli.mjs",
        ".generated/cli.d.mts"
      ]
    },
    // The API reference's TypeScript samples compile against the client
    // (scripts/sdk-samples.ts, tsconfig.samples.json), whose endpoints its
    // generate task writes from the same spec, and whose runtime they call.
    // The live examples (components/examples) import the components, the
    // mock and the client the mock calls, each from its dist/.
    "typecheck": {
      "env": ["!NEXT_*", "!VERCEL_DEPLOYMENT_ID"],
      "dependsOn": [
        "generate",
        "@zitadel/api#generate",
        "@zitadel/api#build",
        "@zitadel/api-mock#build",
        "@zitadel/components#build"
      ],
      "inputs": ["$TURBO_EXTENDS$", "$TURBO_ROOT$/packages/api/src/**", "!$TURBO_ROOT$/packages/api/src/generated/**", "!$TURBO_ROOT$/packages/vitest-config/**"]
    },
    // app/global.css imports the design tokens' CSS variables, which the
    // repository commits, so that build needs no generation of them.
    //
    // The build waits for typecheck: `next build` empties .next/types, where
    // tsc reads the route types, so side by side typecheck failed with
    // TS2304. A task-guard mutex would leave a gap: a cache hit restores
    // .next without running the script.
    //
    // The hosted cloud's docs service builds through this task. A Next.js
    // build on Vercel bakes its deployment in: Skew Protection's ID into
    // every asset URL (`?dpl=`, from NEXT_DEPLOYMENT_ID) and Vercel's URLs
    // into the metadata, which turbo passes through unhashed. Keyed by the
    // deployment's ID, a build is never restored into another deployment: on
    // Vercel it never hits, elsewhere the variable is unset. The Speed
    // Insights sample rate is read at build time (next.config.mjs,
    // app/layout.tsx), and strict mode would hide it.
    "build": {
      "env": ["NODE_ENV", "VERCEL_DEPLOYMENT_ID", "DOCS_SPEED_INSIGHTS_SAMPLE_RATE"],
      "inputs": ["$TURBO_EXTENDS$", ".env*"],
      "dependsOn": [
        "typecheck",
        "generate",
        "@zitadel/api#build",
        "@zitadel/api-mock#build",
        "@zitadel/components#build"
      ],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": [
        "generate",
        "@zitadel/api#build",
        "@zitadel/api-mock#build",
        "@zitadel/components#build"
      ]
    },
    "start": {
      "dependsOn": ["build"]
    },
    // The site's contract suite (tests/, playwright.config.mts); Playwright
    // serves the build on port 3003.
    "e2e": {
      "cache": false,
      "dependsOn": ["build"],
      "passThroughEnv": ["PLAYWRIGHT_*", "PWDEBUG", "DEBUG", "GITHUB_*"]
    },
    // The same suite against a deployment of the hosted cloud, which
    // CLOUD_URL names (playwright.deployment.config.mts;
    // VERCEL_AUTOMATION_BYPASS_SECRET opens its protection). The root's
    // `pnpm check:cloud` runs it beside every other deployment suite, and
    // .github/workflows/deployment-checks.yml runs it for every deployment.
    // The config refuses to run without CLOUD_URL.
    "e2e-deployment": {
      "cache": false,
      "passThroughEnv": ["CLOUD_URL", "VERCEL_AUTOMATION_BYPASS_SECRET", "PLAYWRIGHT_*", "PWDEBUG", "DEBUG", "GITHUB_*"]
    }
  }
}
