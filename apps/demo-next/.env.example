# URL of the Zitadel auth server
ZITADEL_URL=http://localhost:8080
NEXTGEN_ISSUER_URL=http://localhost:8080
NEXT_PUBLIC_ZITADEL_PROJECT_ID=changeme-project-id
# Server-side only: the project secret from POST /projects (used by the proxy for session exchange)
ZITADEL_PROJECT_SECRET=changeme-project-secret
