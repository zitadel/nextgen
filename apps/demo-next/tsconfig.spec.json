{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "next-env.d.ts",
    "*.config.mts",
    "*.config.ts",
    "scripts/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__tests__/**/*.ts",
    "src/**/__tests__/**/*.tsx",
    "src/test-setup.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ],
  "exclude": []
}
