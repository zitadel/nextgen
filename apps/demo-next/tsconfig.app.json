{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // Next.js compiles JSX itself (SWC); tsc only type-checks it.
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ],
    // SWC reads these to compile the Lit decorators of the transpiled
    // `@zitadel/components` (see next.config.ts `transpilePackages`).
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules"]
}
