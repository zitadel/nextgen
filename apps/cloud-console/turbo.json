{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  // The hosted cloud's add-on to the console. `lint` is the root's, and
  // nothing builds here: the cloud's console build compiles the add-on in.
  "tasks": {
    // The add-on implements the console's contract and composes the
    // components it exports, and calls the functions' contract, all read
    // from source. Turbo hashes another package's files only through a task
    // edge, and there is no task to depend on, so they are listed. The
    // console's own typecheck dependency is the add-on's too: the kit's
    // sign-in screen imports the built sdk-react.
    "typecheck": {
      "dependsOn": ["@zitadel/sdk-react#build"],
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/apps/console/src/**",
        "$TURBO_ROOT$/apps/cloud-functions/src/contract.ts"
      ]
    },
    // The tests run the functions' contract and read the platform flow's
    // steps (src/attribution.spec.ts), outside the package for the same reason.
    // The contract builds the sign-in widget's paths with @zitadel/api, which
    // the specs resolve to its dist/.
    "test": {
      "dependsOn": ["@zitadel/api#build"],
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/apps/cloud-functions/src/contract.ts",
        "$TURBO_ROOT$/packages/config/defaults/default-login.json"
      ]
    }
  }
}
