{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "typecheck": {
      "inputs": ["$TURBO_EXTENDS$", "!$TURBO_ROOT$/packages/vitest-config/**"],
      "dependsOn": ["@zitadel/sdk-nuxt#build"]
    },
    // Reads sdk-nuxt/dist while bundling; ordered after that build.
    "build": {
      "dependsOn": ["@zitadel/sdk-nuxt#build"],
      "outputs": [".output/**"]
    },
    "dev": {
      "dependsOn": ["@zitadel/sdk-nuxt#build"]
    },
    "start": {
      "dependsOn": ["build"]
    }
  }
}
