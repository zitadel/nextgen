{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // This package's server binary, into the bin/ the npm package ships:
    // the server module's release build for this package's platform
    // (`release.mjs binary`). It embeds the console's dist and stamps the
    // release version and commit, so it is never cached, as the server's own
    // build. The release graph packs it (tools/release/turbo.json).
    "build-binary": {
      "cache": false,
      "dependsOn": ["@zitadel/server#go-sources", "@zitadel/console#build"],
      "command": ["node", "../../scripts/release.mjs", "binary"],
      "env": ["GOFLAGS"]
    }
  }
}
