# syntax=docker/dockerfile:1.7
#
# Thin layer over the released server image. Vercel detects Dockerfile.vercel
# at the project root, builds it, pushes the image to Vercel Container
# Registry and routes all traffic of the deployment to it.
#
# NEXTGEN_VERSION is the one knob: bump it in a PR. The deploy workflow reads
# the same line and runs `nextgen migrate` from that tag before deploying.
ARG NEXTGEN_VERSION=main
FROM ghcr.io/zitadel/nextgen:${NEXTGEN_VERSION}

# The function filesystem is read-only except /tmp, and the data dir only
# needs to hold the rendered config: the master key is injected, so nothing
# durable is ever written here.
ENV NEXTGEN_SERVER_DATA_DIR=/tmp/nextgen-data

# The base image's ENTRYPOINT is the server binary and its CMD is
# `--migrate`. Both are replaced: the serving container must never migrate
# (CI migrates before each deploy), and the master key can only be loaded
# from a YAML file, which the entrypoint renders from the environment before
# exec'ing the server.
COPY --chmod=755 entrypoint.sh /usr/local/bin/preview-entrypoint
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/preview-entrypoint"]
CMD []
