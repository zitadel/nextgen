    "e2e-platform": "playwright test --config playwright.platform.config.mts"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@zitadel/testing": "workspace:*",
    "eslint-plugin-playwright": "catalog:",
    "typescript": "catalog:"
  }
}
