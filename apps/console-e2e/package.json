{
  "name": "@zitadel/console-e2e",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint .",
    "e2e": "playwright test",
