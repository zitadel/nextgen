{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "playwright*.config.mts",
    "scripts/**/*.mts",
    "src-embedded/**/*.ts",
    "src-platform/**/*.ts",
    "src-real/**/*.ts",
    "src/**/*.ts"
  ]
}
