{
  "project_id": "${PROJECT_ID}",
  "schema_uri": "https://zitadel.com/schemas/v1/flow-definition.json",
  "flow_definition": {
    "name": "passkey-login",
    "status": "active",
    "user_schema": "human-user",
    "purposes": {
      "login": "signin"
    },
    "steps": [
      {
        "name": "signin",
        "fields": ["email"],
        "actions": [
          {
            "name": "passkey",
            "kind": "passkey",
            "primary": true
          }
        ],
        "transitions": {
          "passkey": {
            "target": "done"
          }
        }
      },
      {
        "name": "done",
        "complete": "show"
      }
    ]
  }
}
