{
  "project_id": "proj_01KWH1P4MYS7F0N9WD3P2E4YM5",
  "schema_uri": "https://zitadel.com/schemas/v1/flow-definition.json",
  "flow_definition": {
    "name": "password-register",
    "user_schema": "human-user",
    "purposes": {
      "register": "signup"
    },
    "steps": [
      {
        "name": "signup",
        "fields": [
          "email",
          "x-auth-methods#password"
        ],
        "actions": [
          {
            "name": "submit",
            "kind": "submit",
            "primary": true
          }
        ],
        "on_success": "create_user",
