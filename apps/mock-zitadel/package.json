{
  "name": "@zitadel/mock-zitadel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Per-PR mock Zitadel API deployed to Vercel (wraps @zitadel/api-mock).",
  "homepage": "https://github.com/zitadel/nextgen/tree/main/apps/mock-zitadel#readme",
  "bugs": {
    "url": "https://github.com/zitadel/nextgen/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zitadel/nextgen.git",
    "directory": "apps/mock-zitadel"
  },
  "scripts": {
    "dev": "tsx scripts/local-server.ts",
    "build": "tsdown",
    "build:vercel": "cd ../../packages/api && node --run generate && node --run build && cd ../config && node --run sync-schemas && node --run build && cd ../../apps/mock-zitadel && tsdown && tsx scripts/generate-wellknown.ts",
    "test": "vitest run",
    "test:all": "vitest run",
    "test:watch": "vitest --watch",
    "typecheck": "cd ../../packages/api && node --run generate && cd ../../apps/mock-zitadel && tsc --noEmit"
  },
  "dependencies": {
    "@zitadel/api-mock": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "express": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
