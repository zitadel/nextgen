{
  "name": "@zitadel/server",
  "version": "0.1.0",
  "description": "Zitadel server binary launcher.",
  "homepage": "https://github.com/zitadel/nextgen#readme",
  "bugs": {
    "url": "https://github.com/zitadel/nextgen/issues"
  },
  "license": "AGPL-3.0-only",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zitadel/nextgen.git",
    "directory": "apps/server"
  },
  "bin": {
    "zitadel-server": "./bin/zitadel-server.js"
  },
  "exports": {
    "./binary": {
      "types": "./bin/binary.d.ts",
      "default": "./bin/binary.js"
    },
    "./bin/zitadel-server.js": "./bin/zitadel-server.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin"
  ],
  "scripts": {
    "openapi": "cd ../.. && node scripts/lint-openapi.mjs",
    "format": "cd ../.. && node scripts/go-format-check.mjs",
    "generate": "cd ../.. && node scripts/task-guard.mjs --mutex generated-sources -- node scripts/go-generate.mjs",
    "clean-generated": "cd ../.. && node scripts/task-guard.mjs --mutex generated-sources -- node scripts/clean-generated.mjs",
    "check-generate": "cd ../.. && node scripts/task-guard.mjs --mutex generated-sources -- node scripts/check-go-generate.mjs",
    "check-generate-pruned": "cd ../.. && node scripts/task-guard.mjs --mutex generated-sources -- node scripts/check-go-generate.mjs --prune",
    "vet": "cd ../api && go vet ./...",
    "lint": "cd ../.. && node scripts/go-lint.mjs",
    "test": "cd ../api && go test -v -timeout 10m ./...",
    "test-postgres": "cd ../api && go test -v -count=1 -tags postgres_integration -timeout 10m ./...",
    "test-spanner": "cd ../api && go test -v -count=1 -tags spanner_integration -timeout 30m ./internal/api/integration_test/ ./internal/storage/dialect/spanner/ ./internal/storage/stmttest/",
    "test-sqlite": "cd ../api && go test -v -count=1 -tags sqlite_integration -timeout 5m ./...",
    "build": "cd ../.. && node scripts/server-build.mjs",
    "prepack": "publint --strict"
  },
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "@zitadel/server-darwin-arm64": "workspace:*",
    "@zitadel/server-darwin-x64": "workspace:*",
    "@zitadel/server-linux-arm64": "workspace:*",
    "@zitadel/server-linux-x64": "workspace:*",
    "@zitadel/server-win32-x64": "workspace:*"
  }
}
