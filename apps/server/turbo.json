{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  // The tasks of the server's Go module (apps/api, the package `nextgen`).
  // Input-only tasks split its production and test sources: `go-sources`
  // reaches the production sources of the module and of every module it
  // requires through `nextgen#go-sources`. Builds and generation do not
  // consume _test.go or testdata; vet, lint, format and tests do.
  // Through `go-sources`, every task here is keyed on the Go toolchain and
  // target (`go version` and the effective `go env`), so the checks and the
  // service-free tests are cached. `build` is not: the binary stamps the Git
  // HEAD and branch. Nor are the database lanes or generation (below).
  "tasks": {
    "go-sources": {
      "dependsOn": ["nextgen#go-sources"],
      "env": ["GOFLAGS", "CGO_ENABLED", "GOOS", "GOARCH"]
    },
    // The drift tests also read the events catalog and the configuration
    // guide's metrics table, and the proof-of-work tests its vectors.
    "go-tests": {
      "inputs": [
        "$TURBO_ROOT$/apps/api/**/*_test.go",
        "$TURBO_ROOT$/apps/api/**/testdata/**",
        "$TURBO_ROOT$/docs/design/api/events-catalog.md",
        "$TURBO_ROOT$/docs/quick-start/configuration.md",
        "$TURBO_ROOT$/docs/design/flowengine/testdata/pow-v1-vectors.json",
        "!$TURBO_ROOT$/apps/api/**/node_modules/**",
        "!$TURBO_ROOT$/.claude/**",
        "!$TURBO_ROOT$/.codex/**",
        "!$TURBO_ROOT$/.cursor/**",
        "!$TURBO_ROOT$/.agents/**",
        "!$TURBO_ROOT$/.vercel/**",
        "!$TURBO_ROOT$/.opencode/**",
        "!$TURBO_ROOT$/.go/**",
        "!$TURBO_ROOT$/vendor/**",
        "!$TURBO_ROOT$/tmp/**",
        "!$TURBO_ROOT$/.tmp/**",
        "!$TURBO_ROOT$/dist/**",
        "$TURBO_ROOT$/docs/product-analytics-events.yaml",
        "$TURBO_ROOT$/vercel.json",
        "$TURBO_ROOT$/apps/cloud/build-launcher.sh",
        "$TURBO_ROOT$/apps/cloud/go-import/**",
        "$TURBO_ROOT$/apps/console/index.html",
        "$TURBO_ROOT$/packages/api/scripts/docs-links.ts",
        "$TURBO_ROOT$/apps/console/src/lib/docs.ts",
        "$TURBO_ROOT$/apps/cli/src/lib/orca/patchers/rule/guidance.ts"
      ]
    },
    "openapi": {
      "dependsOn": ["go-sources"],
      "env": ["GOFLAGS", "CGO_ENABLED", "GOOS", "GOARCH"],
      "inputs": ["$TURBO_ROOT$/scripts/lint-openapi.mjs", "$TURBO_ROOT$/redocly.yaml", "$TURBO_ROOT$/.redocly.lint-ignore.yaml"]
    },
    "format": {
      "dependsOn": ["go-sources", "go-tests"],
      "env": ["GOFLAGS", "CGO_ENABLED", "GOOS", "GOARCH"],
      "inputs": ["$TURBO_ROOT$/scripts/go-format-check.mjs", "$TURBO_ROOT$/scripts/dev-process.mjs"]
    },
    // Generated files are committed: every task reads them as source, and no
    // task depends on generation. scripts/go-generate.mjs runs every
    // directive in a copy of the working tree: `generate`, the tool a person
    // runs after changing what generation reads, then writes back only the
    // files that differ (not cached: it writes committed files), and
    // `check-generate`, in `lint`, fails when any differs. Neither writes a
    // file another task reads while it runs.
    "generate": {
      "cache": false,
      "dependsOn": ["go-sources"],
      "env": ["GOFLAGS", "CGO_ENABLED", "GOOS", "GOARCH"]
    },
    "check-generate": {
      "dependsOn": ["go-sources"],
      "env": ["GOFLAGS", "CGO_ENABLED", "GOOS", "GOARCH"],
      "inputs": [
        "$TURBO_ROOT$/scripts/go-generate.mjs",
        "$TURBO_ROOT$/scripts/generated-outputs.mjs",
        "$TURBO_ROOT$/scripts/generate-meta-schemas.ts",
        "$TURBO_ROOT$/scripts/map-all.mjs",
        "$TURBO_ROOT$/scripts/bundle-openapi.mjs",
        "$TURBO_ROOT$/scripts/server-build.mjs",
        "$TURBO_ROOT$/scripts/dev-process.mjs",
        "$TURBO_ROOT$/redocly.yaml"
      ]
    },
    // go vet compiles //go:embed all:dist, so the console build goes first (a
    // concurrent build can emptyOutDir the placeholder).
    "vet": {
      "dependsOn": ["go-sources", "go-tests", "@zitadel/console#build"],
      "env": ["GOFLAGS", "CGO_ENABLED", "GOOS", "GOARCH"]
    },
    // The custom go/analysis checks and the Biome lint of the JavaScript
    // launcher in bin/: scripts/go-lint.mjs. It also stands for the package's
    // other static checks (vet, format, openapi, check-generate,
    // check-pow-vectors), so `turbo run lint` runs them all.
    "lint": {
      "dependsOn": ["go-sources", "go-tests", "check-generate", "check-pow-vectors", "@zitadel/console#build", "vet", "format", "openapi"],
      "env": ["GOFLAGS", "CGO_ENABLED", "GOOS", "GOARCH"],
      "inputs": [
        "$TURBO_ROOT$/scripts/go-lint.mjs",
        "$TURBO_ROOT$/scripts/server-build.mjs",
        "$TURBO_ROOT$/scripts/dev-process.mjs",
        "$TURBO_ROOT$/biome.json",
        "$TURBO_ROOT$/biome-plugins/*.grit"
      ]
    },
    // The proof-of-work vectors and the component's solver fixture match what
    // their generator derives.
    "check-pow-vectors": {
      "inputs": [
        "$TURBO_ROOT$/docs/design/flowengine/testdata/generate-pow-v1-vectors.mjs",
        "$TURBO_ROOT$/docs/design/flowengine/testdata/pow-v1-vectors.json",
        "$TURBO_ROOT$/packages/components/src/orchestrator/__fixtures__/signup-pow-vector.json"
      ]
    },
    // The proof-of-work package needs no generated API, database or embedded
    // UI, so a focused race and fuzz run keeps its feedback loop short. The
    // root `ci` script names it, so CI runs it when these inputs change. A
    // race run is a probe, so it is never replayed.
    "test:pow": {
      "cache": false,
      "dependsOn": ["check-pow-vectors"],
      "env": ["GOFLAGS", "CGO_ENABLED", "GOOS", "GOARCH"],
      "inputs": [
        "$TURBO_ROOT$/apps/api/internal/crypto/pow/**",
        "$TURBO_ROOT$/docs/design/flowengine/testdata/**",
        "$TURBO_ROOT$/apps/api/go.mod",
        "$TURBO_ROOT$/apps/api/go.sum"
      ]
    },
    // The test binary embeds the console's dist. The checks (format, vet,
    // lint, openapi, check-generate, check-pow-vectors) read nothing test
    // writes and gate nothing: they run beside it. Go's result cache stays off
    // (-count=1 in the script): the drift tests read files outside the module,
    // which turbo's key holds (`go-tests`). A hit prints its hash, not the
    // replayed -v log.
    "test:unit": {
      "outputLogs": "new-only",
      "dependsOn": ["go-sources", "go-tests", "@zitadel/console#build"],
      "env": ["GOFLAGS", "CGO_ENABLED", "GOOS", "GOARCH"]
    },
    // The database lanes talk to a database whose state no hash sees, so
    // neither turbo's cache nor Go's (-count=1 in the scripts) may replay
    // them. They see the Docker and test-database variables. Their inputs
    // still matter: they decide when a change marks the lane affected, which
    // selects it in CI (`--affected`).
    "test:postgres": {
      "cache": false,
      "dependsOn": ["go-sources", "go-tests", "@zitadel/console#build"],
      "env": ["GOFLAGS", "CGO_ENABLED", "GOOS", "GOARCH"],
      "passThroughEnv": ["ZITADEL_TEST_*", "DOCKER_*", "TESTCONTAINERS_*"]
    },
    "test:spanner": {
      "cache": false,
      "dependsOn": ["go-sources", "go-tests", "@zitadel/console#build"],
      "env": ["GOFLAGS", "CGO_ENABLED", "GOOS", "GOARCH", "ZITADEL_TEST_SPANNER_INSTANCE"],
      "passThroughEnv": ["ZITADEL_TEST_*", "DOCKER_*", "TESTCONTAINERS_*", "GOOGLE_*", "CLOUDSDK_*", "SPANNER_EMULATOR_HOST"]
    },
    // The tests `turbo run test` runs: the unit tests and the SQLite lane,
    // which needs no Docker, side by side. Postgres and Spanner stay apart.
    "test": {
      "dependsOn": ["test:unit", "test:sqlite"]
    },
    "test:sqlite": {
      "outputLogs": "new-only",
      "dependsOn": ["go-sources", "go-tests", "@zitadel/console#build"],
      "env": ["GOFLAGS", "CGO_ENABLED", "GOOS", "GOARCH"],
      "passThroughEnv": ["ZITADEL_TEST_*"]
    },
    // The binary embeds the console's dist, which the console#build edge
    // hashes. Its files are not inputs: turbo hashes a run's inputs before
    // the run starts, so the build would hash them without that run's console
    // build and miss the cache on the next run.
    // The build's output, in the repository's dist/ beside the local
    // servers' data, which it keeps.
    "clean": {
      "command": ["git", "clean", "-fdX", "--", "../../dist/server/nextgen", "../../dist/server/metadata.json"]
    },
    "build": {
      "cache": false,
      "dependsOn": ["go-sources", "@zitadel/console#build"],
      "env": ["GOFLAGS", "CGO_ENABLED", "GOOS", "GOARCH"],
      "inputs": ["$TURBO_ROOT$/scripts/server-build.mjs", "$TURBO_ROOT$/scripts/dev-process.mjs"],
      "outputs": ["$TURBO_ROOT$/dist/server/nextgen", "$TURBO_ROOT$/dist/server/metadata.json"]
    }
  }
}
