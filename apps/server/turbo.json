{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  // Input-only tasks split the root Go module's production and test sources.
  // Nested modules own their own tasks. Builds and generation do not consume
  // _test.go or testdata; vet, lint, format and tests do.
  // Native Go commands use Go's own compiler/test caches, not runner results:
  // unset GOOS/GOARCH/CGO_ENABLED and the installed compiler are host defaults
  // neither runner hashes. The local binary also stamps the current Git HEAD.
  "tasks": {
    "go-sources": {
      "env": ["GOFLAGS", "CGO_ENABLED", "GOOS", "GOARCH"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/**/*.go",
        "$TURBO_ROOT$/**/*.sql",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/.claude/**",
        "!$TURBO_ROOT$/.codex/**",
        "!$TURBO_ROOT$/.cursor/**",
        "!$TURBO_ROOT$/.agents/**",
        "!$TURBO_ROOT$/.vercel/**",
        "!$TURBO_ROOT$/.opencode/**",
        "!$TURBO_ROOT$/.go/**",
        "!$TURBO_ROOT$/vendor/**",
        "!$TURBO_ROOT$/tmp/**",
        "!$TURBO_ROOT$/.tmp/**",
        "!$TURBO_ROOT$/dist/**",
        "!$TURBO_ROOT$/tools/bench/**",
        "!$TURBO_ROOT$/tools/oidc-mock/**",
        "!$TURBO_ROOT$/**/*_test.go",
        "!$TURBO_ROOT$/**/testdata/**",
        "$TURBO_ROOT$/go.mod",
        "$TURBO_ROOT$/go.sum",
        "$TURBO_ROOT$/api/**/*.yaml",
        "$TURBO_ROOT$/api/**/*.json",
        "$TURBO_ROOT$/packages/config/defaults/**",
        "$TURBO_ROOT$/internal/errorpage/*",
        "$TURBO_ROOT$/packages/design-tokens/src/generated/tokens.css",
        "$TURBO_ROOT$/internal/**/*.json",
        "$TURBO_ROOT$/docs/design/api/events-catalog.md",
        "$TURBO_ROOT$/api/.ogen.yaml",
        "$TURBO_ROOT$/scripts/check-go-generate.mjs",
        "$TURBO_ROOT$/scripts/generate-meta-schemas.ts"
      ]
    },
    "go-tests": {
      "inputs": [
        "$TURBO_ROOT$/**/*_test.go",
        "$TURBO_ROOT$/**/testdata/**",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/.claude/**",
        "!$TURBO_ROOT$/.codex/**",
        "!$TURBO_ROOT$/.cursor/**",
        "!$TURBO_ROOT$/.agents/**",
        "!$TURBO_ROOT$/.vercel/**",
        "!$TURBO_ROOT$/.opencode/**",
        "!$TURBO_ROOT$/.go/**",
        "!$TURBO_ROOT$/vendor/**",
        "!$TURBO_ROOT$/tmp/**",
        "!$TURBO_ROOT$/.tmp/**",
        "!$TURBO_ROOT$/dist/**",
        "!$TURBO_ROOT$/tools/bench/**",
        "!$TURBO_ROOT$/tools/oidc-mock/**",
        "$TURBO_ROOT$/docs/product-analytics-events.yaml",
        "$TURBO_ROOT$/vercel.json",
        "$TURBO_ROOT$/apps/cloud/build-launcher.sh"
      ]
    },
    "openapi": {
      "dependsOn": ["go-sources"],
      "env": ["GOFLAGS", "CGO_ENABLED", "GOOS", "GOARCH"],
      "inputs": ["$TURBO_ROOT$/scripts/lint-openapi.mjs", "$TURBO_ROOT$/redocly.yaml", "$TURBO_ROOT$/.redocly.lint-ignore.yaml"]
    },
    "format": {
      "cache": false,
      "dependsOn": ["go-sources", "go-tests"],
      "env": ["GOFLAGS", "CGO_ENABLED", "GOOS", "GOARCH"],
      "inputs": ["$TURBO_ROOT$/scripts/go-format-check.mjs", "$TURBO_ROOT$/scripts/dev-process.mjs"]
    },
    // Not `go generate ./...`: scripts/go-generate.mjs runs packages in
    // parallel behind the one ordering constraint that matters. The script
    // holds the `generated-sources` lock: generation rewrites files other
    // packages read mid-graph (config's meta-schemas, api's error responses).
    // Outputs are mirrored by GENERATED_GLOBS in scripts/generated-outputs.mjs.
    "generate": {
      "cache": false,
      "dependsOn": ["go-sources"],
      "env": ["GOFLAGS", "CGO_ENABLED", "GOOS", "GOARCH"],
      "inputs": [
        "$TURBO_ROOT$/scripts/go-generate.mjs",
        "$TURBO_ROOT$/scripts/task-guard.mjs",
        "$TURBO_ROOT$/scripts/dev-process.mjs"
      ],
      "outputs": [
        "$TURBO_ROOT$/api/generated/**",
        "$TURBO_ROOT$/api/openapi/components/schemas/errors/**",
        "$TURBO_ROOT$/api/openapi/endpoints/**/*-error-response.yaml",
        "$TURBO_ROOT$/api/openapi/endpoints/events/event.yaml",
        "$TURBO_ROOT$/api/openapi/endpoints/events/types/*.yaml",
        "$TURBO_ROOT$/api/openapi/endpoints/events/webhooks/*.yaml",
        "$TURBO_ROOT$/api/openapi/endpoints/schemas/*.json",
        "$TURBO_ROOT$/internal/**/*_enumer.go",
        "$TURBO_ROOT$/internal/**/*.mock.go"
      ]
    },
    // Generators only write; removing everything and regenerating is how
    // orphaned output gets pruned. Never cached: the point is to touch the
    // filesystem.
    "clean-generated": {
      "cache": false,
      "inputs": [
        "$TURBO_ROOT$/scripts/clean-generated.mjs",
        "$TURBO_ROOT$/scripts/generated-outputs.mjs",
        "$TURBO_ROOT$/scripts/dev-process.mjs",
        "$TURBO_ROOT$/scripts/task-guard.mjs"
      ]
    },
    "check-generate": {
      "cache": false,
      "dependsOn": ["go-sources"],
      "env": ["GOFLAGS", "CGO_ENABLED", "GOOS", "GOARCH"],
      "inputs": [
        "$TURBO_ROOT$/scripts/go-generate.mjs",
        "$TURBO_ROOT$/scripts/task-guard.mjs",
        "$TURBO_ROOT$/scripts/dev-process.mjs",
        "$TURBO_ROOT$/scripts/clean-generated.mjs",
        "$TURBO_ROOT$/scripts/generated-outputs.mjs"
      ]
    },
    // check-generate plus a prune. Deliberately not a dependency of vet/test:
    // it deletes every generated file before regenerating, which is fine on a
    // CI runner and rude on a machine someone is working in. CI runs it in
    // place of the plain check.
    "check-generate-pruned": {
      "cache": false,
      "dependsOn": ["go-sources"],
      "env": ["GOFLAGS", "CGO_ENABLED", "GOOS", "GOARCH"],
      "inputs": [
        "$TURBO_ROOT$/scripts/go-generate.mjs",
        "$TURBO_ROOT$/scripts/task-guard.mjs",
        "$TURBO_ROOT$/scripts/dev-process.mjs",
        "$TURBO_ROOT$/scripts/clean-generated.mjs",
        "$TURBO_ROOT$/scripts/generated-outputs.mjs"
      ]
    },
    // go vet compiles //go:embed all:dist, so the console build goes first (a
    // concurrent build can emptyOutDir the placeholder).
    "vet": {
      "cache": false,
      "dependsOn": ["go-sources", "go-tests", "check-generate", "@zitadel/console#build"],
      "env": ["GOFLAGS", "CGO_ENABLED", "GOOS", "GOARCH"]
    },
    // The custom go/analysis checks and the Biome lint of the JavaScript
    // launcher in bin/: scripts/go-lint.mjs, a copy of moon's inline script.
    "lint": {
      "cache": false,
      "dependsOn": ["go-sources", "go-tests", "check-generate", "@zitadel/console#build"],
      "env": ["GOFLAGS", "CGO_ENABLED", "GOOS", "GOARCH"],
      "inputs": ["$TURBO_ROOT$/scripts/go-lint.mjs", "$TURBO_ROOT$/biome.json", "$TURBO_ROOT$/biome-plugins/*.grit"]
    },
    // The test binary embeds the console's dist. Listed directly and not only
    // through vet: turbo hashes every dependency's result, but the direct edge
    // keeps the intent visible, as in moon.yml.
    "test": {
      "cache": false,
      "dependsOn": ["go-sources", "go-tests", "openapi", "format", "vet", "lint", "@zitadel/console#build"],
      "env": ["GOFLAGS", "CGO_ENABLED", "GOOS", "GOARCH"]
    },
    // The database lanes talk to a database whose state no hash sees, so
    // neither turbo's cache nor Go's (-count=1 in the scripts) may replay
    // them. They see the Docker and test-database variables. Their inputs
    // still matter: they decide when a change marks the lane affected, which
    // selects it in CI (`--affected`), as the server inputs do in moon. They
    // wait for check-generate, which rewrites api/generated, a package they
    // compile and type-load (api/internal/erroranalysis).
    "test-postgres": {
      "cache": false,
      "dependsOn": ["go-sources", "go-tests", "check-generate", "@zitadel/console#build"],
      "env": ["GOFLAGS", "CGO_ENABLED", "GOOS", "GOARCH"],
      "passThroughEnv": ["ZITADEL_TEST_*", "DOCKER_*", "TESTCONTAINERS_*"]
    },
    "test-spanner": {
      "cache": false,
      "dependsOn": ["go-sources", "go-tests", "check-generate", "@zitadel/console#build"],
      "env": ["GOFLAGS", "CGO_ENABLED", "GOOS", "GOARCH", "ZITADEL_TEST_SPANNER_INSTANCE"],
      "passThroughEnv": ["ZITADEL_TEST_*", "DOCKER_*", "TESTCONTAINERS_*", "GOOGLE_*", "CLOUDSDK_*", "SPANNER_EMULATOR_HOST"]
    },
    "test-sqlite": {
      "cache": false,
      "dependsOn": ["go-sources", "go-tests", "check-generate", "@zitadel/console#build"],
      "env": ["GOFLAGS", "CGO_ENABLED", "GOOS", "GOARCH"],
      "passThroughEnv": ["ZITADEL_TEST_*"]
    },
    // The binary embeds the console's dist, which the console#build edge
    // hashes. Its files are not inputs: turbo hashes a run's inputs before
    // the run starts, so the build would hash them without that run's console
    // build and miss the cache on the next run.
    "build": {
      "cache": false,
      "dependsOn": ["go-sources", "check-generate", "@zitadel/console#build"],
      "env": ["GOFLAGS", "CGO_ENABLED", "GOOS", "GOARCH"],
      "inputs": ["$TURBO_ROOT$/scripts/server-build.mjs", "$TURBO_ROOT$/scripts/dev-process.mjs"],
      "outputs": ["$TURBO_ROOT$/dist/server/nextgen", "$TURBO_ROOT$/dist/server/metadata.json"]
    }
  }
}
