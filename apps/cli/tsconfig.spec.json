{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/vitest",
    "types": ["vitest/globals", "vitest/importMeta", "node", "vitest"],
    "lib": ["es2022", "dom"],
    "jsx": "react-jsx",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false
  },
  "include": [
    "vitest.config.ts",
    "tsdown.config.ts",
    "src/**/*.spec.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ]
}
