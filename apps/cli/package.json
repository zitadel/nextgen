{
  "name": "@zitadel/cli",
  "version": "0.2.0",
  "description": "Agent-friendly Zitadel CLI",
  "homepage": "https://github.com/zitadel/nextgen/tree/main/apps/cli#readme",
  "bugs": {
    "url": "https://github.com/zitadel/nextgen/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zitadel/nextgen.git",
    "directory": "apps/cli"
  },
  "bin": {
    "zitadel": "./bin/run.js"
  },
  "files": [
    "bin",
    "dist",
    "oclif.manifest.json",
    "skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "oclif": {
    "bin": "zitadel",
    "dirname": "zitadel",
    "description": "Manage your Zitadel project and local identity server from the command line.",
    "commands": {
      "strategy": "explicit",
      "target": "./dist/index.mjs",
      "identifier": "COMMANDS"
    },
    "helpClass": "./dist/lib/oclif/help",
    "topicSeparator": " ",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-not-found",
      "@oclif/plugin-which",
      "@oclif/plugin-commands",
      "@oclif/plugin-autocomplete",
      "@oclif/plugin-search",
      "@oclif/plugin-version"
    ],
    "topics": {
      "users": {
        "description": "Create and manage users."
      },
      "teams": {
        "description": "Create and manage teams."
      },
      "sessions": {
        "description": "View and revoke sessions."
      },
      "events": {
        "description": "View events."
      },
      "grants": {
        "description": "Manage access grants."
      },
      "projects": {
        "description": "View and update projects."
      },
      "schemas": {
        "description": "View user schemas."
      },
      "branding": {
        "description": "Manage the login branding."
      },
      "auth-method": {
        "description": "Configure how users sign in."
      },
      "auth-method:password": {
        "description": "Turn password sign-in on or off."
      },
      "auth-method:passkey": {
        "description": "Turn passkey sign-in on or off."
      },
      "auth-method:sso": {
        "description": "Add or remove identity providers."
      },
      "origin": {
        "description": "Manage the project's allowed origins."
      },
      "release": {
        "description": "Build and manage releases."
      },
      "deployment": {
        "description": "Deploy releases and roll them back."
      },
      "preview": {
        "description": "Deploy and manage pull-request preview URLs."
      },
      "variable": {
        "description": "Manage project variables."
      },
      "idps": {
        "description": "Manage identity provider connections."
      },
      "flow-definitions": {
        "description": "View login flows."
      },
      "policies": {
        "description": "View and test policies."
      },
      "env": {
        "description": "Show and bind environments."
      },
      "api": {
        "description": "Call any operation of the Zitadel API."
      }
    }
  },
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
    "pretest": "pnpm run build",
    "test": "vitest run",
    "test:all": "pnpm run test",
    "check-advisories": "vitest run --config vitest.advisories.config.ts",
    "readme": "oclif readme",
    "prepack": "tsdown && oclif manifest && publint --strict",
    "postpack": "rm -f oclif.manifest.json",
    "lint": "biome check .",
    "build-release": "node ../../scripts/release-clean.mjs local-dist && pnpm run build"
  },
  "dependencies": {
    "@clack/prompts": "catalog:",
    "@oclif/core": "catalog:",
    "@oclif/plugin-autocomplete": "catalog:",
    "@oclif/plugin-commands": "catalog:",
    "@oclif/plugin-help": "catalog:",
    "@oclif/plugin-not-found": "catalog:",
    "@oclif/plugin-search": "catalog:",
    "@oclif/plugin-version": "catalog:",
    "@oclif/plugin-which": "catalog:",
    "@zitadel/api": "workspace:*",
    "@zitadel/config": "workspace:*",
    "@zitadel/server": "workspace:*",
    "ajv": "catalog:",
    "consola": "^3.4.2",
    "magicast": "^0.5.3",
    "mixpanel": "^0.18.1",
    "picocolors": "^1.1.1",
    "rosie-skills": "catalog:",
    "safe-stable-stringify": "catalog:",
    "semver": "catalog:",
    "undici": "^7.29.1",
    "wrap-ansi": "^7.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "@types/wrap-ansi": "^3.0.0",
    "@vitest/coverage-v8": "catalog:",
    "@zitadel/api-mock": "workspace:*",
    "@zitadel/sdk-next": "workspace:*",
    "@zitadel/vitest-config": "workspace:*",
    "msw": "catalog:",
    "oclif": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  }
}
