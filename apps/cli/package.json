{
  "name": "zitadel",
  "version": "0.0.0",
  "description": "Agent-friendly Zitadel CLI",
  "type": "module",
  "bin": {
    "zitadel": "dist/zitadel.js"
  },
  "files": [
    "dist",
    "CLAUDE.md"
  ],
  "scripts": {
    "build": "tsup && tsx scripts/gen-claude-md.ts",
    "gen:claude-md": "tsx scripts/gen-claude-md.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "^0.8.2",
    "ajv": "^8.17.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@zitadel/sdk-next": "workspace:*",
    "tsx": "^4.19.2"
  }
}
