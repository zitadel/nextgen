{
  "name": "@zitadel-nextgen/cli",
  "version": "0.0.0",
  "description": "Agent-friendly Zitadel CLI",
  "homepage": "https://github.com/zitadel/nextgen/tree/main/apps/cli#readme",
  "bugs": {
    "url": "https://github.com/zitadel/nextgen/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zitadel/nextgen.git",
    "directory": "apps/cli"
  },
  "bin": {
    "zitadel": "./bin/run.js"
  },
  "files": [
    "bin",
    "dist",
    "SKILLS.md"
  ],
  "oclif": {
    "bin": "zitadel",
    "dirname": "zitadel",
    "commands": "./dist/commands",
    "topicSeparator": " ",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-not-found",
      "@oclif/plugin-plugins",
      "@oclif/plugin-update",
      "@oclif/plugin-warn-if-update-available",
      "@oclif/plugin-which",
      "@oclif/plugin-commands",
      "@oclif/plugin-autocomplete",
      "@oclif/plugin-search",
      "@oclif/plugin-version"
    ]
  },
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "readme": "oclif readme"
  },
  "dependencies": {
    "@clack/prompts": "catalog:",
    "@oclif/core": "catalog:",
    "@oclif/plugin-autocomplete": "catalog:",
    "@oclif/plugin-commands": "catalog:",
    "@oclif/plugin-help": "catalog:",
    "@oclif/plugin-not-found": "catalog:",
    "@oclif/plugin-plugins": "catalog:",
    "@oclif/plugin-search": "catalog:",
    "@oclif/plugin-update": "catalog:",
    "@oclif/plugin-version": "catalog:",
    "@oclif/plugin-warn-if-update-available": "catalog:",
    "@oclif/plugin-which": "catalog:",
    "@zitadel-nextgen/api": "workspace:*",
    "ajv": "catalog:",
    "consola": "^3.4.2",
    "safe-stable-stringify": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@zitadel-nextgen/api-mock": "workspace:*",
    "@zitadel-nextgen/sdk-next": "workspace:*",
    "msw": "catalog:",
    "oclif": "catalog:",
    "tsdown": "^0.21.10",
    "vitest": "^3.0.0"
  },
  "nx": {
    "targets": {
      "build": {
        "options": {
          "cache": true
        },
        "inputs": [
          "production",
          "^production",
          {
            "externalDependencies": [
              "tsdown"
            ]
          }
        ],
        "outputs": [
          "{projectRoot}/dist/**/*.mjs",
          "{projectRoot}/dist/**/*.mjs.map"
        ],
        "dependsOn": [
          "^build",
          "^typecheck"
        ]
      },
      "readme": {
        "dependsOn": [
          "build"
        ],
        "inputs": [
          "{projectRoot}/dist/**/*.mjs",
          "{projectRoot}/README.md"
        ],
        "outputs": [
          "{projectRoot}/README.md"
        ]
      }
    }
  }
}
