{# zitadel-cli: managed-file v1 #}
<section class="zitadel-flow zitadel-flow--{{ step.type }}">
  <header class="zitadel-flow__header">
    {% if step.texts.title_key %}
      <h1>{{ step.texts.title_key | t }}</h1>
    {% endif %}
    {% if step.texts.description_key %}
      <p>{{ step.texts.description_key | t }}</p>
    {% endif %}
    {% if step.error %}
      <p class="zitadel-flow__error" role="alert">{{ step.error }}</p>
    {% endif %}
  </header>

  <form class="zitadel-flow__form" method="post">
    {% for entry in fields %}
      <zl-field
        name="{{ entry[0] }}"
        type="{{ entry[1].type }}"
        label="{{ entry[1].text_key | t }}"
        {% if entry[1].required %}required{% endif %}
        {% if entry[1].value %}value="{{ entry[1].value }}"{% endif %}
      ></zl-field>
    {% endfor %}

    {% for entry in gates %}
      {% if entry[1].type == "captcha" %}
        <zl-captcha
          name="{{ entry[0] }}"
          provider="{{ entry[1].provider }}"
          config="{{ entry[1].config | json }}"
        ></zl-captcha>
      {% endif %}
      {% if entry[1].type == "passkey" %}
        <zl-passkey name="{{ entry[0] }}"></zl-passkey>
      {% endif %}
    {% endfor %}

    {% if sso_providers.size > 0 %}
      <zl-sso providers="{{ sso_providers | json }}"></zl-sso>
    {% endif %}

    <div class="zitadel-flow__actions">
      {% for entry in actions %}
        <zl-button
          action="{{ entry[0] }}"
          label="{{ entry[1].text_key | t }}"
          hierarchy="{% if entry[1].primary %}primary{% else %}secondary{% endif %}"
          {% if entry[1].primary %}type="submit"{% endif %}
        ></zl-button>
      {% endfor %}
    </div>
  </form>
</section>
