{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // The real-instance config and src-real specs import @zitadel/testing/playwright.
    "typecheck": {
      "dependsOn": ["@zitadel/testing#build"]
    },
    // Runs api-mock's `start` and demo-next's `dev`, so it needs what those
    // need rather than a production build of the demo.
    "e2e": {
      "dependsOn": ["@zitadel/api-mock#build", "@zitadel/sdk-next#build"]
    },
    // The same journey against a real ephemeral instance seeded via
    // @zitadel/testing. The script keeps the server-hosted UIs and the
    // platform project off (see the moon.yml comments for why).
    "e2e-real": {
      "dependsOn": ["@zitadel/testing#build", "@zitadel/cli#build", "@zitadel/server#build"]
    }
  }
}
