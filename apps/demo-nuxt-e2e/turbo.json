{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // The typecheck needs no workspace build: the specs only import
    // @playwright/test. The suite runs api-mock's `start` and demo-nuxt's
    // `dev`, so it needs what those need rather than a production build.
    "e2e": {
      "dependsOn": ["@zitadel/api-mock#build", "@zitadel/sdk-nuxt#build"]
    }
  }
}
