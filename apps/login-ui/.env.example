# Development-only prefix for API requests. The dev server proxies this path to VITE_BACKEND_URL.
# Production hosted-login builds ignore this value and use same-origin requests.
VITE_PROXY_PATH=/__nextgen

# Development-only Go backend URL the dev server proxies to. Defaults to http://localhost:8080.
# VITE_BACKEND_URL=http://localhost:8080

# Development-only project ID for the login flow. Takes lower precedence than the ?project_id= URL param.
# VITE_PROJECT_ID=<your-project-id>
