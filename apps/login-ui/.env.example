# Prefix for API requests. The dev server proxies /__nextgen/* to VITE_BACKEND_URL.
# Leave unset in production builds — the embedded app uses same-origin requests.
VITE_PROXY_PATH=/__nextgen

# Go backend URL the dev server proxies to. Defaults to http://localhost:8080.
# VITE_BACKEND_URL=http://localhost:8080

# Project ID for the login flow. Takes lower precedence than the ?project_id= URL param.
# VITE_PROJECT_ID=<your-project-id>
