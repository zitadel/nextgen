{
  "$schema": "./catalog.schema.json",
  "id": "zitadel-pricing",
  "version": "2026-10-31.1",
  "status": "proposal",
  "currency": "usd",
  "decided": ["plans.pro.minimum", "meters.sso_users.allowance"],
  "conventions": {
    "period": "calendar month, UTC",
    "user_meters": "A user meter counts each subject once per project and month, at the first time the feature touches it.",
    "allowance": "The same allowance applies on every plan, per account and month; Enterprise contracts may raise it.",
    "invoice": "max(plan minimum, metered usage) + licensed lines on top; the minimum is credit that only metered prices draw on.",
    "caps": "Owners set a cap per meter; alerts at 50, 80 and 100 percent. A cap on a security meter alerts and never switches enforcement off.",
    "self_hosted": "Self-hosted installs pay for rights and support per production installation and are never metered."
  },
  "plans": {
    "free": {
      "label": "Free",
      "minimum": null,
      "card_required": false,
      "limits": {
        "requests_per_second_per_project": 50,
        "requests_per_month_per_account": 25000000,
        "core_mau_sized_for": 200000,
        "past_monthly_ceiling": "30 days' notice, then 10 requests per second"
      },
      "over_allowance": "Security and sign-ins never stop: 30 days to move to Pro. Delivery and M2M tokens stop at the allowance; advanced bot checks fall back to the basic challenge.",
      "event_retention_days": 7,
      "attribution_mark": "shown",
      "custom_domains_included": 0,
      "delivery_modes": ["dev_inbox", "own_provider"],
      "support": "community",
      "sla": null,
      "regions": ["eu"]
    },
    "pro": {
      "label": "Pro",
      "minimum": { "amount": 100, "interval": "month", "is_credit": true, "credit_applies_to": "metered" },
      "annual": { "amount": 1000, "interval": "year", "note": "two months free; how its credit is granted is open" },
      "card_required": true,
      "limits": {
        "core_mau_sized_for": 1000000,
        "per_band": "1M more MAU of throughput per band bought"
      },
      "event_retention_days": 30,
      "attribution_mark": "hideable",
      "custom_domains_included": 1,
      "delivery_modes": ["dev_inbox", "own_provider", "managed"],
      "support": "24/7 tickets, next business day; priority add-on 1 h for outages",
      "sla": { "target_percent": 99.9, "credits": false },
      "regions": ["eu"]
    },
    "enterprise": {
      "label": "Enterprise",
      "minimum": { "tiers_per_year": { "essential": 36000, "scale": 60000, "strategic": 100000, "unbounded": 200000 }, "is_credit": true, "credit_applies_to": "metered" },
      "rates": "list prices discounted per contract, as prepaid credit",
      "event_retention_days": 90,
      "attribution_mark": "hideable",
      "delivery_modes": ["dev_inbox", "own_provider", "managed"],
      "support": "by tier: 8 h to 30 min response SLOs, TAM",
      "sla": { "target_percent": 99.5, "credits": true, "note": "99.95 from Scale; 99.99 only after a second region" },
      "regions": "pinned region; dedicated deployment on top"
    }
  },
  "meters": [
    {
      "id": "monthly_active_users",
      "label": "Monthly active users",
      "kind": "users",
      "counts": "Every active user, at their first activity of the month",
      "dedupe": ["project", "user", "month"],
      "allowance": 1000000,
      "price": { "model": "bands", "above": 1000000, "size": 1000000, "amount": 2000, "until": 10000000, "opt_in": true },
      "security": false,
      "tag": "scale",
      "source": { "where": "session creation and token issuance", "exists": "no" },
      "stripe": { "event_name": "monthly_active_users", "aggregation": "sum", "price_lookup_key": "mau_bands" }
    },
    {
      "id": "sso_users",
      "label": "SSO and directory users",
      "kind": "users",
      "counts": "A user who signs in through an enterprise connection, or whom a directory syncs",
      "dedupe": ["project", "user", "month"],
      "allowance": 1000,
      "price": { "model": "per_unit", "unit_amount": 0.015 },
      "security": false,
      "tag": "metered feature",
      "source": { "where": "SSO callback (flow_sso_callback.go) and SCIM sync", "exists": "partial: OIDC connections exist; SAML, SCIM and the count don't" },
      "stripe": { "event_name": "sso_users", "aggregation": "sum", "price_lookup_key": "sso_users" }
    },
    {
      "id": "policy_users",
      "label": "Enforced-policy users",
      "kind": "users",
      "counts": "A user an enforced policy evaluates, once per policy: MFA required, lockout, session rules, expiry, per-tenant rules",
      "dedupe": ["project", "user", "policy", "month"],
      "allowance": 10000,
      "price": { "model": "per_unit", "unit_amount": 0.002 },
      "security": true,
      "tag": "metered feature",
      "source": { "where": "policy evaluation in the flow engine", "exists": "no: only the password rule exists, and it stays free" },
      "stripe": { "event_name": "policy_users", "aggregation": "sum", "price_lookup_key": "policy_users" }
    },
    {
      "id": "authz_users",
      "label": "Authorization users",
      "kind": "users",
      "counts": "A user an authorization check runs for",
      "dedupe": ["project", "user", "month"],
      "allowance": 10000,
      "price": { "model": "per_unit", "unit_amount": 0.005 },
      "pool": { "meter": "authz_checks", "per_user": 1000 },
      "security": false,
      "tag": "metered feature",
      "source": { "where": "end-user authorization API", "exists": "no" },
      "stripe": { "event_name": "authz_users", "aggregation": "sum", "price_lookup_key": "authz_users" }
    },
    {
      "id": "authz_checks",
      "label": "Authorization checks past the pool",
      "kind": "activity",
      "counts": "Each authorization check",
      "dedupe": null,
      "allowance": 0,
      "pool_of": "authz_users",
      "price": { "model": "per_unit", "unit_amount": 0.000002, "display": "$2 per million" },
      "security": false,
      "tag": "metered feature",
      "source": { "where": "end-user authorization API", "exists": "no" },
      "stripe": { "event_name": "authz_checks", "aggregation": "sum", "price_lookup_key": "authz_checks" }
    },
    {
      "id": "retained_users_90d",
      "label": "Retained users, 90 days",
      "kind": "users",
      "counts": "A user whose audit events are kept past the plan's own days, up to 90",
      "retention_days": 90,
      "dedupe": ["project", "user", "month"],
      "allowance": 0,
      "price": { "model": "per_unit", "unit_amount": 0.001 },
      "pool": { "meter": "retained_events_90d", "per_user": 200 },
      "security": false,
      "tag": "metered feature",
      "source": { "where": "the retention job (internal/audit/retention.go), daily", "exists": "no: one 30-day window for the whole server" },
      "stripe": { "event_name": "retained_users_90d", "aggregation": "sum", "price_lookup_key": "retained_users_90d" }
    },
    {
      "id": "retained_events_90d",
      "label": "Retained events past the pool, 90 days",
      "kind": "activity",
      "counts": "Each event kept past the plan's own days, up to 90",
      "dedupe": null,
      "allowance": 0,
      "pool_of": "retained_users_90d",
      "price": { "model": "per_unit", "unit_amount": 0.000003, "display": "$3 per million" },
      "security": false,
      "tag": "metered feature",
      "source": { "where": "the retention job", "exists": "no" },
      "stripe": { "event_name": "retained_events_90d", "aggregation": "sum", "price_lookup_key": "retained_events_90d" }
    },
    {
      "id": "retained_users_400d",
      "label": "Retained users, 400 days",
      "kind": "users",
      "counts": "A user whose audit events are kept past the plan's own days, up to 400",
      "retention_days": 400,
      "dedupe": ["project", "user", "month"],
      "allowance": 0,
      "price": { "model": "per_unit", "unit_amount": 0.003 },
      "pool": { "meter": "retained_events_400d", "per_user": 200 },
      "security": false,
      "tag": "metered feature",
      "source": { "where": "the retention job, daily", "exists": "no" },
      "stripe": { "event_name": "retained_users_400d", "aggregation": "sum", "price_lookup_key": "retained_users_400d" }
    },
    {
      "id": "retained_events_400d",
      "label": "Retained events past the pool, 400 days",
      "kind": "activity",
      "counts": "Each event kept past the plan's own days, up to 400",
      "dedupe": null,
      "allowance": 0,
      "pool_of": "retained_users_400d",
      "price": { "model": "per_unit", "unit_amount": 0.00001, "display": "$10 per million" },
      "security": false,
      "tag": "metered feature",
      "source": { "where": "the retention job", "exists": "no" },
      "stripe": { "event_name": "retained_events_400d", "aggregation": "sum", "price_lookup_key": "retained_events_400d" }
    },
    {
      "id": "email_users",
      "label": "Email users",
      "kind": "users",
      "counts": "A user managed delivery emails in the month: codes, links, verification, resets",
      "dedupe": ["project", "user", "month"],
      "allowance": 0,
      "price": { "model": "per_unit", "unit_amount": 0.001 },
      "pool": { "meter": "email_messages", "per_user": 5 },
      "plans": ["pro", "enterprise"],
      "security": false,
      "tag": "delivered cost",
      "source": { "where": "the managed email sender", "exists": "no: Zitadel sends no email" },
      "stripe": { "event_name": "email_users", "aggregation": "sum", "price_lookup_key": "email_users" }
    },
    {
      "id": "email_messages",
      "label": "Emails past the pool",
      "kind": "activity",
      "counts": "Each email managed delivery sends",
      "dedupe": null,
      "allowance": 0,
      "pool_of": "email_users",
      "price": { "model": "per_unit", "unit_amount": 0.0005, "display": "$0.50 per 1,000" },
      "plans": ["pro", "enterprise"],
      "security": false,
      "tag": "delivered cost",
      "source": { "where": "the managed email sender", "exists": "no" },
      "stripe": { "event_name": "email_messages", "aggregation": "sum", "price_lookup_key": "email_messages" }
    },
    {
      "id": "sms_users",
      "label": "SMS users",
      "kind": "users",
      "counts": "A user managed delivery texts in the month, only to countries the owner allows",
      "dedupe": ["project", "user", "band", "month"],
      "allowance": 0,
      "price": {
        "model": "per_band",
        "bands": [
          { "id": "us_ca", "countries": ["US", "CA"], "per_user": 0.03, "extra_message": 0.015 },
          { "id": "other", "countries": [], "per_user": null, "extra_message": null, "note": "to set: two texts at the band's cost" }
        ]
      },
      "pool": { "meter": "sms_messages", "per_user": 2 },
      "plans": ["pro", "enterprise"],
      "security": false,
      "tag": "delivered cost",
      "source": { "where": "the managed SMS sender, after a bot check on a new number", "exists": "no" },
      "stripe": { "event_name": "sms_users_<band>", "aggregation": "sum", "price_lookup_key": "sms_users_<band>" }
    },
    {
      "id": "m2m_tokens",
      "label": "M2M tokens",
      "kind": "activity",
      "counts": "Each token issued to a machine",
      "dedupe": null,
      "allowance": 1000000,
      "price": { "model": "per_unit", "unit_amount": 0.00001, "display": "$10 per million" },
      "security": false,
      "tag": "metered feature",
      "source": { "where": "the token endpoint (client credentials)", "exists": "no: no token endpoint yet" },
      "stripe": { "event_name": "m2m_tokens", "aggregation": "sum", "price_lookup_key": "m2m_tokens" }
    },
    {
      "id": "bot_checks",
      "label": "Advanced bot checks",
      "kind": "activity",
      "counts": "Each advanced check; basic challenges are free and unmetered",
      "dedupe": null,
      "allowance": 1000,
      "price": { "model": "per_unit", "unit_amount": 0.0015, "display": "$1.50 per 1,000" },
      "security": true,
      "tag": "delivered cost",
      "source": { "where": "the flow's bot gate, when it calls BotID", "exists": "no: Altcha gates designed, not wired" },
      "stripe": { "event_name": "bot_checks", "aggregation": "sum", "price_lookup_key": "bot_checks" }
    },
    {
      "id": "api_requests",
      "label": "API requests",
      "kind": "gauge",
      "counts": "Each request; shown and used for Free's limits, never billed",
      "dedupe": null,
      "allowance": null,
      "price": null,
      "security": false,
      "tag": null,
      "source": { "where": "request.api events (internal/audit/request_buffer.go)", "exists": "partial: events exist, no aggregate" },
      "stripe": null
    }
  ],
  "licensed": [
    { "id": "pro_monthly", "label": "Pro minimum", "amount": 100, "interval": "month", "plans": ["pro"], "grants_credit": 100, "tag": "minimum spend" },
    { "id": "pro_yearly", "label": "Pro minimum, annual", "amount": 1000, "interval": "year", "plans": ["pro"], "grants_credit": null, "tag": "minimum spend" },
    { "id": "custom_domain_extra", "label": "Hosted login domain beyond the included one", "amount": 50, "interval": "month", "per": "domain", "plans": ["pro"], "tag": "delivered cost" },
    { "id": "region", "label": "Region outside the EU, once built", "amount": 100, "interval": "month", "per": "region", "plans": ["pro"], "included_in": ["enterprise"], "tag": "compliance" },
    { "id": "support_priority", "label": "Priority support", "amount": 999, "interval": "month", "plans": ["pro"], "tag": "support" },
    { "id": "sla_9995", "label": "99.95% SLA", "amount": 1000, "interval": "month", "plans": ["pro", "enterprise"], "tag": "compliance" },
    { "id": "sla_9999", "label": "99.99% SLA, after a second region", "amount": 2000, "interval": "month", "plans": ["enterprise"], "tag": "compliance" },
    { "id": "addendum", "label": "Custom MSA, indemnification, DORA or BAA addendum", "amount": 2000, "interval": "month", "per": "addendum", "plans": ["pro", "enterprise"], "note": "or bundled in the Enterprise tier", "tag": "compliance" },
    { "id": "tam_hours", "label": "Extra TAM hours", "amount": 250, "interval": "hour", "plans": ["enterprise"], "tag": "support" },
    { "id": "private_slack", "label": "Private Slack", "amount": 800, "interval": "month", "plans": ["enterprise"], "tag": "support" },
    { "id": "dedicated_deployment", "label": "Dedicated deployment", "amount": null, "interval": "month", "plans": ["enterprise"], "note": "cost plus margin", "tag": "compliance" }
  ],
  "self_hosted": {
    "unit": "production installation: a server and its database serving real end users",
    "metered": false,
    "free": { "license": "AGPL-3.0-only", "features": "all", "support": "community" },
    "pro": {
      "prices": [
        { "installations_up_to": 1, "amount": 2000, "interval": "year" },
        { "installations_up_to": 25, "amount": 15000, "interval": "year" },
        { "installations_up_to": 100, "amount": 36000, "interval": "year" }
      ],
      "includes": ["commercial license (release from AGPL)", "tickets, next business day as a target"],
      "ticket_cap_per_year": 12,
      "purchase": "card, through a cloud account"
    },
    "enterprise": {
      "tiers": "as plans.enterprise",
      "includes": ["contractual response SLOs", "TAM", "patch backports", "compliance evidence", "custom terms", "indemnification"]
    }
  },
  "future": [
    {
      "id": "observed_users",
      "label": "Identity analytics hub",
      "free_part": "Sign-in, MAU and error counts in the console, over the plan's event retention",
      "paid_part": "Funnels, conversion, sign-in method mix, per-tenant views, anomaly alerts and exports over 90 days",
      "price": { "model": "per_unit", "unit_amount": 0.001, "note": "90-day retention included" },
      "needs": ["request events in an analytics store rather than Postgres"]
    },
    {
      "id": "protected_users",
      "label": "Threat intelligence",
      "free_part": "Brute-force guards, basic bot challenges and a breached-password check when a password is set",
      "paid_part": "Risk scoring of every sign-in with risk-based step-up or blocking",
      "price": { "model": "per_unit", "unit_amount": 0.005, "note": "enforcement included" },
      "needs": ["risk signals in the login flow", "an IP-reputation feed"]
    },
    {
      "id": "bot_checks_advanced",
      "label": "Bot and fraud defence: fingerprinting and SMS-fraud scoring",
      "free_part": "Basic challenges, unlimited; 1,000 advanced checks a month",
      "paid_part": "Device fingerprinting and SMS-fraud scoring on top of today's advanced checks",
      "price": { "model": "per_unit", "unit_amount": 0.0015, "note": "per check, the bot_checks rate" },
      "needs": ["a fingerprinting vendor beside BotID"]
    }
  ]
}
