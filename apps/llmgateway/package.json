{
	"name": "@zitadel-nextgen/llmgateway",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "echo 'Production build is handled by Vercel; run vercel deploy instead.'",
		"dev": "vercel dev",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --exclude tests/e2e/**",
		"test:watch": "vitest --exclude tests/e2e/**",
		"test:e2e": "vitest run tests/e2e",
		"lint": "oxlint",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"deploy": "vercel deploy --prod",
		"deploy:preview": "vercel deploy"
	},
	"devDependencies": {
		"@anthropic-ai/sdk": "^0.93.0",
		"@types/node": "^25.6.0",
		"oxfmt": "^0.46.0",
		"oxlint": "^1.61.0",
		"typescript": "^6.0.3",
		"vercel": "^48.0.0",
		"vitest": "^4.1.5"
	},
	"nx": {
		"projectType": "application"
	}
}
