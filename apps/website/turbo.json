{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  // The hosted cloud's front page at / (Next.js). Mirrors
  // apps/website/moon.yml; `test` is the root's.
  "tasks": {
    // Typecheck waits for the build, as in moon.yml: `next typegen` and
    // `next build` both write .next/types, where tsc reads the route types,
    // and `next build` empties it and fills it again. A task-guard mutex
    // would leave a gap: a cache hit restores .next without running the
    // script.
    "typecheck": {
      "dependsOn": ["build"]
    },
    // The showcase's login previews (app/showcase/login-preview.tsx) import
    // the atoms of @zitadel/components, which Next resolves to the package's
    // dist/. The changelog finds the release that ships each entry in the
    // published packages' release notes, which Changesets writes on every
    // release (app/changelog/entries.ts).
    //
    // The hosted cloud's website service builds through this task, keyed by
    // the deployment's ID as the docs' build is (apps/docs/turbo.json): on
    // Vercel it never hits. The Speed Insights sample rate and the commit the
    // analytics events report are read at build time (next.config.ts,
    // app/layout.tsx), and strict mode would hide them.
    "build": {
      "env": ["VERCEL_DEPLOYMENT_ID", "VERCEL_GIT_COMMIT_SHA", "WEBSITE_SPEED_INSIGHTS_SAMPLE_RATE"],
      "dependsOn": ["@zitadel/components#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.changeset/config.json",
        "$TURBO_ROOT$/apps/*/CHANGELOG.md",
        "$TURBO_ROOT$/packages/*/CHANGELOG.md"
      ],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "start": {
      "dependsOn": ["build"]
    },
    "dev": {
      "dependsOn": ["@zitadel/components#build"]
    }
  }
}
